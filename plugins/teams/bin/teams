#!/usr/bin/env bash
# `5dive agent teams …` — put an agent in Microsoft Teams as its own contact
# (DIVE-7658). Published by the teams plugin; core finds it because plugin.json
# declares the `teams` verb, and core hands `5dive agent teams <sub>` here as
# `5dive teams agent <sub>` (same shape as buzz).
#
#   connect <agent> --app-id=<id> --tenant-id=<id> [--endpoint=<https url>]
#                   [--task=<DIVE-N>] [--name=<shown name>] [--role=<one line>]
#                   [--allowed-users=<entra object ids>]
#   connect <agent> --microsoft [--name=<shown name>] [--role=<one line>] [--json]
#   status <agent>
#   disconnect <agent>
#   admins [list]                       who is an admin on this box (DIVE-7976)
#   admins add|remove <entra object id | teams:<id> | telegram:<id>>
#   admins check on|off                 off = everyone allowed in is equal again
#   admins members-may <kind,…|none>    widen: kinds a member may do without an admin
#
# --microsoft (DIVE-7831) does every Microsoft step after ONE sign-in, with
# Microsoft's own `teams` CLI (pinned, installed once into $MSCLI_PREFIX):
#   not signed in → starts the sign-in and opens Microsoft's page in the box's own
#     browser (site login.microsoftonline.com); the app shows it to the owner
#     through a one-time viewer link. Exit 0 with state=sign_in under --json.
#   signed in → checks Teams allows custom apps, `teams app create` (bot, secret,
#     install link), the secret into the connector file, then the steps below,
#     and prints the agent's "Add to Teams" link (state=ready).
#
# What connect does, in order:
#   1. refuses on a fully offline server (Teams goes through Microsoft's cloud),
#      unless its IT opened Teams alone: sudo 5dive config local-only allow teams
#   2. takes the bot's client secret from /etc/5dive/connectors/teams-<agent>.env,
#      which only ever arrives through a one-time secret link (or `sudo 5dive
#      secret write` at a terminal) — never as an argument, never in chat
#   3. writes the agent's ~/.claude/channels/teams/config.json (0600, the agent's)
#   4. gives the endpoint a public name: on a 5dive box, teams-<agent>.<box
#      domain> straight to this box's Caddy; on a self-hosted box, the address
#      the office's IT forwards (printed)
#   5. builds the Teams app package (the agent's face, name and role)
#   6. turns the channel on: `5dive agent config <agent> set channels=…,teams`
set -euo pipefail

TEAMS_PLUGIN_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
FIVEDIVE_BIN="${TEAMS_5DIVE_BIN:-/usr/local/bin/5dive}"
CONNECTORS_DIR="${TEAMS_CONNECTORS_DIR:-/etc/5dive/connectors}"
PROVISIONING="${TEAMS_PROVISIONING:-/etc/5dive/provisioning.env}"
LOCAL_ONLY_FILE="${FIVE_LOCAL_ONLY_FILE:-/etc/5dive/local-only}"
PACKAGES_DIR="${TEAMS_PACKAGES_DIR:-/var/lib/5dive/teams}"
HOME_ROOT="${AGENT_HOME_ROOT:-/home}"
# DIVE-7831: Microsoft's teams CLI. Pinned: it is a young tool and its flags and
# output may change under us. Its login is the box's, kept in MSCLI_HOME (0700).
MSCLI_VERSION="3.0.4"
MSCLI_PREFIX="${TEAMS_MSCLI_PREFIX:-/opt/5dive/teams-cli}"
MSCLI_HOME="${TEAMS_MSCLI_HOME:-/var/lib/5dive/teams-cli}"
MSCLI_BIN="${TEAMS_MSCLI_BIN:-$MSCLI_PREFIX/bin/teams}"
MSCLI_DIST="${TEAMS_MSCLI_DIST:-$MSCLI_PREFIX/lib/node_modules/@microsoft/teams.cli/dist}"
SYSTEMD_RUN="${TEAMS_SYSTEMD_RUN:-systemd-run}"
SYSTEMCTL="${TEAMS_SYSTEMCTL:-systemctl}"
SIGNIN_SITE="login.microsoftonline.com"
SIGNIN_UNIT="5dive-teams-signin"
SIGNIN_TTL=900
SIGNIN_WAIT="${TEAMS_SIGNIN_WAIT:-30}"
ROLES_FILE="${FIVEDIVE_ROLES_FILE:-/etc/5dive/roles.json}"
RISK_KINDS="root pay delete send settings access"
PORT_BASE=39100
PORT_SPAN=800

readonly E_USAGE=2 E_VALIDATION=3 E_NOT_FOUND=4 E_AUTH_REQUIRED=6 E_PERMISSION=10

fail() { local c="$1"; shift; echo "error: $*" >&2; exit "$c"; }
step() { echo "==> $*" >&2; }
warn() { echo "warn: $*" >&2; }

teams_audit() {
  [[ $EUID -eq 0 ]] || return 0
  jq -cn --arg ts "$(date -Iseconds)" --arg u "${SUDO_USER:-${USER:-root}}" --arg c "agent teams" \
    --args '{ts:$ts, user:$u, cmd:$c, args:$ARGS.positional, via:"teams-plugin"}' -- "$@" 2>/dev/null \
    | "$FIVEDIVE_BIN" _audit_append >/dev/null 2>&1 || true
}

# The one line every outside service gives on an offline server. DIVE-7658:
# the firm's IT may open Teams alone (`sudo 5dive config local-only allow
# teams` writes `teams` into local-only.allow); everything else stays shut.
LOCAL_ONLY_ALLOW_FILE="${FIVE_LOCAL_ONLY_ALLOW_FILE:-$(dirname "$LOCAL_ONLY_FILE")/local-only.allow}"
teams_refuse_offline() {
  [[ -e "$LOCAL_ONLY_FILE" ]] || return 0
  grep -qxF teams "$LOCAL_ONLY_ALLOW_FILE" 2>/dev/null && return 0
  fail "$E_PERMISSION" "Teams goes through Microsoft's cloud, so it is shut on this offline server. Your IT can open it alone: sudo 5dive config local-only allow teams"
}

_guid_ok() { [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; }
_name_ok() { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$ ]]; }

# TEAMS_AGENT_USER: the harness's stand-in for agent-<name> (it cannot create
# users). Only root runs connect, and root's environment is already root's.
_agent_user() { printf '%s' "${TEAMS_AGENT_USER:-agent-$1}"; }
_state_dir()  { printf '%s/agent-%s/.claude/channels/teams' "$HOME_ROOT" "$1"; }
_connector()  { printf '%s/teams-%s.env' "$CONNECTORS_DIR" "$1"; }

_agent_json() {
  "$FIVEDIVE_BIN" agent info "$1" --json 2>/dev/null | jq -e '.data // .' 2>/dev/null
}

# The secret as stored by `secret write`: KEY=value, or KEY_FILE=<path> for a
# multi-line value. Printed to stdout for the caller to put in the 0600 config.
_read_secret() {
  local f; f=$(_connector "$1")
  [[ -r "$f" ]] || return 1
  local v; v=$(sed -n 's/^TEAMS_APP_PASSWORD=//p' "$f" | tail -1)
  if [[ -z "$v" ]]; then
    local p; p=$(sed -n 's/^TEAMS_APP_PASSWORD_FILE=//p' "$f" | tail -1)
    [[ -n "$p" && -r "$p" ]] && v=$(head -c 4096 "$p" | tr -d '\n')
  fi
  v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
  [[ -n "$v" ]] || return 1
  printf '%s' "$v"
}

_domain() {
  local d=""
  [[ -r "$PROVISIONING" ]] && d=$(sed -n 's/^FIVE_DOMAIN=//p' "$PROVISIONING" | tail -1)
  d="${d%\"}"; d="${d#\"}"
  [[ "$d" =~ ^[a-z0-9_]([a-z0-9_.-]*[a-z0-9])?$ && "$d" == *.* ]] || return 1
  printf '%s' "$d"
}

_port_free() { [[ -z "$(ss -Hltn "( sport = :$1 )" 2>/dev/null)" ]]; }
# Read the list whole, then match: under pipefail, `route ls | grep -q` reads
# as "not routed" when grep exits on the first hit and route ls takes SIGPIPE,
# so a re-run of connect tried to add a route it had already made.
_has_route() { local out; out=$("$FIVEDIVE_BIN" route ls 2>/dev/null) || true
  grep -qE "(^|[[:space:]])teams-$1([[:space:]]|$)" <<<"$out"; }

# A stable port per agent (from its uid), moved on only if something else holds it.
_pick_port() {
  local uid; uid=$(id -u "$(_agent_user "$1")")
  local i p
  for ((i = 0; i < PORT_SPAN; i++)); do
    p=$((PORT_BASE + (uid + i) % PORT_SPAN))
    _port_free "$p" && { echo "$p"; return 0; }
  done
  return 1
}

_cfg_get() { jq -r --arg k "$2" '.[$k] // empty' "$(_state_dir "$1")/config.json" 2>/dev/null || true; }

teams_connect() {
  local a
  for a in "$@"; do [[ "$a" == --microsoft ]] && { teams_connect_microsoft "$@"; return; }; done
  local agent="" app_id="" tenant_id="" endpoint="" task="" allowed="" name="" role=""
  for a in "$@"; do
    case "$a" in
      --json) FIVEDIVE_JSON_MODE=1 ;;
      --app-id=*) app_id="${a#*=}" ;;
      --tenant-id=*) tenant_id="${a#*=}" ;;
      --endpoint=*) endpoint="${a#*=}" ;;
      --task=*) task="${a#*=}" ;;
      --allowed-users=*) allowed="${a#*=}" ;;
      --name=*) name="${a#*=}" ;;
      --role=*) role="${a#*=}" ;;
      --secret=*|--app-password=*|--client-secret=*)
        fail "$E_VALIDATION" "the bot's secret is never an argument (it would sit in the shell history and the audit log). It arrives through a one-time link: rerun with --task=<DIVE-N>, or at a terminal: sudo 5dive secret write TEAMS_APP_PASSWORD --connector=teams-<agent>" ;;
      -*) fail "$E_USAGE" "unknown flag: $a" ;;
      *) [[ -z "$agent" ]] && agent="$a" || fail "$E_USAGE" "one agent at a time" ;;
    esac
  done
  [[ -n "$agent" ]] || fail "$E_USAGE" "usage: 5dive agent teams connect <agent> --app-id=<id> --tenant-id=<id> [--endpoint=<https url>] [--task=<DIVE-N>]"
  teams_refuse_offline
  [[ $EUID -eq 0 ]] || fail "$E_PERMISSION" "run it as root: sudo 5dive agent teams connect $agent …"
  _name_ok "$agent" || fail "$E_VALIDATION" "not an agent name: $agent"
  local info; info=$(_agent_json "$agent") || fail "$E_NOT_FOUND" "no agent named '$agent'"
  local type; type=$(jq -r '.type // empty' <<<"$info")
  [[ "$type" == claude ]] || fail "$E_VALIDATION" "Teams is for Claude Code agents for now ('$agent' is $type)"

  # Re-running connect keeps what it already knows.
  [[ -n "$app_id" ]] || app_id=$(_cfg_get "$agent" app_id)
  [[ -n "$tenant_id" ]] || tenant_id=$(_cfg_get "$agent" tenant_id)
  _guid_ok "$app_id" || fail "$E_VALIDATION" "--app-id must be the bot's Application (client) ID, a GUID like 00000000-0000-0000-0000-000000000000"
  _guid_ok "$tenant_id" || fail "$E_VALIDATION" "--tenant-id must be your Microsoft 365 Directory (tenant) ID, a GUID"
  if [[ -n "$endpoint" ]]; then
    [[ "$endpoint" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$ ]] || fail "$E_VALIDATION" "--endpoint must be an https:// address"
  fi

  local secret
  if ! secret=$(_read_secret "$agent"); then
    if [[ -n "$task" ]]; then
      step "Asking for the bot's client secret through a one-time link (task $task)"
      "$FIVEDIVE_BIN" task need "$task" --type=secret --secret-key=TEAMS_APP_PASSWORD --connector="teams-$agent" \
        --ask="Paste the client secret of the Teams bot for $agent (from Azure: the app registration, Certificates & secrets). It goes only to this server." \
        || fail "$E_AUTH_REQUIRED" "could not open the secret request on $task"
      echo "Waiting for the secret. When it is in, run the same connect again." >&2
      exit "$E_AUTH_REQUIRED"
    fi
    fail "$E_AUTH_REQUIRED" "the bot's client secret is not on this server yet. Rerun with --task=<DIVE-N> to send a one-time link, or at a terminal: sudo 5dive secret write TEAMS_APP_PASSWORD --connector=teams-$agent"
  fi

  local user; user=$(_agent_user "$agent")
  local dir; dir=$(_state_dir "$agent")
  local port; port=$(_cfg_get "$agent" port)
  [[ "$port" =~ ^[0-9]+$ ]] || port=$(_pick_port "$agent") || fail "$E_VALIDATION" "no free port in ${PORT_BASE}-$((PORT_BASE + PORT_SPAN - 1))"

  # The public name. Never a 5dive relay: Microsoft posts to this box.
  local public="" domain="" routed=0
  if [[ -n "$endpoint" ]]; then
    public="${endpoint%/}"
    [[ "$public" == */api/messages ]] || public="$public/api/messages"
  elif domain=$(_domain); then
    if ! _has_route "$agent"; then
      step "Publishing teams-$agent.$domain for this agent's Teams endpoint"
      "$FIVEDIVE_BIN" route add "teams-$agent" --port="$port" >&2 || fail "$E_VALIDATION" "could not publish teams-$agent.$domain"
    fi
    public="https://teams-$agent.$domain/api/messages"
    routed=1
  fi

  step "Writing the agent's Teams settings"
  install -d -o "$user" -g "$(id -gn "$user")" -m 700 "$dir"
  local tmp; tmp=$(mktemp)
  jq -n --arg app "$app_id" --arg ten "$tenant_id" --arg pw "$secret" --argjson port "$port" \
        --arg pub "$public" --arg allowed "$allowed" '
    {app_id:$app, tenant_id:$ten, app_password:$pw, port:$port}
    + (if $pub != "" then {public_url:$pub} else {} end)
    + (if $allowed != "" then {allowed_users: ($allowed | split(",") | map(select(length > 0)))} else {} end)' >"$tmp"
  install -o "$user" -g "$(id -gn "$user")" -m 600 "$tmp" "$dir/config.json"
  rm -f "$tmp"
  unset secret

  step "Building the Teams app package"
  local avatar pkg
  # The contact's name and role as people in Teams will see them.
  [[ -n "$name" ]] || name="${agent^}"
  avatar="$HOME_ROOT/agent-$agent/.claude/avatar.png"
  install -d -m 755 "$PACKAGES_DIR"
  pkg="$PACKAGES_DIR/$agent-teams-app.zip"
  python3 -I "$TEAMS_PLUGIN_ROOT/cli/package.py" --out="$pkg" --app-id="$app_id" --name="$name" \
    --role="${role:-AI teammate}" --avatar="$avatar" --endpoint="$public" >&2 \
    || fail "$E_VALIDATION" "could not build the Teams app package"
  chmod 644 "$pkg"

  local chans; chans=$(jq -r '.channels // "none"' <<<"$info")
  if [[ ",$chans," != *",teams,"* ]]; then
    step "Turning on the Teams channel for $agent (restarts it)"
    local next; [[ "$chans" == none || -z "$chans" ]] && next=teams || next="$chans,teams"
    "$FIVEDIVE_BIN" agent config "$agent" set channels="$next" >&2 \
      || fail "$E_VALIDATION" "could not add the teams channel (this server's 5dive may predate Teams: sudo 5dive self-update)"
  else
    "$FIVEDIVE_BIN" agent restart "$agent" >/dev/null 2>&1 || warn "restart $agent to load the new settings"
  fi
  teams_audit connect "$agent" "--app-id=$app_id" "--tenant-id=$tenant_id" "--port=$port"
  # --microsoft made the bot itself and prints its own next step (Add to Teams).
  [[ "${TEAMS_CONNECT_QUIET:-0}" == 1 ]] && return 0

  cat <<EOF

$name is ready for Microsoft Teams.

  App package:  $pkg
  Endpoint:     ${public:-"(not public yet) forward https://<your name>/api/messages to this server, port $port"}
$( (( routed )) || printf '  Forward to:   http://127.0.0.1:%s/api/messages on this server (your reverse proxy runs here)\n' "$port")

Next, your IT (one time, about 10 minutes):
  1. The bot's messaging endpoint = the Endpoint above (Teams Developer Portal >
     Bot management > the bot > Configure; or Azure Bot > Configuration).
  2. Teams admin center > Manage apps > Upload new app > the App package above.
  3. Make it available to the people who should talk to $name. People can
     also add $name to a group chat or a team channel and @mention it there.
  Already in Teams? Upload this package over the old app (Manage apps > the
  app > Upload file) so $name can join group chats and channels.
EOF
  if (( ! routed )) && [[ -z "$endpoint" ]]; then
    cat <<EOF
  4. Forward the public address to this server: https://<your name>/api/messages
     -> http://127.0.0.1:$port/api/messages (reverse proxy or DMZ), then rerun
     connect with --endpoint=https://<your name>.
EOF
  fi
  echo "  Guide: $TEAMS_PLUGIN_ROOT/docs/IT-GUIDE.md"
}

# ─── DIVE-7831: --microsoft, one sign-in, then 5dive makes each agent's bot ───

# Microsoft's CLI, as root, with its login kept in MSCLI_HOME. umask 077: `app
# create --env` writes the bot's secret under the caller's umask (0664 by default).
_mscli() {
  ( umask 077
    HOME="$MSCLI_HOME" XDG_CONFIG_HOME="$MSCLI_HOME/.config" TEAMS_NO_INTERACTIVE=1 \
      "$MSCLI_BIN" --disable-auto-update "$@" )
}

# DIVE-8022: why a call failed, in Microsoft's words. Asked for --json, the CLI
# reports its error on STDOUT ({ok:false, error:{message}}); stderr carries its
# own warnings, and one of them comes on EVERY call on a box with no desktop
# keyring ("Warning: libsecret not found …" / "Install it for secure storage:
# sudo apt install libsecret-1-dev"), so the last stderr line is that hint, never
# the reason. Only a crash outside its handler lands on stderr alone.
_ms_why() {  # <stdout> <stderr file>
  local w lines
  w=$(jq -r 'select(type == "object") | .error.message // empty' <<<"$1" 2>/dev/null | grep -v '^[[:space:]]*$' | head -1) || w=""
  if [[ -z "$w" ]]; then
    lines=$(sed 's/\x1b\[[0-9;]*m//g' "$2" 2>/dev/null | grep -v '^[[:space:]]*$' \
      | grep -viE '^[[:space:]]*(\(node:[0-9]+\) )?warning\b|libsecret|secure storage' || true)
    w=$(grep -iE 'error' <<<"$lines" | tail -1) || w=""
    [[ -n "$w" ]] || w=$(head -1 <<<"$lines")
  fi
  w=$(tr -d '[:cntrl:]' <<<"$w")
  printf '%s' "${w:0:300}"
}

# The whole answer of the last failed call, for whoever looks next (root, 0600,
# beside the CLI's login). The card shows one line; this keeps the rest.
_ms_keep_error() {  # <what> <rc> <stdout> <stderr file>
  ( umask 077
    { printf '%s  teams %s  exit %s\n--- stdout\n' "$(date -u +%FT%TZ)" "$1" "$2"
      jq 'del(.credentials?)' <<<"$3" 2>/dev/null || printf '%s\n' "$3"
      printf -- '--- stderr\n'; cat "$4" 2>/dev/null
    } >"$MSCLI_HOME/last-error.log" ) || true
}

_node_ok() {  # Node >= 22.12, which Microsoft's CLI needs
  local v; v=$(node -p 'process.versions.node' 2>/dev/null) || return 1
  local maj="${v%%.*}" rest="${v#*.}"; local min="${rest%%.*}"
  (( maj > 22 || (maj == 22 && min >= 12) ))
}

# Installed once, pinned. libsecret-1-0: without it the CLI keeps its login in
# memory only, so every later command is signed out again (measured, DIVE-7828).
# npm 11 skips keytar's install script unless it is allowed by name.
_mscli_ensure() {
  install -d -m 700 "$MSCLI_HOME"
  "$MSCLI_BIN" --version 2>/dev/null | grep -qF "$MSCLI_VERSION" && return 0
  _node_ok || fail "$E_VALIDATION" "Microsoft's Teams tool needs Node.js 22.12 or newer on this server: sudo 5dive browser setup installs it"
  step "Installing Microsoft's Teams tool $MSCLI_VERSION (once)"
  if ! ldconfig -p 2>/dev/null | grep -q 'libsecret-1\.so\.0'; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q libsecret-1-0 >&2 \
      || fail "$E_VALIDATION" "could not install libsecret-1-0 (Microsoft's tool needs it to keep its sign-in)"
  fi
  install -d -m 755 "$MSCLI_PREFIX"
  npm install -g --prefix "$MSCLI_PREFIX" --no-fund --no-audit --loglevel=error \
      --allow-scripts=@azure/msal-node-extensions,keytar "@microsoft/teams.cli@$MSCLI_VERSION" >&2 \
    || fail "$E_VALIDATION" "could not install Microsoft's Teams tool"
  "$MSCLI_BIN" --version 2>/dev/null | grep -qF "$MSCLI_VERSION" \
    || fail "$E_VALIDATION" "Microsoft's Teams tool did not install as version $MSCLI_VERSION"
}

_signin_url_file() { printf '%s/signin.url' "$MSCLI_HOME"; }
_signin_waiting() { "$SYSTEMCTL" is-active --quiet "$SIGNIN_UNIT" 2>/dev/null && [[ -s "$(_signin_url_file)" ]]; }

# Only Microsoft's own sign-in page, short enough for the browser's page check.
_signin_url_ok() {
  (( ${#1} <= 1000 )) && [[ "$1" =~ ^https://login\.microsoftonline\.com/[^[:space:][:cntrl:]]+$ ]]
}

# The page in the box's own browser. A person is about to use it, so plain
# Chrome (--login). No profile yet: `auth` makes one (it opens the front page),
# then the page we want. Mirrors the browser plugin's own Connect.
_signin_show() {  # <url> <fresh: 1 = a new sign-in, so whatever tab is open is stale>
  local url="$1" fresh="$2" e rc=0
  e=$(mktemp)
  (( fresh )) && { "$FIVEDIVE_BIN" browser serve "$SIGNIN_SITE" --stop >/dev/null 2>&1 || true; }
  "$FIVEDIVE_BIN" browser serve "$SIGNIN_SITE" --login --url="$url" >/dev/null 2>"$e" || rc=$?
  if (( rc != 0 )) && grep -q 'no profile for' "$e"; then
    rc=0; "$FIVEDIVE_BIN" browser auth "$SIGNIN_SITE" >/dev/null 2>"$e" || rc=$?
    if (( rc == 0 )); then
      "$FIVEDIVE_BIN" browser serve "$SIGNIN_SITE" --stop >/dev/null 2>&1 || true
      "$FIVEDIVE_BIN" browser serve "$SIGNIN_SITE" --login --url="$url" >/dev/null 2>"$e" || rc=$?
    fi
  fi
  local why; why=$(tail -1 "$e"); rm -f "$e"
  (( rc == 0 )) || fail "$E_VALIDATION" "this server's browser did not open Microsoft's sign-in: $why"
}

# Start the waiting sign-in (or reuse the one already waiting) and show its page.
_signin_start() {
  local uf url i fresh=0
  uf=$(_signin_url_file)
  if ! _signin_waiting; then
    fresh=1
    "$SYSTEMCTL" stop "$SIGNIN_UNIT" >/dev/null 2>&1 || true
    rm -f "$uf"
    local node; node=$(command -v node) || fail "$E_VALIDATION" "no Node.js on this server"
    "$SYSTEMD_RUN" --quiet --collect --unit="$SIGNIN_UNIT" -p RuntimeMaxSec="$SIGNIN_TTL" -p UMask=0077 \
        --setenv=HOME="$MSCLI_HOME" --setenv=XDG_CONFIG_HOME="$MSCLI_HOME/.config" --setenv=TEAMS_NO_INTERACTIVE=1 \
        "$node" "$TEAMS_PLUGIN_ROOT/cli/ms-signin.mjs" "$MSCLI_DIST" "$uf" >&2 \
      || fail "$E_VALIDATION" "could not start the Microsoft sign-in"
    for ((i = 0; i < SIGNIN_WAIT * 4; i++)); do [[ -s "$uf" ]] && break; sleep 0.25; done
  fi
  url=$(head -1 "$uf" 2>/dev/null || true)
  _signin_url_ok "$url" || { "$SYSTEMCTL" stop "$SIGNIN_UNIT" >/dev/null 2>&1 || true; rm -f "$uf"
    fail "$E_VALIDATION" "Microsoft's sign-in did not start (no sign-in page came back)"; }
  _signin_show "$url" "$fresh"
}

# Signed in: the page and the view are no longer needed. And the box's browser is
# signed OUT of Microsoft again: its profile now holds the owner's Microsoft session
# (an admin's, usually), and every agent on the box may use the box's browser logins.
# Microsoft's tool keeps its own sign-in (MSCLI_HOME), which is all this needs.
_signin_close() {
  [[ -e "$(_signin_url_file)" ]] || return 0
  "$FIVEDIVE_BIN" browser viewer-revoke "$SIGNIN_SITE" >/dev/null 2>&1 || true
  "$FIVEDIVE_BIN" browser serve "$SIGNIN_SITE" --stop >/dev/null 2>&1 || true
  "$FIVEDIVE_BIN" browser forget "$SIGNIN_SITE" >/dev/null 2>&1 \
    || warn "could not sign this server's browser out of Microsoft: sudo 5dive browser forget $SIGNIN_SITE"
  "$SYSTEMCTL" stop "$SIGNIN_UNIT" >/dev/null 2>&1 || true
  rm -f "$(_signin_url_file)"
}

_ms_say() {  # <state> <agent> [<key> <value>]... — one JSON line, or words
  local state="$1" agent="$2"; shift 2
  if [[ "${FIVEDIVE_JSON_MODE:-0}" == 1 ]]; then
    local -a kv=(--arg state "$state" --arg agent "$agent")
    local f='{state:$state, agent:$agent'
    while (($# >= 2)); do kv+=(--arg "$1" "$2"); f+=", $1:\$$1"; shift 2; done
    jq -cn "${kv[@]}" "{ok:true, data:$f}}"
    return 0
  fi
  local -A v=(); while (($# >= 2)); do v[$1]="$2"; shift 2; done
  case "$state" in
    sign_in) cat <<EOF
Sign in with Microsoft to finish. The sign-in page is open in this server's browser.
In the 5dive app: Connect Microsoft Teams shows it to you. At a terminal, open it with:
  sudo 5dive browser viewer $SIGNIN_SITE --bind=local
Then run the same command again.
EOF
      ;;
    blocked) printf '%s\n' "${v[message]}" ;;
    ready) printf '%s is ready for Microsoft Teams.\n\nAdd to Teams: %s\n' "${v[name]}" "${v[install_link]}" ;;
  esac
}

# DIVE-8023: a bot `teams app create` makes is 1:1 only. Widen it to group chats
# and team channels, and note that in the agent's config so a re-run knows.
# Best effort: the agent still works 1:1 if Microsoft refuses.
MS_SCOPES="personal,team,groupChat"
_ms_groups() {  # <agent> <teams app id>
  local agent="$1" tid="$2" out
  [[ -n "$tid" ]] || { warn "no Teams app id kept for $agent, so it stays 1:1 only. Disconnect and connect again to fix it."; return 1; }
  if out=$(_mscli app update "$tid" --scopes "$MS_SCOPES" --json 2>/dev/null) \
     && jq -e '.updated.scopes' <<<"$(sed -n '/^{/,$p' <<<"$out")" >/dev/null 2>&1; then
    _cfg_merge "$agent" "$(jq -cn --arg s "$MS_SCOPES" '{scopes:$s}')"
    return 0
  fi
  warn "Microsoft did not open group chats and channels for $agent; it still works 1:1. Run the same command again later."
  return 1
}

# Merge the Microsoft-made facts into the agent's 0600 config, keeping its owner.
_cfg_merge() {  # <agent> <jq object>
  local cfg; cfg="$(_state_dir "$1")/config.json"
  local tmp; tmp=$(mktemp)
  jq --argjson add "$2" '. + $add' "$cfg" >"$tmp" && cat "$tmp" >"$cfg"
  rm -f "$tmp"
}

teams_connect_microsoft() {
  local agent="" name="" role="" endpoint="" a
  for a in "$@"; do
    case "$a" in
      --microsoft) ;;
      --json) FIVEDIVE_JSON_MODE=1 ;;
      --name=*) name="${a#*=}" ;;
      --role=*) role="${a#*=}" ;;
      --endpoint=*) endpoint="${a#*=}" ;;
      --app-id=*|--tenant-id=*|--task=*)
        fail "$E_USAGE" "--microsoft makes the bot itself: drop ${a%%=*}" ;;
      --secret=*|--app-password=*|--client-secret=*)
        fail "$E_VALIDATION" "the bot's secret is never an argument; --microsoft makes it on this server" ;;
      -*) fail "$E_USAGE" "unknown flag: $a" ;;
      *) [[ -z "$agent" ]] && agent="$a" || fail "$E_USAGE" "one agent at a time" ;;
    esac
  done
  [[ -n "$agent" ]] || fail "$E_USAGE" "usage: 5dive agent teams connect <agent> --microsoft [--name=<shown name>] [--role=<one line>] [--json]"
  teams_refuse_offline
  [[ $EUID -eq 0 ]] || fail "$E_PERMISSION" "run it as root: sudo 5dive agent teams connect $agent --microsoft"
  _name_ok "$agent" || fail "$E_VALIDATION" "not an agent name: $agent"
  local info; info=$(_agent_json "$agent") || fail "$E_NOT_FOUND" "no agent named '$agent'"
  [[ "$(jq -r '.type // empty' <<<"$info")" == claude ]] || fail "$E_VALIDATION" "Teams is for Claude Code agents for now"
  [[ -n "$name" ]] || name="${agent^}"

  # Already in Teams this way: the same link again, nothing new made. A bot made
  # before DIVE-8023 is 1:1 only: widen it once (needs the sign-in), and the
  # owner opens the same link again to take the update.
  local link; link=$(_cfg_get "$agent" install_link)
  if [[ -n "$link" && -n "$(_cfg_get "$agent" app_id)" ]]; then
    if [[ "$(_cfg_get "$agent" scopes)" != "$MS_SCOPES" ]]; then
      _mscli_ensure
      local st0; st0=$(_mscli status --json 2>/dev/null | sed -n '/^{/,$p') || st0=""
      if [[ "$(jq -r '.loggedIn // false' <<<"$st0" 2>/dev/null)" != true ]]; then
        _signin_start
        teams_audit connect "$agent" --microsoft sign_in groups
        _ms_say sign_in "$agent" site "$SIGNIN_SITE"
        [[ "${FIVEDIVE_JSON_MODE:-0}" == 1 ]] && return 0
        exit "$E_AUTH_REQUIRED"
      fi
      _signin_close
      step "Letting $name join group chats and channels"
      _ms_groups "$agent" "$(_cfg_get "$agent" teams_app_id)" && teams_audit connect "$agent" --microsoft groups || true
    else
      _signin_close
    fi
    _ms_say ready "$agent" name "$name" install_link "$link"; return 0
  fi
  [[ -z "$(_cfg_get "$agent" app_id)" ]] \
    || fail "$E_VALIDATION" "$agent is already in Teams through your IT's own bot. To switch to the one-sign-in way: sudo 5dive agent teams disconnect $agent, then connect again"

  # Microsoft posts to the agent's public address, so the bot needs it now.
  local public domain
  if [[ -n "$endpoint" ]]; then
    [[ "$endpoint" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$ ]] || fail "$E_VALIDATION" "--endpoint must be an https:// address"
    public="${endpoint%/}"; [[ "$public" == */api/messages ]] || public="$public/api/messages"
  elif domain=$(_domain); then
    public="https://teams-$agent.$domain/api/messages"
  else
    fail "$E_VALIDATION" "this server has no public name for Teams to reach. Give it one with --endpoint=https://<your name>, or use your IT's guide: $TEAMS_PLUGIN_ROOT/docs/IT-GUIDE.md"
  fi

  _mscli_ensure
  local st; st=$(_mscli status --json 2>/dev/null | sed -n '/^{/,$p') || st=""
  if [[ "$(jq -r '.loggedIn // false' <<<"$st" 2>/dev/null)" != true ]]; then
    _signin_start
    teams_audit connect "$agent" --microsoft sign_in
    _ms_say sign_in "$agent" site "$SIGNIN_SITE"
    [[ "${FIVEDIVE_JSON_MODE:-0}" == 1 ]] && return 0
    exit "$E_AUTH_REQUIRED"
  fi
  _signin_close

  # Teams must allow custom apps, or the bot is made and nobody can add it.
  local tside uside msg=""
  tside=$(jq -r '.tdp.sideloading.tenant | if . == null then "unknown" else tostring end' <<<"$st" 2>/dev/null || echo unknown)
  uside=$(jq -r '.tdp.sideloading.user | if . == null then "unknown" else tostring end' <<<"$st" 2>/dev/null || echo unknown)
  if [[ "$tside" == false ]]; then
    msg="Your Microsoft 365 does not allow custom apps yet. In the Teams admin center: Teams apps > Manage apps > Actions > Org-wide app settings > turn on Upload custom apps. Then try again."
  elif [[ "$uside" == false ]]; then
    msg="Your Teams account may not add custom apps yet. In the Teams admin center: Teams apps > Setup policies > Global > turn on Upload custom apps. Then try again."
  fi
  if [[ -n "$msg" ]]; then
    _ms_say blocked "$agent" reason custom_apps_off message "$msg"
    [[ "${FIVEDIVE_JSON_MODE:-0}" == 1 ]] && return 0
    exit "$E_PERMISSION"
  fi

  # Made once. A run that made the bot and then failed later finds this record
  # (and the secret already in the connector) and does not make a second bot.
  local made="$MSCLI_HOME/made-$agent.json" app_id tenant_id
  if [[ ! -s "$made" ]] || ! _read_secret "$agent" >/dev/null; then
    step "Making $name's Teams bot in your Microsoft 365"
    local envf out err rc=0 icons avatar iconargs=()
    envf=$(umask 077; mktemp "$MSCLI_HOME/app-XXXXXX.env")
    err=$(mktemp)
    # DIVE-8022: the agent's face as the bot's picture, as the IT-guide package
    # has it. No face (or one that cannot be read): no icons, Teams' own tile.
    icons=$(mktemp -d)
    avatar="$HOME_ROOT/agent-$agent/.claude/avatar.png"
    if [[ -f "$avatar" && ! -L "$avatar" ]] \
      && python3 -I "$TEAMS_PLUGIN_ROOT/cli/package.py" --icons-dir="$icons" --avatar="$avatar" >/dev/null 2>&1 \
      && [[ -s "$icons/color.png" && -s "$icons/outline.png" ]]; then
      iconargs=(--color-icon "$icons/color.png" --outline-icon "$icons/outline.png")
    fi
    out=$(_mscli app create --name "$name" --endpoint "$public" --env "$envf" --json "${iconargs[@]}" 2>"$err") || rc=$?
    rm -rf "$icons"
    out=$(sed -n '/^{/,$p' <<<"$out")
    if (( rc != 0 )) || ! jq -e '.installLink and .botId' <<<"$out" >/dev/null 2>&1; then
      rm -f "$envf"
      _ms_keep_error "app create" "$rc" "$out" "$err"
      local why; why=$(_ms_why "$out" "$err"); rm -f "$err"
      fail "$E_VALIDATION" "Microsoft did not make the bot: ${why:-no answer}"
    fi
    rm -f "$err"
    local secret
    app_id=$(sed -n 's/^CLIENT_ID=//p' "$envf" | tail -1 | tr -d "\"'")
    tenant_id=$(sed -n 's/^TENANT_ID=//p' "$envf" | tail -1 | tr -d "\"'")
    secret=$(sed -n 's/^CLIENT_SECRET=//p' "$envf" | tail -1)
    secret="${secret%\"}"; secret="${secret#\"}"
    shred -u "$envf" 2>/dev/null || rm -f "$envf"
    [[ -n "$secret" ]] || fail "$E_VALIDATION" "Microsoft made the bot but gave no secret"
    printf '%s' "$secret" | "$FIVEDIVE_BIN" secret write TEAMS_APP_PASSWORD --connector="teams-$agent" >/dev/null \
      || fail "$E_VALIDATION" "could not keep the bot's secret on this server"
    unset secret
    ( umask 077; jq -c --arg app "$app_id" --arg ten "$tenant_id" \
        '{install_link:.installLink, teams_app_id:.teamsAppId, bot_id:.botId, app_id:$app, tenant_id:$ten}' <<<"$out" >"$made" )
  fi
  app_id=$(jq -r '.app_id // empty' "$made"); tenant_id=$(jq -r '.tenant_id // empty' "$made")
  link=$(jq -r '.install_link // empty' "$made")

  step "Connecting $name"
  TEAMS_CONNECT_QUIET=1 teams_connect "$agent" "--app-id=$app_id" "--tenant-id=$tenant_id" \
    ${endpoint:+"--endpoint=$endpoint"} "--name=$name" ${role:+"--role=$role"} >&2
  _cfg_merge "$agent" "$(jq -c '{install_link, teams_app_id}' "$made")"
  rm -f "$made"
  step "Letting $name join group chats and channels"
  _ms_groups "$agent" "$(_cfg_get "$agent" teams_app_id)" || true
  _ms_say ready "$agent" name "$name" install_link "$link"
}

teams_status() {
  local agent="${1:-}"
  [[ -n "$agent" ]] || fail "$E_USAGE" "usage: 5dive agent teams status <agent>"
  _name_ok "$agent" || fail "$E_VALIDATION" "not an agent name: $agent"
  local dir; dir=$(_state_dir "$agent")
  local cfg="$dir/config.json"
  local connected=false port="" public="" listening=false healthy=false reachable=unknown chans="" last="" link=""
  if [[ -r "$cfg" ]] && jq -e '.app_id and .tenant_id and .app_password and .port' "$cfg" >/dev/null 2>&1; then
    connected=true
    port=$(jq -r .port "$cfg"); public=$(jq -r '.public_url // empty' "$cfg")
    link=$(jq -r '.install_link // empty' "$cfg")
    [[ -n "$(ss -Hltn "( sport = :$port )" 2>/dev/null)" ]] && listening=true
    curl -fsS -m 3 "http://127.0.0.1:$port/healthz" >/dev/null 2>&1 && healthy=true
    if [[ -n "$public" ]]; then
      curl -fsS -m 6 "${public%/api/messages}/healthz" >/dev/null 2>&1 && reachable=true || reachable=false
    fi
  fi
  chans=$(_agent_json "$agent" | jq -r '.channels // "none"' 2>/dev/null || echo "?")
  [[ -r "$dir/messages.log" ]] && last=$(tail -1 "$dir/messages.log" | cut -f1,2)
  if [[ "${FIVEDIVE_JSON_MODE:-0}" == 1 ]]; then
    jq -n --arg a "$agent" --argjson c "$connected" --arg p "$port" --arg u "$public" --argjson l "$listening" \
      --argjson h "$healthy" --arg r "$reachable" --arg ch "$chans" --arg last "$last" --arg link "$link" \
      '{ok:true, data:{agent:$a, connected:$c, port:$p, endpoint:$u, listening:$l, healthy:$h, reachable_from_internet:$r, channels:$ch, last_message:$last, install_link:$link}}'
    return 0
  fi
  echo "agent:      $agent"
  echo "connected:  $connected"
  [[ "$connected" == true ]] || { echo "next:       sudo 5dive agent teams connect $agent --app-id=<id> --tenant-id=<id>"; return 0; }
  echo "channel on: $([[ ",$chans," == *",teams,"* ]] && echo yes || echo "no (channels=$chans)")"
  echo "endpoint:   ${public:-"(none: forward one to 127.0.0.1:$port)"}"
  echo "listening:  $listening (127.0.0.1:$port, healthy=$healthy)"
  echo "public:     $reachable"
  echo "last:       ${last:-"no message yet"}"
  [[ -z "$link" ]] || echo "add:        $link"
}

teams_disconnect() {
  local agent="${1:-}"
  [[ -n "$agent" ]] || fail "$E_USAGE" "usage: 5dive agent teams disconnect <agent>"
  [[ $EUID -eq 0 ]] || fail "$E_PERMISSION" "run it as root: sudo 5dive agent teams disconnect $agent"
  _name_ok "$agent" || fail "$E_VALIDATION" "not an agent name: $agent"
  local info; info=$(_agent_json "$agent") || fail "$E_NOT_FOUND" "no agent named '$agent'"
  local chans; chans=$(jq -r '.channels // "none"' <<<"$info")
  if [[ ",$chans," == *",teams,"* ]]; then
    local next; next=$(tr ',' '\n' <<<"$chans" | grep -vx teams | paste -sd, -)
    step "Turning off the Teams channel for $agent"
    "$FIVEDIVE_BIN" agent config "$agent" set channels="${next:-none}" >&2 || warn "could not change channels; do it by hand"
  fi
  if _has_route "$agent"; then
    "$FIVEDIVE_BIN" route rm "teams-$agent" >&2 || warn "could not remove the public name teams-$agent"
  fi
  rm -f "$(_state_dir "$agent")/config.json" "$(_state_dir "$agent")/state.json" "$(_connector "$agent")"
  rm -rf "$CONNECTORS_DIR/teams-$agent.d"
  rm -f "$MSCLI_HOME/made-$agent.json"
  teams_audit disconnect "$agent"
  echo "$agent is off Teams. The secret is deleted from this server. Your IT can remove the app in the Teams admin center and delete the bot's secret in Azure."
}

# ── admins and members (DIVE-7976) ─────────────────────────────────────────
# One roles file per box, read by every agent's Teams channel (roles.ts):
#   { "check": "on"|"off", "admins": ["teams:<id>", …], "members_may": [kind, …] }
# Root writes it (0644 root:root), so an agent cannot make its own asker an admin.
_roles_read() {  # a missing file is an empty one; a broken one is refused, never overwritten
  [[ -e "$ROLES_FILE" ]] || { jq -nc '{check:"on", admins:[], members_may:[]}'; return; }
  jq -ce '{check: (if .check == "off" then "off" else "on" end), admins: ((.admins // []) | map(ascii_downcase)), members_may: (.members_may // [])}' "$ROLES_FILE" 2>/dev/null \
    || fail "$E_VALIDATION" "$ROLES_FILE is not valid JSON; fix or remove it first"
}
_roles_write() {  # <json>
  local tmp; mkdir -p -- "$(dirname "$ROLES_FILE")"
  tmp="$(mktemp "$ROLES_FILE.XXXXXX")"
  jq . <<<"$1" >"$tmp" && chmod 0644 "$tmp" && mv -f -- "$tmp" "$ROLES_FILE"
}
_role_key() {  # <id> -> channel:id, or fail
  local id="${1,,}"
  if _guid_ok "$id"; then printf 'teams:%s' "$id"; return; fi
  if [[ "$id" =~ ^teams:([0-9a-f-]{36})$ ]] && _guid_ok "${BASH_REMATCH[1]}"; then printf '%s' "$id"; return; fi
  if [[ "$id" =~ ^telegram:[0-9]{1,20}$ ]]; then printf '%s' "$id"; return; fi
  fail "$E_VALIDATION" "not an id: ${1:-(none)}. Give the person's Entra object id (Teams admin center > Users > the person > Object ID), or telegram:<user id>"
}
teams_admins() {
  local sub="${1:-list}"; [[ $# -gt 0 ]] && shift
  local cur key; cur="$(_roles_read)"
  case "$sub" in
    list|ls)
      local n; n=$(jq '.admins | length' <<<"$cur")
      if [[ "$(jq -r .check <<<"$cur")" == off ]]; then
        echo "Roles are off on this server: everyone allowed in is treated as an admin."
      elif (( n == 0 )); then
        echo "No admins yet: everyone is a member, and a member's risky ask waits until IT names an admin."
      else
        echo "Admins ($n):"; jq -r '.admins[] | "  " + .' <<<"$cur"
        echo "Everyone else allowed in is a member: a risky ask from them waits for an admin's yes."
      fi
      local may; may=$(jq -r '.members_may | join(", ")' <<<"$cur")
      [[ -n "$may" ]] && echo "Members may also, without an admin: $may"
      return 0 ;;
  esac
  [[ $EUID -eq 0 ]] || fail "$E_PERMISSION" "changing admins needs root: sudo 5dive agent teams admins $sub $*"
  case "$sub" in
    add)
      key="$(_role_key "${1:-}")"
      _roles_write "$(jq -c --arg k "$key" '.admins = ((.admins + [$k]) | unique)' <<<"$cur")"
      teams_audit admins add "$key"
      echo "$key is an admin. Their risky asks go ahead, and they get the approval cards." ;;
    remove|rm)
      key="$(_role_key "${1:-}")"
      jq -e --arg k "$key" '.admins | index($k)' <<<"$cur" >/dev/null || fail "$E_NOT_FOUND" "$key is not an admin"
      _roles_write "$(jq -c --arg k "$key" '.admins -= [$k]' <<<"$cur")"
      teams_audit admins remove "$key"
      echo "$key is a member now." ;;
    check)
      case "${1:-}" in
        on|off) ;;
        *) fail "$E_USAGE" "admins check on|off" ;;
      esac
      _roles_write "$(jq -c --arg v "$1" '.check = $v' <<<"$cur")"
      teams_audit admins check "$1"
      [[ "$1" == off ]] && echo "Roles off: everyone allowed in can ask for anything again." || echo "Roles on: a member's risky ask waits for an admin's yes." ;;
    members-may)
      local list="${1:-}" k out=()
      [[ -n "$list" ]] || fail "$E_USAGE" "admins members-may <kind,…|none>, kinds: ${RISK_KINDS// /, }"
      if [[ "$list" != none ]]; then
        for k in ${list//,/ }; do
          [[ " $RISK_KINDS " == *" $k "* ]] || fail "$E_VALIDATION" "unknown kind: $k (kinds: ${RISK_KINDS// /, })"
          out+=("$k")
        done
      fi
      _roles_write "$(jq -c '.members_may = ($ARGS.positional | unique)' --args "${out[@]}" <<<"$cur")"
      teams_audit admins members-may "$list"
      echo "Members may now, without an admin: ${out[*]:-nothing risky}" ;;
    *) fail "$E_USAGE" "unknown admins command: $sub (list|add|remove|check|members-may)" ;;
  esac
}

_teams_main() {
  [[ "${1:-}" == agent ]] && shift
  local sub="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$sub" in
    connect) teams_connect "$@" ;;
    status) teams_status "$@" ;;
    disconnect) teams_disconnect "$@" ;;
    admins) teams_admins "$@" ;;
    ""|-h|--help|help)
      cat >&2 <<'USAGE'
5dive agent teams — an agent as its own contact in Microsoft Teams (plugin teams@5dive-plugins)

  sudo 5dive agent teams connect <agent> --app-id=<id> --tenant-id=<id> [--endpoint=<https url>]
                                 [--task=<DIVE-N>] [--name=<shown name>] [--role=<one line>]
  sudo 5dive agent teams connect <agent> --microsoft [--name=<shown name>] [--role=<one line>] [--json]
                                 one Microsoft sign-in in this box's browser, then 5dive makes
                                 the agent's Teams bot and prints its "Add to Teams" link
  5dive agent teams status <agent>
  sudo 5dive agent teams disconnect <agent>
  5dive agent teams admins                  who is an admin on this server
  sudo 5dive agent teams admins add|remove <Entra object id>
  sudo 5dive agent teams admins check on|off
  sudo 5dive agent teams admins members-may <root,pay,delete,send,settings,access|none>
USAGE
      [[ -n "$sub" ]] && return 0
      return "$E_USAGE" ;;
    *) fail "$E_USAGE" "unknown teams command: $sub (connect|status|disconnect|admins)" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  _teams_main "$@"
fi
