#!/usr/bin/env bash
# `5dive phone`: your agent uses apps on an Android phone you set aside for it.
#
# THE TRANSPORT is adb, Android's own debugging bridge, over the phone's
# Tailscale address. Nothing is installed on the phone and nothing comes from
# Google Play: the phone's Developer options and one pairing code are all it
# takes. The screen is read with uiautomator, which ships inside Android, and
# taps and typing are adb's `input`. No third-party code runs on either side.
#
# THE SHAPE mirrors `5dive browser` so an agent needs no new habits:
#   snapshot  the screen as controls with refs ([e3] button "Send")
#   act       tap / type / scroll / key on refs, in one call
#   screenshot for a check by eye
#
# THE OWNER'S POLICY is the browser's, the same file and the same answers
# (`sudo 5dive browser approvals policy set careful`): paying stops for the
# owner by default; posting, sending and deleting go ahead and are logged; under
# careful all four stop. A stop writes the ask where the browser writes its asks,
# so the owner's one-tap Approve in Telegram (`5dive owner-ask`) and
# `sudo 5dive browser approve <id>` answer a phone ask exactly as a browser one.
#
# EVERY STEP IS LOGGED in the seat's own ~/.5dive/phone/actions.jsonl (0600).
# Screenshots stay in ~/.5dive/phone/shots (0700) and are never printed into a
# log or a chat by this command: it prints their path, nothing else.
set -uo pipefail

PROG="5dive phone"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UI="$SELF_DIR/../lib/ui.py"
STATE_DIR="${STATE_DIR:-/var/lib/5dive}"
HOME_DIR="${FIVEDIVE_PHONE_HOME:-${HOME:-/tmp}/.5dive/phone}"
ADB="${FIVEDIVE_PHONE_ADB:-adb}"
ADB_TIMEOUT="${FIVEDIVE_PHONE_ADB_TIMEOUT:-25}"
APPROVAL_TTL=1800
APPROVAL_KINDS="pay publish send delete"
APPROVAL_DEFAULTS='{"pay":"ask","publish":"allow","send":"allow","delete":"allow"}'
JSON="${FIVEDIVE_JSON_MODE:-0}"

E_USAGE=2 E_UNAVAILABLE=69 E_OWNER=73
die() { local rc="$1"; shift; printf '%s: %s\n' "$PROG" "$*" >&2; exit "$rc"; }
note() { printf '%s: %s\n' "$PROG" "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'USAGE'
5dive phone: use apps on an Android phone your owner set aside for you

  5dive phone guide                     the steps your owner does on the phone, once
  5dive phone connect <ip>[:<port>] [--pair=<ip>:<port> --code=<6 digits>]
                                        pair (first time) and connect over Tailscale
  5dive phone status [--json]           connected? which phone, screen, lock, app
  5dive phone apps [<filter>]           installed apps (package names for open)
  5dive phone snapshot [--interactive] [--json]
                                        the screen as controls with refs:
                                        [e3] button "Send"  ⚠ send
  5dive phone act --steps='[...]' [--approved=<id>] [--expect=<regex>]
      {"op":"open","app":"com.whatsapp"}     {"op":"open","url":"https://…"}
      {"op":"tap","ref":"e3"}                {"op":"tap","x":540,"y":1200}
      {"op":"tap","ref":"button/Send"}       a ref BY NAME (role/label) is found on
                                             the screen as it is when the step runs
      {"op":"type","ref":"e5","text":"hi"}   (add "clear":true to empty it first)
      {"op":"clear","ref":"e5"}              {"op":"key","key":"back|home|enter|…"}
      {"op":"scroll","dir":"down|up|left|right"}   {"op":"wait","ms":1500}
      A tap on Pay/Buy, Post, Send or Delete is checked against your owner's
      policy (the browser's): paying stops by default, careful stops all four
      (exit 73) and asks your owner. Label any other step that sends, posts,
      pays or deletes with "kind":"send" etc. (an Enter that sends, a swipe).
      After the steps it prints the screen they left.
  5dive phone screenshot [--out=<file>] a PNG of the screen, saved privately
  5dive phone log [--n=20]              the steps this seat ran on the phone
  5dive phone approvals policy [--json] your owner's policy (shared with browser)
  sudo 5dive phone approvals policy set standard|yolo|careful
  5dive phone disconnect                forget the phone on this seat
  sudo 5dive phone setup                install adb on this server
USAGE
}

# ---------- seat state ----------
_seat() { id -un; }
_init_home() { mkdir -p "$HOME_DIR/shots" && chmod 700 "$HOME_DIR" "$HOME_DIR/shots" 2>/dev/null; }
_device_file() { printf '%s/device\n' "$HOME_DIR"; }
DEV=""
_load_device() {
  [[ -n "$DEV" ]] && return 0
  [[ -r "$(_device_file)" ]] && DEV="$(head -1 "$(_device_file)")"
  [[ -n "$DEV" ]] || die "$E_UNAVAILABLE" "no phone connected on this seat. Ask your owner to set one up: 5dive phone guide"
}

# ---------- adb ----------
_need_adb() {
  have "$ADB" || die "$E_UNAVAILABLE" "adb is not installed on this server. Your owner runs: sudo 5dive phone setup"
  have python3 || die "$E_UNAVAILABLE" "python3 is missing on this server (it reads the screen)"
}
_adb_raw() { timeout "$ADB_TIMEOUT" "$ADB" "$@"; }
_adb() { timeout "$ADB_TIMEOUT" "$ADB" -s "$DEV" "$@"; }
_state() { _adb_raw -s "$DEV" get-state 2>&1 | tr -d '\r' | tail -1; }

# THE PHONE GOES AWAY ON A REBOOT. adb's fixed port (5555, set by `adb tcpip`)
# is forgotten when the phone restarts, and Wireless debugging is switched off.
# One reconnect is tried; after that only the owner can help, and the message
# says exactly what to ask them.
_ensure_connected() {
  _need_adb; _load_device
  local st; st="$(_state)"
  [[ "$st" == device ]] && return 0
  _adb_raw connect "$DEV" >/dev/null 2>&1; sleep 1
  st="$(_state)"
  [[ "$st" == device ]] && { note "reconnected to $DEV"; return 0; }
  case "$st" in
    *unauthorized*) die "$E_UNAVAILABLE" "the phone at $DEV has not allowed this server yet. Ask your owner: \"Unlock the phone and tap Allow on the debugging prompt (tick Always allow).\"" ;;
  esac
  die "$E_UNAVAILABLE" "the phone at $DEV does not answer (it may have restarted, lost Tailscale, or run out of battery). Ask your owner: \"Is the phone on and on Tailscale? Open Settings > Developer options > Wireless debugging, turn it on, and tell me the port under IP address & Port.\" Then: 5dive phone connect ${DEV%:*}:<that port>"
}

_screen_size() {  # -> "W H"
  local s; s="$(_adb shell wm size 2>/dev/null | tr -d '\r' | grep -oE '[0-9]+x[0-9]+' | tail -1)"
  [[ -n "$s" ]] || s="1080x2340"
  printf '%s %s\n' "${s%x*}" "${s#*x}"
}
# Read whole, then match: `grep -q` quits early, the writer dies of SIGPIPE, and
# under pipefail a screen that is on reads as off.
_screen_on() { local o; o="$(_adb shell dumpsys power 2>/dev/null)"; grep -qE 'mWakefulness=Awake|Display Power: state=ON' <<<"$o"; }
_locked() { local o; o="$(_adb shell dumpsys window 2>/dev/null)"; grep -qE 'mDreamingLockscreen=true|isKeyguardShowing=true|mShowingLockscreen=true|KeyguardShowing=true' <<<"$o"; }
_wake() {
  _screen_on && return 0
  _adb shell input keyevent KEYCODE_WAKEUP >/dev/null 2>&1; sleep 0.6
  if _locked; then
    _adb shell input keyevent KEYCODE_MENU >/dev/null 2>&1; sleep 0.4   # a swipe-only lock opens on MENU
  fi
}
_current_app() {
  local o; o="$(_adb shell dumpsys window 2>/dev/null | tr -d '\r')"
  grep -m1 -oE 'mCurrentFocus=Window\{[^ ]+ [^ ]+ [^/} ]+' <<<"$o" | awk '{print $3}'
}

# One fresh screen dump into <file>. uiautomator refuses while an animation runs
# ("could not get idle state"), so it is tried three times.
_dump() {
  local out="$1" i
  for i in 1 2 3; do
    if _adb shell uiautomator dump /sdcard/.5dive-ui.xml >/dev/null 2>&1 \
       && _adb exec-out cat /sdcard/.5dive-ui.xml > "$out" 2>/dev/null && grep -q '<hierarchy' "$out"; then
      return 0
    fi
    sleep 0.7
  done
  die 1 "could not read the screen (uiautomator gave no dump three times). Take a screenshot: 5dive phone screenshot"
}

_shot() {  # <out-file> -> writes a PNG
  _adb exec-out screencap -p > "$1" 2>/dev/null && [[ -s "$1" ]] && chmod 600 "$1"
}

# ---------- the owner's policy (the browser's file) ----------
_grant_uid() { printf '%s\n' "${FIVEDIVE_PHONE_GRANT_UID:-0}"; }
_policy_file() { printf '%s\n' "${FIVEDIVE_PHONE_APPROVAL_POLICY:-$STATE_DIR/browser-profiles/.approval-policy.json}"; }
_policy_owned() {
  local f cur='{}'; f="$(_policy_file)"
  if [[ -f "$f" && ! -L "$f" && "$(stat -c %u "$f" 2>/dev/null)" == "$(_grant_uid)" ]]; then
    cur=$(jq -c 'if type == "object" then . else {} end' "$f" 2>/dev/null) || cur='{}'
    [[ -n "$cur" ]] || cur='{}'   # an empty file is no policy, not a broken one
  fi
  printf '%s\n' "$cur"
}
_policy_json() {
  jq -nc --argjson c "$(_policy_owned)" --argjson d "$APPROVAL_DEFAULTS" \
    '$d | with_entries(.value = (if $c[.key] == "ask" or $c[.key] == "allow" or $c[.key] == "always" then $c[.key] else $d[.key] end))'
}
_policy_mode() { jq -r --argjson d "$APPROVAL_DEFAULTS" \
  'if . == $d then "standard" elif ([.[]] | all(. == "allow" or . == "always")) then "yolo" elif ([.[]] | all(. == "ask")) then "careful" else "custom" end'; }

cmd_approvals() {
  [[ "${1:-}" == policy ]] || die "$E_USAGE" "usage: 5dive phone approvals policy [--json] | sudo 5dive phone approvals policy set standard|yolo|careful"
  shift
  if [[ "${1:-}" != set ]]; then
    local pol; pol="$(_policy_json)"
    if [[ "$JSON" == 1 || "${1:-}" == --json ]]; then
      jq -c --arg m "$(_policy_mode <<<"$pol")" '{ok:true, mode:$m, kinds:.}' <<<"$pol"
    else
      printf 'mode: %s (shared with 5dive browser)\n' "$(_policy_mode <<<"$pol")"
      jq -r 'to_entries[] | "  \(.key): \(.value)"' <<<"$pol"
    fi
    return 0
  fi
  local preset="${2:-}" cur
  case "$preset" in
    standard) cur="$APPROVAL_DEFAULTS" ;;
    yolo)     cur='{"pay":"allow","publish":"allow","send":"allow","delete":"allow"}' ;;
    careful)  cur='{"pay":"ask","publish":"ask","send":"ask","delete":"ask"}' ;;
    *) die "$E_USAGE" "usage: sudo 5dive phone approvals policy set standard|yolo|careful" ;;
  esac
  [[ "$(id -u)" == "$(_grant_uid)" ]] || die "$E_USAGE" "only the box owner sets the policy: sudo 5dive phone approvals policy set $preset"
  if have 5dive && [[ -z "${FIVEDIVE_PHONE_APPROVAL_POLICY:-}" ]] && 5dive browser approvals policy --help >/dev/null 2>&1; then
    5dive browser approvals policy set "$preset"; return
  fi
  local f d tmp; f="$(_policy_file)"; d="$(dirname "$f")"
  mkdir -p "$d" && chmod 711 "$d" || die 1 "cannot create $d"
  tmp="$(mktemp "$d/.policy.XXXXXX")" || die 1 "cannot write in $d"
  printf '%s\n' "$cur" > "$tmp" && chmod 644 "$tmp" && mv -f -- "$tmp" "$f" || { rm -f -- "$tmp"; die 1 "cannot write $f"; }
  printf 'policy: %s\n' "$preset"
}

# ---------- asks and grants (the browser's approvals directory) ----------
_approval_dir() {
  if [[ -n "${FIVEDIVE_PHONE_APPROVAL_DIR:-}" ]]; then printf '%s\n' "$FIVEDIVE_PHONE_APPROVAL_DIR"; return 0; fi
  local home; home="$(getent passwd "$(_seat)" 2>/dev/null | cut -d: -f6)"
  [[ -n "$home" ]] || home="$HOME"
  printf '%s/.5dive/browser-approvals\n' "$home"
}
_act_hash() { printf 'phone:%s\n%s\n' "$1" "$(jq -cS . <<<"$2")" | sha256sum | cut -d' ' -f1; }
_grant_ok() {  # <id> <hash>
  local d g exp; d="$(_approval_dir)"; g="$d/$1.granted"
  [[ -f "$g" && ! -L "$g" && "$(stat -c %u "$g")" == "$(_grant_uid)" ]] || return 1
  [[ "$(jq -r '.hash // ""' "$g" 2>/dev/null)" == "$2" ]] || return 2
  exp="$(jq -r '.expires_at // 0' "$g" 2>/dev/null)"
  [[ "$exp" =~ ^[0-9]+$ ]] && (( exp > $(date +%s) )) || return 3
}
_grant_spend() { local d; d="$(_approval_dir)"; rm -f -- "$d/$1.granted" "$d/$1.json" 2>/dev/null; }

_verb_of() { case "$1" in pay) echo "pay or place an order" ;; publish) echo "post or publish" ;; send) echo "send a message" ;; delete) echo "delete something" ;; *) echo "do something only the owner can allow" ;; esac; }

# THE ASK. Written in the browser's request format so the same relay carries it:
# `5dive owner-ask browser <file>` sends the owner the payload, the screenshot and
# Approve / Decline; `sudo 5dive browser approve <id>` grants it. The grant is
# bound to the hash of these exact steps on this phone.
_owner_ask() {  # <hash> <steps> <step#> <kind> <label> <text> <app>
  local hash="$1" steps="$2" step="$3" kind="$4" label="$5" text="$6" app="$7"
  local ad id shot="" model where
  model="$(_adb shell getprop ro.product.model 2>/dev/null | tr -d '\r')"
  where="your phone${model:+ ($model)}"
  ad="$(_approval_dir)"; mkdir -p "$ad" && chmod 700 "$ad" 2>/dev/null
  id="$(_seat)-$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  _init_home
  shot="$HOME_DIR/shots/ask-$id.png"; _shot "$shot" || shot=""
  jq -n --arg id "$id" --arg seat "$(_seat)" --arg site "$where" --arg h "$hash" --argjson s "$steps" \
        --arg cls "$kind" --arg label "$label" --arg step "$step" --arg shot "$shot" --arg app "$app" \
        --arg text "$text" --argjson at "$(date +%s)" \
    '{id:$id, seat:$seat, site:$site, hash:$h, steps:$s, class:$cls, label:$label, step:$step, page:("app " + $app),
      screenshot:$shot, asked_at:$at, source:"phone",
      payload:({app:$app} + (if $text != "" then {text:$text} else {} end))}' > "$ad/$id.json" || id=""
  printf '%s: STOPPED before step %s — it would %s ("%s") in %s on %s. That is the owner'"'"'s call, not the agent'"'"'s.\n' \
    "$PROG" "$step" "$(_verb_of "$kind")" "$label" "${app:-an app}" "$where" >&2
  printf '  Ask the owner%s: "I am about to %s in %s on your phone%s. OK?"\n' "${shot:+, with the screenshot}" \
    "$(_verb_of "$kind")" "${app:-an app}" "${text:+: \"${text:0:120}\"}" >&2
  [[ -n "$shot" ]] && printf '  screenshot: %s (the screen right before that step)\n' "$shot" >&2
  if [[ -z "$id" ]]; then printf '  (the ask could not be recorded; nothing was approved)\n' >&2; return; fi
  printf '  When the owner says yes: sudo 5dive browser approve %s   — then re-run this exact act with --approved=%s\n' "$id" "$id" >&2
  local o rc=0
  if have 5dive; then o=$(timeout 30 5dive owner-ask browser "$ad/$id.json" 2>/dev/null) || rc=$?; else rc=1; fi
  (( rc == 0 )) && [[ -n "${o:-}" ]] && printf '  %s\n' "$o" >&2
  if (( rc != 0 )) || [[ -z "${o:-}" || "${o:-}" == "not sent"* ]]; then
    printf '  Put it on your row as ONE ask (the owner'"'"'s yes there is this approval):\n    5dive task need <your row> --type=approval --browser-ask=%s --ask="<what you will send, and to whom>?"\n' "$id" >&2
  fi
}

_log() {  # <json-object>
  _init_home
  ( umask 077; jq -c --arg seat "$(_seat)" --arg dev "$DEV" --argjson at "$(date +%s)" '{at:$at, seat:$seat, device:$dev} + .' <<<"$1" >> "$HOME_DIR/actions.jsonl" ) 2>/dev/null || true
}

# ---------- verbs ----------
cmd_setup() {
  [[ "$(id -u)" == 0 ]] || die "$E_USAGE" "run as root: sudo 5dive phone setup"
  if have adb; then printf 'adb: already installed (%s)\n' "$(adb version 2>/dev/null | head -1)"; else
    have apt-get || die "$E_UNAVAILABLE" "only apt boxes (Debian, Ubuntu) are set up automatically; install adb yourself"
    printf 'installing adb (Android platform tools from your distribution)…\n'
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq adb >/dev/null 2>&1 \
      || DEBIAN_FRONTEND=noninteractive apt-get install -y -qq android-tools-adb >/dev/null 2>&1 \
      || die 1 "apt could not install adb"
    printf 'adb: installed\n'
  fi
  have python3 || die "$E_UNAVAILABLE" "python3 is missing; install it (apt-get install python3)"
  if have tailscale; then printf 'tailscale: %s\n' "$(tailscale status --self --peers=false 2>/dev/null | head -1 || echo 'installed')"
  else printf 'tailscale: not on this server. The phone is reached over Tailscale: install it here and sign in to the same account as the phone.\n'; fi
  printf 'next: ask your agent to "connect my phone"\n'
}

cmd_guide() {
  cat <<'GUIDE'
Connect a spare Android phone (once, about 5 minutes). Send your owner ONE step at a time.

1. On the phone: Settings > About phone > tap "Build number" 7 times.
   (Samsung: Settings > About phone > Software information > Build number.)
   This turns on Developer options.
2. Install Tailscale on the phone from its app store and sign in with the same
   account as this server. Ask for the phone's Tailscale address (100.x.y.z).
3. Settings > Developer options: turn on "Stay awake", and on Android 11+ turn
   on "Disable adb authorization timeout" so the pairing does not expire.
   On a spare phone, set Screen lock to None or Swipe and keep it on a charger.
4. Settings > Developer options > Wireless debugging: turn it on, tap
   "Pair device with pairing code". Ask for the 6-digit code and the port shown
   under it, and the port under "IP address & Port" on the screen before.
5. You run:  5dive phone connect <tailscale ip>:<port> --pair=<tailscale ip>:<pairing port> --code=<code>
   If the phone shows "Allow debugging?", the owner ticks Always allow and taps Allow.

After a restart the phone stops listening. Ask the owner to turn Wireless
debugging on again and tell you the new port, then: 5dive phone connect <ip>:<port>
(no new code needed). This server must be on the same Tailscale network.
GUIDE
}

cmd_connect() {
  local target="" pair="" code="" a
  for a in "$@"; do
    case "$a" in
      --pair=*) pair="${a#*=}" ;;
      --code=*) code="${a#*=}" ;;
      -*) die "$E_USAGE" "unknown flag: $a" ;;
      *) target="$a" ;;
    esac
  done
  [[ -n "$target" ]] || die "$E_USAGE" "usage: 5dive phone connect <ip>[:<port>] [--pair=<ip>:<port> --code=<6 digits>]  (steps: 5dive phone guide)"
  [[ "$target" == *:* ]] || target="$target:5555"
  [[ "$target" =~ ^[A-Za-z0-9._-]+:[0-9]{2,5}$ ]] || die "$E_USAGE" "not an address: $target (want <ip>:<port>)"
  _need_adb; _init_home
  if [[ -n "$pair$code" ]]; then
    [[ "$pair" =~ ^[A-Za-z0-9._-]+:[0-9]{2,5}$ && "$code" =~ ^[0-9]{6}$ ]] || die "$E_USAGE" "pairing needs both --pair=<ip>:<port> and --code=<6 digits>"
    local po; po="$(_adb_raw pair "$pair" "$code" 2>&1 | tr -d '\r')"
    [[ "$po" == *"Successfully paired"* ]] || die 1 "pairing failed: ${po:-no answer}. The code and its port change each time the pairing screen opens: ask your owner for fresh ones."
    note "paired with $pair"
  fi
  local co; co="$(_adb_raw connect "$target" 2>&1 | tr -d '\r')"
  DEV="$target"
  local st; st="$(_state)"
  if [[ "$st" != device ]]; then
    case "$st$co" in
      *unauthorized*) die "$E_UNAVAILABLE" "the phone has not allowed this server. Ask your owner to unlock it and tap Allow on \"Allow debugging?\" (tick Always allow), then run connect again." ;;
      *refused*|*"failed to connect"*|*"timed out"*|*"No route"*)
        die "$E_UNAVAILABLE" "cannot reach $target: ${co}. Is Wireless debugging on, and is this the port under IP address & Port? Is this server on the same Tailscale network as the phone (tailscale status)?" ;;
    esac
    die "$E_UNAVAILABLE" "connect to $target gave: ${co:-nothing} (state: $st)"
  fi
  # A FIXED PORT. Wireless debugging picks a new port every time it is switched on;
  # `adb tcpip 5555` makes the phone listen on 5555 until it restarts, over Wi-Fi
  # or mobile data alike, so a dropped connection can be picked up without the owner.
  if [[ "${target##*:}" != 5555 && "${FIVEDIVE_PHONE_FIXED_PORT:-1}" == 1 ]]; then
    local host="${target%:*}"
    if _adb tcpip 5555 >/dev/null 2>&1; then
      sleep 2
      if [[ "$(_adb_raw connect "$host:5555" 2>&1)" == *'connected to'* ]]; then
        DEV="$host:5555"; sleep 1
        [[ "$(_state)" == device ]] || DEV="$target"
      fi
    fi
  fi
  printf '%s\n' "$DEV" > "$(_device_file)"; chmod 600 "$(_device_file)"
  local model rel
  model="$(_adb shell getprop ro.product.model 2>/dev/null | tr -d '\r')"
  rel="$(_adb shell getprop ro.build.version.release 2>/dev/null | tr -d '\r')"
  _log "$(jq -nc --arg m "$model" '{op:"connect", label:$m}')"
  printf 'connected: %s, Android %s, at %s\n' "${model:-phone}" "${rel:-?}" "$DEV"
}

cmd_status() {
  _need_adb
  if ! { [[ -n "$DEV" ]] || [[ -r "$(_device_file)" ]]; }; then
    [[ "$JSON" == 1 ]] && { echo '{"ok":true,"connected":false}'; return 0; }
    printf 'no phone connected on this seat (5dive phone guide)\n'; return 0
  fi
  _load_device
  local st; st="$(_state)"
  if [[ "$st" != device ]]; then
    [[ "$JSON" == 1 ]] && { jq -nc --arg d "$DEV" --arg s "$st" '{ok:true,connected:false,device:$d,state:$s}'; return 0; }
    printf 'phone %s: not answering (%s). 5dive phone snapshot tries to reconnect and says what to ask the owner.\n' "$DEV" "$st"; return 0
  fi
  local model rel on=false lock=false app bat
  model="$(_adb shell getprop ro.product.model 2>/dev/null | tr -d '\r')"
  rel="$(_adb shell getprop ro.build.version.release 2>/dev/null | tr -d '\r')"
  _screen_on && on=true; _locked && lock=true
  app="$(_current_app)"
  bat="$(_adb shell dumpsys battery 2>/dev/null | tr -d '\r' | awk -F': ' '/ level:/{print $2; exit}')"
  if [[ "$JSON" == 1 ]]; then
    jq -nc --arg d "$DEV" --arg m "$model" --arg r "$rel" --argjson on "$on" --argjson l "$lock" --arg a "$app" --arg b "$bat" \
      '{ok:true,connected:true,device:$d,model:$m,android:$r,screen_on:$on,locked:$l,app:$a,battery:$b}'
    return 0
  fi
  printf 'connected: %s, Android %s, at %s\nscreen: %s%s · app: %s · battery: %s%%\n' "${model:-?}" "${rel:-?}" "$DEV" \
    "$([[ $on == true ]] && echo on || echo off)" "$([[ $lock == true ]] && echo ', LOCKED (ask the owner to set Screen lock to None or Swipe)')" "${app:-?}" "${bat:-?}"
}

cmd_apps() {
  _ensure_connected
  _adb shell pm list packages -3 2>/dev/null | tr -d '\r' | sed 's/^package://' | sort | { if [[ -n "${1:-}" ]]; then grep -i -- "$1"; else cat; fi; }
}

cmd_snapshot() {
  local inter="" json="" a
  for a in "$@"; do case "$a" in --interactive|-i) inter=--interactive ;; --json) json=--json ;; *) die "$E_USAGE" "unknown argument: $a" ;; esac; done
  [[ "$JSON" == 1 ]] && json=--json
  _ensure_connected; _init_home; _wake
  local x="$HOME_DIR/ui.xml"
  _dump "$x"
  python3 "$UI" snapshot "$x" "$HOME_DIR/refs.json" $inter $json
}

cmd_screenshot() {
  local out="" a
  for a in "$@"; do case "$a" in --out=*) out="${a#*=}" ;; *) die "$E_USAGE" "unknown argument: $a" ;; esac; done
  _ensure_connected; _init_home; _wake
  [[ -n "$out" ]] || out="$HOME_DIR/shots/$(date -u +%Y%m%dT%H%M%SZ).png"
  _shot "$out" || die 1 "the phone gave no screenshot"
  printf '%s\n' "$out"
}

cmd_log() {
  local n=20 a; for a in "$@"; do case "$a" in --n=*) n="${a#*=}" ;; esac; done
  [[ -r "$HOME_DIR/actions.jsonl" ]] || { echo "(no steps logged on this seat yet)"; return 0; }
  tail -n "$n" "$HOME_DIR/actions.jsonl"
}

cmd_disconnect() {
  _need_adb
  [[ -r "$(_device_file)" ]] && { _load_device; _adb_raw disconnect "$DEV" >/dev/null 2>&1; rm -f -- "$(_device_file)"; printf 'forgot %s\n' "$DEV"; return 0; }
  echo "no phone connected on this seat"
}

_keycode() {
  case "${1,,}" in
    back) echo 4 ;; home) echo 3 ;; enter|return) echo 66 ;; recents|apps|app_switch) echo 187 ;;
    delete|backspace|del) echo 67 ;; tab) echo 61 ;; search) echo 84 ;; menu) echo 82 ;;
    wake|wakeup) echo 224 ;; up) echo 19 ;; down) echo 20 ;; left) echo 21 ;; right) echo 22 ;;
    volume_up) echo 24 ;; volume_down) echo 25 ;; escape|esc) echo 111 ;;
    *) [[ "$1" =~ ^[0-9]{1,3}$ ]] && echo "$1" || return 1 ;;
  esac
}

# `input text` takes ASCII only, and %s stands for a space. The device shell
# reads the line, so the text goes single-quoted.
_type_text() {
  local t="$1" chunk q
  while [[ -n "$t" ]]; do
    chunk="${t:0:80}"; t="${t:80}"
    q="${chunk// /%s}"; q="${q//\'/\'\\\'\'}"
    _adb shell "input text '$q'" >/dev/null 2>&1 || return 1
  done
}

# What a step would do, before it runs: the kind (pay|publish|send|delete or "")
# and the words on what it touches. A ref is read from the last snapshot; a tap by
# position is read on a fresh dump at run time.
_preflight_kind() {  # <step-json> -> "kind<TAB>label"
  local s="$1" op ref k label=""
  op="$(jq -r '.op // ""' <<<"$s")"; k="$(jq -r '.kind // ""' <<<"$s")"
  ref="$(jq -r '.ref // ""' <<<"$s")"
  if [[ "$op" == tap && "$ref" == */* ]]; then
    label="${ref#*/}"
    [[ -n "$k" ]] || k="$(python3 "$UI" classify "$label")"
  elif [[ "$op" == tap && -n "$ref" && -r "$HOME_DIR/refs.json" ]]; then
    label="$(jq -r --arg r "$ref" '.refs[$r].label // ""' "$HOME_DIR/refs.json")"
    [[ -n "$k" ]] || k="$(jq -r --arg r "$ref" '.refs[$r].kind // ""' "$HOME_DIR/refs.json")"
  fi
  [[ " $APPROVAL_KINDS " == *" $k "* ]] || k=""
  printf '%s\t%s\n' "$k" "$label"
}

cmd_act() {
  local steps="" approved="" expect="" a
  for a in "$@"; do
    case "$a" in
      --steps=*) steps="${a#*=}" ;;
      --approved=*) approved="${a#*=}" ;;
      --expect=*) expect="${a#*=}" ;;
      *) die "$E_USAGE" "unknown argument: $a (usage: 5dive phone act --steps='[...]')" ;;
    esac
  done
  [[ -n "$steps" ]] || die "$E_USAGE" "usage: 5dive phone act --steps='[{\"op\":\"tap\",\"ref\":\"e3\"}]'"
  jq -e 'type == "array" and length > 0 and all(.[]; type == "object" and (.op | type == "string"))' <<<"$steps" >/dev/null 2>&1 \
    || die "$E_USAGE" "--steps must be a JSON array of steps, each with an \"op\""
  local bad; bad="$(jq -r '[.[] | select(.op == "type") | .text // "" | select(test("[^ -~]"))] | length' <<<"$steps")"
  (( bad == 0 )) || die "$E_USAGE" "a type step has text this version cannot type: Latin letters, digits and punctuation only, no line breaks (a line break that sends is a {\"op\":\"key\",\"key\":\"enter\",\"kind\":\"send\"} step)"
  _ensure_connected; _init_home; _wake

  local hash pol granted=0 n i
  hash="$(_act_hash "$DEV" "$steps")"
  pol="$(_policy_json)"
  if [[ -n "$approved" ]]; then
    _grant_ok "$approved" "$hash"; case $? in
      0) granted=1 ;;
      2) die "$E_OWNER" "approval $approved was for different steps. Re-run the exact steps the owner approved, or ask again." ;;
      3) die "$E_OWNER" "approval $approved has expired (good for $((APPROVAL_TTL/60)) minutes). Ask again." ;;
      *) die "$E_OWNER" "approval $approved is not granted (yet). The owner answers it: the Approve button, or sudo 5dive browser approve $approved" ;;
    esac
  fi
  n="$(jq 'length' <<<"$steps")"
  local app; app="$(_current_app)"
  local typed=""; typed="$(jq -r '[.[] | select(.op == "type") | .text // ""] | last // ""' <<<"$steps")"

  # PREFLIGHT: a step the owner must allow stops the act BEFORE any step runs, so
  # an approved re-run does not type the same text twice.
  if (( ! granted )); then
    local kl k label
    for (( i = 0; i < n; i++ )); do
      kl="$(_preflight_kind "$(jq -c ".[$i]" <<<"$steps")")"; k="${kl%%$'\t'*}"; label="${kl#*$'\t'}"
      [[ -n "$k" ]] || continue
      if [[ "$(jq -r --arg k "$k" '.[$k]' <<<"$pol")" == ask ]]; then
        _log "$(jq -nc --argjson i $((i+1)) --arg k "$k" --arg l "$label" --arg a "$app" '{step:$i, op:"stop", kind:$k, label:$l, app:$a, allowed_by:"asked owner"}')"
        _owner_ask "$hash" "$steps" "$((i+1))" "$k" "$label" "$typed" "$app"
        exit "$E_OWNER"
      fi
    done
  fi

  local s op ref x y r W H res kind lbl by
  read -r W H < <(_screen_size)
  for (( i = 0; i < n; i++ )); do
    s="$(jq -c ".[$i]" <<<"$steps")"; op="$(jq -r .op <<<"$s")"; ref="$(jq -r '.ref // ""' <<<"$s")"
    kind="$(jq -r '.kind // ""' <<<"$s")"; [[ " $APPROVAL_KINDS " == *" $kind "* ]] || kind=""
    lbl="" x="" y="" res=""
    # Where a ref or a point lands NOW, read on a fresh dump.
    if [[ -n "$ref" && "$op" =~ ^(tap|type|clear)$ ]]; then
      # A screen mid-change, or an app whose tree comes and goes between dumps
      # (a browser's web page does), is read again before the step gives up.
      local try ok=0
      for try in 1 2 3; do
        _dump "$HOME_DIR/ui-now.xml"
        res="$(python3 "$UI" resolve "$HOME_DIR/refs.json" "$ref" "$HOME_DIR/ui-now.xml" 2>&1)" && { ok=1; break; }
        sleep 1
      done
      (( ok )) || die "$E_USAGE" "step $((i+1)): $res"
    elif [[ "$op" == tap ]]; then
      x="$(jq -r '.x // empty' <<<"$s")"; y="$(jq -r '.y // empty' <<<"$s")"
      [[ "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ ]] || die "$E_USAGE" "step $((i+1)): a tap needs a ref or x and y"
      _dump "$HOME_DIR/ui-now.xml"
      res="$(python3 "$UI" at "$HOME_DIR/ui-now.xml" "$x" "$y")"
    fi
    if [[ -n "$res" ]]; then
      x="$(jq -r .x <<<"$res")"; y="$(jq -r .y <<<"$res")"; lbl="$(jq -r .label <<<"$res")"
      [[ "$op" == tap && -z "$kind" ]] && kind="$(jq -r .kind <<<"$res")"
      [[ "$(jq -r .stale <<<"$res")" == true ]] && note "step $((i+1)): $ref is not on the screen any more; tapping where it was. Take a fresh snapshot if this misses."
    fi
    # A kind the preflight could not see (a tap by position, a control that changed).
    by="-"
    if [[ -n "$kind" ]]; then
      case "$(jq -r --arg k "$kind" '.[$k]' <<<"$pol")" in
        ask)
          if (( granted )); then by="approved $approved"; else
            _log "$(jq -nc --argjson i $((i+1)) --arg k "$kind" --arg l "$lbl" --arg a "$app" '{step:$i, op:"stop", kind:$k, label:$l, app:$a, allowed_by:"asked owner"}')"
            _owner_ask "$hash" "$steps" "$((i+1))" "$kind" "$lbl" "$typed" "$app"
            exit "$E_OWNER"
          fi ;;
        *) if [[ "$(jq -r --arg k "$kind" '.[$k] // ""' <<<"$(_policy_owned)")" =~ ^(allow|always)$ ]]; then by=policy; else by="default standard"; fi
           note "ALLOWED ($by): $kind, step $((i+1)) \"$lbl\" — logged" ;;
      esac
    fi
    case "$op" in
      tap)  _adb shell input tap "$x" "$y" >/dev/null 2>&1 || die 1 "step $((i+1)): tap failed" ;;
      type)
        if [[ -n "$x" ]]; then _adb shell input tap "$x" "$y" >/dev/null 2>&1; sleep 0.3; fi
        if [[ "$(jq -r '.clear // false' <<<"$s")" == true && -n "$res" ]]; then
          r="$(jq -r '.value | length' <<<"$res")"
          (( r > 0 )) && { _adb shell input keyevent KEYCODE_MOVE_END >/dev/null 2>&1; _adb shell input keyevent $(printf '67 %.0s' $(seq 1 $((r + 2)))) >/dev/null 2>&1; }
        fi
        _type_text "$(jq -r '.text // ""' <<<"$s")" || die 1 "step $((i+1)): typing failed" ;;
      clear)
        _adb shell input tap "$x" "$y" >/dev/null 2>&1; sleep 0.3
        r="$(jq -r '.value | length' <<<"$res")"
        _adb shell input keyevent KEYCODE_MOVE_END >/dev/null 2>&1
        (( r > 0 )) && _adb shell input keyevent $(printf '67 %.0s' $(seq 1 $((r + 2)))) >/dev/null 2>&1 ;;
      key)
        r="$(_keycode "$(jq -r '.key // ""' <<<"$s")")" || die "$E_USAGE" "step $((i+1)): unknown key (back, home, enter, recents, delete, tab, search, up/down/left/right or a keycode)"
        _adb shell input keyevent "$r" >/dev/null 2>&1 ;;
      scroll)
        local cx=$((W / 2)) cy=$((H / 2))
        case "$(jq -r '.dir // "down"' <<<"$s")" in
          down)  _adb shell input swipe "$cx" $((H * 3 / 4)) "$cx" $((H / 4)) 350 ;;
          up)    _adb shell input swipe "$cx" $((H / 4)) "$cx" $((H * 3 / 4)) 350 ;;
          left)  _adb shell input swipe $((W / 4)) "$cy" $((W * 3 / 4)) "$cy" 300 ;;
          right) _adb shell input swipe $((W * 3 / 4)) "$cy" $((W / 4)) "$cy" 300 ;;
          *) die "$E_USAGE" "step $((i+1)): scroll dir is down, up, left or right" ;;
        esac >/dev/null 2>&1 ;;
      swipe)
        local c; c="$(jq -r '[.x1,.y1,.x2,.y2,(.ms // 300)] | map(tostring) | join(" ")' <<<"$s")"
        [[ "$c" =~ ^[0-9]+\ [0-9]+\ [0-9]+\ [0-9]+\ [0-9]+$ ]] || die "$E_USAGE" "step $((i+1)): swipe needs x1 y1 x2 y2"
        _adb shell input swipe $c >/dev/null 2>&1 ;;
      open)
        local pkg url; pkg="$(jq -r '.app // ""' <<<"$s")"; url="$(jq -r '.url // ""' <<<"$s")"
        if [[ -n "$url" ]]; then
          [[ "$url" =~ ^[a-z][a-z0-9+.-]*:[^\ \'\"]+$ ]] || die "$E_USAGE" "step $((i+1)): not a link: $url"
          _adb shell am start -a android.intent.action.VIEW -d "'$url'" >/dev/null 2>&1 || die 1 "step $((i+1)): nothing on the phone opens $url"
        else
          [[ "$pkg" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+$ ]] || die "$E_USAGE" "step $((i+1)): open needs \"app\" (a package name: 5dive phone apps) or \"url\""
          local comp; comp="$(_adb shell cmd package resolve-activity --brief -c android.intent.category.LAUNCHER "$pkg" 2>/dev/null | tr -d '\r' | tail -1)"
          [[ "$comp" == "$pkg"/* ]] || die 1 "step $((i+1)): $pkg is not installed or has no launcher screen (5dive phone apps)"
          _adb shell am start -n "$comp" >/dev/null 2>&1 || die 1 "step $((i+1)): $pkg did not open"
        fi
        sleep "${FIVEDIVE_PHONE_OPEN_WAIT:-2}"; app="$(_current_app)" ;;
      wait)
        r="$(jq -r '.ms // 1000' <<<"$s")"; [[ "$r" =~ ^[0-9]+$ ]] || r=1000; (( r > 30000 )) && r=30000
        sleep "$(awk -v m="$r" 'BEGIN{printf "%.3f", m/1000}')" ;;
      *) die "$E_USAGE" "step $((i+1)): unknown op \"$op\" (open, tap, type, clear, key, scroll, swipe, wait)" ;;
    esac
    _log "$(jq -nc --argjson i $((i+1)) --arg op "$op" --arg l "$lbl" --arg k "$kind" --arg a "$app" --arg by "$by" \
      --argjson s "$s" '{step:$i, op:$op, label:$l, kind:$k, app:$a, allowed_by:$by}
        + (if $op == "type" then {text:($s.text // "")} elif $op == "open" then {target:($s.app // $s.url)} elif $op == "key" then {key:$s.key} else {} end)')"
    sleep "${FIVEDIVE_PHONE_STEP_GAP:-0.4}"
  done
  (( granted )) && _grant_spend "$approved"

  # The screen the steps left, as a snapshot, so the next call starts from it.
  local out
  local tries=1; [[ -n "$expect" ]] && tries=4
  for (( i = 0; i < tries; i++ )); do
    _dump "$HOME_DIR/ui.xml"
    out="$(python3 "$UI" snapshot "$HOME_DIR/ui.xml" "$HOME_DIR/refs.json")"
    [[ -z "$expect" ]] && break
    grep -qE -- "$expect" <<<"$out" && break
    sleep 0.8
  done
  printf '%s\n' "$out"
  if [[ -n "$expect" ]] && ! grep -qE -- "$expect" <<<"$out"; then
    note "--expect=$expect: not on the screen the steps left"; exit 1
  fi
}

# ---------- dispatch ----------
args=()
for a in "$@"; do [[ "$a" == --json ]] && JSON=1 || args+=("$a"); done
set -- "${args[@]+"${args[@]}"}"
verb="${1:-}"; shift || true
case "$verb" in
  ""|-h|--help|help) usage ;;
  guide) cmd_guide ;;
  setup) cmd_setup "$@" ;;
  connect) cmd_connect "$@" ;;
  status) cmd_status "$@" ;;
  apps) cmd_apps "$@" ;;
  snapshot) cmd_snapshot "$@" ;;
  act) cmd_act "$@" ;;
  screenshot) cmd_screenshot "$@" ;;
  log) cmd_log "$@" ;;
  approvals) cmd_approvals "$@" ;;
  approve) die "$E_USAGE" "a phone ask is answered like a browser one: sudo 5dive browser approve ${1:-<id>} (or the Approve button the owner was sent)" ;;
  disconnect) cmd_disconnect ;;
  *) die "$E_USAGE" "unknown command: $verb (5dive phone --help)" ;;
esac
