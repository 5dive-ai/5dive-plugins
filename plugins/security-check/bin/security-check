#!/usr/bin/env bash
# security-check — runs the seccheck engine shipped beside this plugin (DIVE-8897).
#
# Stage 1 is driven by the 5dive control plane, which uploads `seccheck` and a
# scope.json to the owner's box and runs it there directly; this launcher only
# exists so the plugin has the bin/<name> every plugin dir in this repo ships.
# Targets come only from the --scope file: nothing here adds one.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for c in "$here/seccheck" "$here/../engine/seccheck" "$(command -v seccheck || true)"; do
  if [[ -n "$c" && -x "$c" ]]; then exec "$c" "$@"; fi
done
echo "security-check: the seccheck binary is not installed" >&2
exit 1
