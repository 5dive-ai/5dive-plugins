#!/usr/bin/env node
'use strict';
// 5dive browser — the SESSION DAEMON (DIVE-4621, scope (a) of DIVE-4588).
//
// WHAT IT IS. One long-lived process per seat+site that holds
// `launchPersistentContext(<the seat's 0700 profile>, {headless:false})` open on
// the site's Xvfb display, and answers requests over a UNIX SOCKET inside that
// same 0700 directory. `serve` starts it; `run` and `tree` attach to it instead
// of stopping the browser, launching their own, and starting it again.
//
// WHY IT EXISTS, in one number: every `run` today pays four Chrome launches —
// stop the served one, start a probe, start the driver's, start the served one
// again — for an action that is three clicks. The profile is the durable thing;
// the LAUNCH is the cost. Holding one context is what removes it.
//
// ---- THE SOCKET IS THE AGENT FACE, AND IT IS NEVER A TCP PORT ---------------
//
// There is no --remote-debugging-port here and there never can be: a loopback
// debug port is reachable by EVERY SEAT on the box and CDP is full control of the
// browser holding the session, so it would hand the session to a seat that could
// never open the 0700 profile directory, and the 0700 mode would be decorative
// (community/wiki/a-loopback-debug-port-makes-a-0700-profile-decorative.md).
// The daemon holds the CDP pipe — fds 3/4 of its own Chrome child, unreachable by
// anyone else — and exposes a unix socket created under umask 077 inside the
// profile directory. File permissions are the whole access control, which is the
// same claim the profile itself makes, rather than a second weaker one.
// launchArgs() refuses any --remote-debugging-* argument so an env var or a later
// edit cannot reintroduce the port.
//
// ---- THE LEASE IS RE-READ BEFORE EVERY STEP, BY THE DAEMON ------------------
//
// A one-shot driver could read the lease out of its own environment: it was
// handed one token and died with it. A daemon outlives every caller and serves
// callers that hold DIFFERENT tokens, so the token travels IN THE REQUEST and is
// re-read from the named file before each step — `_lease_take` writes the file,
// the daemon never trusts a token it was handed once. That is the property
// DIVE-4588 established (a lease checked once protects only the first keystroke)
// carried across a process that no longer ends when the action does.
//
// ---- IT IS NOT A PROGRAM HOST ----------------------------------------------
//
// Same fixed step vocabulary as bin/driver-playwright, re-validated here. A
// socket that accepted arbitrary instructions would be a remote shell into a
// browser holding a human's live session.

const fs = require('fs');
const net = require('net');
const path = require('path');
const cp = require('child_process');
const aria = require(path.join(__dirname, '..', 'lib', 'aria.cjs'));
const point = require(path.join(__dirname, '..', 'lib', 'point.cjs'));   // DIVE-8241
// DIVE-4951: the seat's own proxy — the same parser the cold driver uses, so the
// served browser and a cold run cannot leave through two different routes.
const proxy = require(path.join(__dirname, '..', 'lib', 'proxy.cjs'));
const totp = require(path.join(__dirname, '..', 'lib', 'totp.cjs'));
// DIVE-6844: never type a saved login on a page outside its own site.
function savedHostCheck(page, s) {
  if (s.host && !totp.hostAllowed(page.url(), s.host)) {
    throw new Error(`this saved login is for ${s.host}, and the page is not on it (${(() => { try { return new URL(page.url()).host; } catch { return 'unknown'; } })()}); nothing was typed`);
  }
}
const downloads = require(path.join(__dirname, '..', 'lib', 'downloads.cjs'));
const gsignin = require(path.join(__dirname, '..', 'lib', 'google-signin.cjs'));
const popup = require(path.join(__dirname, '..', 'lib', 'popup.cjs'));
const frontTab = require(path.join(__dirname, '..', 'lib', 'front-tab.cjs'));
const cleanExit = require(path.join(__dirname, '..', 'lib', 'clean-exit.cjs'));
const sessionKeep = require(path.join(__dirname, '..', 'lib', 'session-keep.cjs'));
// What each tab looked like when the agent last saw it, so an act can answer with
// what changed instead of the whole page (DIVE-6795, lib/look.cjs).
const look = require(path.join(__dirname, '..', 'lib', 'look.cjs'));
const pageLoad = require(path.join(__dirname, '..', 'lib', 'page-load.cjs'));
const looks = look.memory();

// THE PAGE TEXT IS EXTRACTED HERE, WARM (DIVE-6778). The CLI derived page.md with a
// fresh `node lib/extract.bundle.cjs` per page: a 3 MB load and a cold JIT on every
// snapshot, act and read, 1.4 s where this long-lived process takes 0.75 s
// (Wikipedia; twice that on the bench's busy 2 cores). The CLI sends the sha256 of
// the bundle it would run, and this process answers only when its own bundle is
// those exact bytes: a session started by another release, or a CLI pointed at
// another extractor, gets nothing back and runs its own, as before.
let extractFn = null, extractSha = '';
function extractor() {
  if (extractFn === null) {
    extractFn = false;
    try {
      const file = path.join(__dirname, '..', 'lib', 'extract.bundle.cjs');
      extractSha = require('crypto').createHash('sha256').update(fs.readFileSync(file)).digest('hex');
      globalThis.__FIVEDIVE_EXTRACT_LIB = 1;   // require the bundle as a library: no CLI run
      const m = require(file);
      if (m && typeof m.extract === 'function') extractFn = m.extract;
    } catch (e) { extractFn = false; }
  }
  return extractFn;
}
async function extractFor(req, html, url) {
  if (!req || typeof req.extract !== 'string' || typeof html !== 'string' || !html.trim() || !url) return undefined;
  const fn = extractor();
  if (!fn || req.extract !== extractSha) return undefined;
  try { return await fn(html, url); } catch (e) { return undefined; }
}

// DIVE-4587: Chrome keeps its crashpad DB under $XDG_CONFIG_HOME whatever
// --user-data-dir says, and 5dive boxes share one XDG_CONFIG_HOME across every
// seat, so the first seat to run Chrome owns it 0700 and every other seat's
// launch CHECK-fails (rc 133, no output). bin/browser unsets it too; this is the
// same belt-and-braces the driver keeps, for the same reason — the parent is not
// a process this file controls.
// DIVE-5638: bin/browser now hands Chrome a crash dir of its own (a per-launch
// 0700 dir, named twice so it can be told from the shared value). Keep that one.
if (!process.env.FIVEDIVE_BROWSER_CHROME_CONFIG ||
    process.env.XDG_CONFIG_HOME !== process.env.FIVEDIVE_BROWSER_CHROME_CONFIG) {
  delete process.env.XDG_CONFIG_HOME;
}

const PROG = '5dive browser daemon';
const E_NOTHING_RAN = 70, E_FAILED = 1, E_UNAVAILABLE = 69, E_PERM = 77;
// 74 (DIVE-7528): input mode only, never a bin/browser exit. The page is the
// site's own error page (adapter probe.refused_when_title_matches). bin/browser
// turns it into a stop (75) whose advice is NOT a handoff.
const E_SITE_REFUSED = 74;
// 76 (DIVE-7572): input mode, a typed address that never finished loading (its
// title stayed the address). bin/browser's E_NOT_READY: the fix is to wait.
const E_NOT_LOADED = 76;

// ---- WHO IS ASKING (DIVE-4664 scope (c)) -----------------------------------
//
// The socket used to sit inside the 0700 profile, so "who is asking" had exactly
// one answer and nobody had to ask. In the rendezvous it is reachable by every
// agent seat on the box, and the profile's OWNER is then the holder of every
// lease and the subject of every log line whoever called — which is what
// DIVE-4662's hand test read back: under a sudo broker the holder said `claude`
// for a request `agent-tesy` had made. A log whose subject is a constant is not
// a log.
//
// SO_PEERCRED IS THE KERNEL'S ANSWER, not the caller's. It is read off the
// accepted connection, so a request cannot claim to be a seat it is not —
// there is no field for it to lie in. Node has no binding for getsockopt, so
// the read is a three-line python3 on the connection's own fd; python3 is
// stdlib-only here and present on every box this ships to. Where it is NOT
// available, bin/browser never opens a rendezvous socket in the first place
// (_peercred_ok), so the daemon keeps the old one-seat 0700 socket and this
// path is never reached — the broker is what is lost, never the attribution.
const PEERCRED_PY = 'import socket,struct,sys\n' +
  's=socket.socket(fileno=0)\n' +
  'sys.stdout.write("%d %d %d" % struct.unpack("3i", s.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))))\n';

function peerOf(conn) {
  const fd = conn && conn._handle && typeof conn._handle.fd === 'number' ? conn._handle.fd : -1;
  if (fd < 0) return null;
  let r;
  try { r = cp.spawnSync('python3', ['-c', PEERCRED_PY], { stdio: [fd, 'pipe', 'ignore'] }); }
  catch (e) { return null; }
  if (!r || r.status !== 0 || !r.stdout) return null;
  const m = String(r.stdout).trim().match(/^(\d+) (\d+) (\d+)$/);
  if (!m) return null;
  return { pid: Number(m[1]), uid: Number(m[2]), gid: Number(m[3]) };
}

// uid -> the seat's name. /etc/passwd rather than `getent`: one file read beats
// a process spawn on a path that runs per request, and a 5dive seat is a local
// user by construction (bin/browser refuses a profile whose owner is not one).
function seatOfUid(uid) {
  let txt;
  try { txt = fs.readFileSync('/etc/passwd', 'utf8'); } catch (e) { return null; }
  for (const line of txt.split('\n')) {
    const f = line.split(':');
    if (f.length > 2 && Number(f[2]) === uid) return f[0];
  }
  return null;
}

const STEPS = {
  goto:     ['url'],
  fill:     ['selector', 'value'],
  type:     ['selector', 'value'],
  click:    ['selector'],
  wait_for: ['selector'],
  select:   ['selector', 'value'],
  upload:   ['selector', 'path'],
  press:    ['selector', 'key'],
};
const STEP_TIMEOUT = Number(process.env.FIVEDIVE_BROWSER_STEP_TIMEOUT || 30000);
// AN AGENT'S STEP GIVES UP SOONER THAN A RECIPE'S (DIVE-6778). `act` sends
// step_ms (10 s by default): its steps are the agent's guesses, and a wait_for
// for text that never shows, or a click on a covered element, waited the whole
// 30 s and failed anyway (bench: 40 s acts against 3-4 s for a rival's click).
// A goto keeps the page-load bound; `run`'s reviewed recipes send none.
const stepLimit = (req) => {
  const n = Number(req && req.step_ms);
  return Number.isInteger(n) && n > 0 && n < STEP_TIMEOUT ? n : STEP_TIMEOUT;
};
// How long a request waits for the one in flight before it is refused (DIVE-4927).
const BUSY_WAIT_MS = Number(process.env.FIVEDIVE_BROWSER_BUSY_WAIT_MS || 60000);
// How long an input-mode `front` waits for a request in flight to end before it
// gives up rather than type into it (DIVE-7674). Inside bin/browser's
// VIEWER_FRONT_S, with room left for the keys.
const FRONT_IDLE_WAIT_MS = Number(process.env.FIVEDIVE_BROWSER_FRONT_IDLE_WAIT_MS || 2000);

// THE LEASE ANCHOR MUST BE THE CALLER'S OWN PROCESS (DIVE-4927). A brokered
// lease is held for as long as its anchor pid lives, and the caller names that
// pid — so the kernel has to agree it is the connected seat's, or a caller could
// anchor its lease to any long-lived process on the box and hold the browser
// until the TTL. The real uid is read out of /proc, not taken from the request.
function anchorOf(req, who) {
  const a = Number(req.anchor);
  if (!Number.isInteger(a) || a <= 0) return '';
  let st;
  try { st = fs.readFileSync(`/proc/${a}/status`, 'utf8'); } catch (e) { return null; }
  const m = st.match(/^Uid:\s+(\d+)/m);
  return m && Number(m[1]) === who.uid ? String(a) : null;
}

// THE SETTLE `run` DID NOT HAVE (DIVE-4674). `tree` and `snapshot` wait after
// domcontentloaded because a live page is still assembling itself there; `run`
// went from `goto` straight to the next step, so the very refs `tree` printed at
// a settle were resolved by `run` about fifty milliseconds after DCL and missed.
// Same knob, same bound, same reason it is NEVER `waitUntil: 'networkidle'` — a
// web app that long-polls never idles, and waiting for it is what made a `read`
// hang for 150s on a real box.
//
// A FLOOR, NOT A FIX. The settle is how long the page is given before anyone
// looks; a genuinely late element is `wait_for`'s job, which now actually waits.
const RUN_SETTLE_MS = Number(
  process.env.FIVEDIVE_BROWSER_RUN_SETTLE_MS
  || process.env.FIVEDIVE_BROWSER_TREE_SETTLE_MS
  || 1200);

// THE WARM PATH HAS TO TAKE THE FLAG TOO (DIVE-4674). The daemon is a long-lived
// process started before the caller typed anything, so an env var set on THIS
// invocation of bin/browser cannot reach it — which is why `snapshot --settle`
// was silently dropped on a served profile while working cold. The knob travels
// in the request instead, and a request that does not carry one falls back to the
// daemon's own environment, exactly as before.
const settleOf = (req, fallback) => {
  const n = Number(req && req.settle);
  return Number.isFinite(n) && n >= 0 ? n : fallback;
};
const TREE_SETTLE_MS = Number(process.env.FIVEDIVE_BROWSER_TREE_SETTLE_MS || 1200);
// ONE PAGE OF A `read` GETS 40 s, WHATEVER IT DOES (DIVE-6778). page.title() and
// page.content() run inside the page and take no timeout, so a tab whose script
// never yields held a bench read of two stores.bestbuy.com pages for over seven
// minutes; every call behind it was refused as busy and the job timed out.
const FAILED_SETTLE_MS = aria.FAILED_SETTLE_MS;
// The re-read of a page that came into view, or moved, while the report was being
// read (DIVE-7680): it has loaded its first document already, so a short settle.
const POPUP_REREAD_SETTLE_MS = Number(process.env.FIVEDIVE_BROWSER_POPUP_REREAD_SETTLE_MS) || 300;
const READ_PAGE_MS = Number(process.env.FIVEDIVE_BROWSER_READ_PAGE_MS || 40000);
const within = (ms, p, what) => {
  let timer;
  return Promise.race([p, new Promise((_, no) => { timer = setTimeout(() => no(new Error(what)), ms); })])
    .finally(() => clearTimeout(timer));
};

// HOW LONG A PROBE MAY WAIT FOR THE PAGE TO SAY WHICH STATE IT IS IN
// (DIVE-4794). Spent only while NOTHING is known — the loop returns the instant
// any marker matches — so an adapter that answers at DCL pays nothing for it.
const PROBE_WAIT_MS = Number(process.env.FIVEDIVE_BROWSER_PROBE_WAIT_MS || 8000);
// ONE WALL CLOCK FOR THE WHOLE PROBE (DIVE-7648). The steps inside a probe each
// had their own limit or none (newPage none, goto 20 s, content() none, close
// none), and `busy` is freed only when the request returns. On exact-swallow
// (report 680, 2026-11-03) one probe of a signed-in Shopify admin held its
// group's session for 230-380 s, and google.com and cjdropshipping.com in that
// group were refused as busy the whole time. Past this the probe answers, its
// tab is closed without waiting, and the session is free; whatever the tab was
// still doing is abandoned. Under the 38 s the cold probe's cap allows.
const PROBE_HARD_MS = Number(process.env.FIVEDIVE_BROWSER_PROBE_HARD_MS || 35000);
// How long a page that is still navigating gets to reach its next DOM, per look.
const NAV_SETTLE_MS = Number(process.env.FIVEDIVE_BROWSER_NAV_SETTLE_MS || 5000);

function die(code, msg) { process.stderr.write(`${PROG}: ${msg}\n`); process.exit(code); }

// THE SANDBOX IS ON (DIVE-4944). This daemon's Chrome is the one a PERSON looks at
// through the viewer, and it holds a logged-in session while it loads pages from
// the open web. It launched with --no-sandbox from DIVE-4621 on, which (1) turned
// off Chrome's renderer sandbox for exactly the browser that most needs it and
// (2) painted "You are using an unsupported command-line flag: --no-sandbox" across
// the top of every customer's viewer (lodar, old-clay, 2026-09-24). The cold
// serve path never passed the flag and ran sandboxed on the same boxes, so the
// sandbox works wherever serve already did. Two cases still launch without it:
// root, where Chrome refuses to start sandboxed at all, and a launch that fails
// sandboxed (serve retries once and says why, rather than losing the session).
function sandboxWanted() {
  if (process.env.FIVEDIVE_BROWSER_NO_SANDBOX === '1') return false;
  return !(typeof process.getuid === 'function' && process.getuid() === 0);
}

// Identical to the driver's, and deliberately a second literal copy rather than a
// shared import: the refusal is a security claim, and a claim that lives in one
// place is a claim one edit can remove from both callers at once.
function launchArgs(sandbox) {
  const extra = (process.env.FIVEDIVE_BROWSER_CHROME_ARGS || '').split(/\s+/).filter(Boolean);
  // DIVE-7204: no "Restore pages?" bubble after a serve that was stopped, not closed.
  const args = [...(sandbox ? [] : ['--no-sandbox']), '--disable-gpu', '--hide-crash-restore-bubble',
    ...aria.unmarkedArgs(extra), ...extra];
  const bad = args.filter(a => /^--remote-debugging/.test(a));
  if (bad.length) {
    die(E_NOTHING_RAN, `refusing to launch with ${bad.join(' ')}. The daemon holds CDP over the child's ` +
      `fds 3/4 and opens no listening socket; a debug PORT is reachable by every seat on this box and ` +
      `CDP is full control of the browser holding the session.`);
  }
  return args;
}

function playwrightDirs() {
  const named = (process.env.NODE_PATH || '').split(path.delimiter).filter(Boolean);
  return [...named, path.join(__dirname, '..', 'node_modules')];
}
function loadPlaywright() {
  for (const dir of playwrightDirs()) {
    const cand = path.join(dir, 'playwright-core');
    if (!fs.existsSync(cand)) continue;
    try { return require(cand); }
    catch (e) { die(E_UNAVAILABLE, `playwright-core at ${cand} could not be loaded: ${e.message}`); }
  }
  die(E_UNAVAILABLE, `playwright-core is not installed for this seat, so there is no session daemon. ` +
    `Install the pinned version next to the plugin:  npm install --prefix ${__dirname}/..  ` +
    `Without it \`serve\` still starts a browser for the viewer, and every command pays a cold launch.`);
}

// {key} -> args.key, as a VALUE. Same refusal as the driver's: a fill that posts
// the literal "{body}" has published garbage to a real account, and the
// out-of-band verify cannot tell you it was garbage — the artifact really is live.
// `enc` (DIVE-4984): a value going into a URL is encoded, as in the driver.
function interpOrThrow(s, args, where, enc) {
  if (typeof s !== 'string') return s;
  const out = s.replace(/\{([a-zA-Z0-9_]+)\}/g, (m, k) =>
    Object.prototype.hasOwnProperty.call(args, k) ? (enc ? enc(String(args[k])) : args[k]) : m);
  const left = out.match(/\{[a-zA-Z0-9_]+\}/);
  if (left) {
    const e = new Error(`${where} still contains ${left[0]} — no --${left[0].slice(1, -1)}=<value> was passed. ` +
      `Refusing rather than typing the placeholder into the page.`);
    e.nothingRan = true;
    throw e;
  }
  return out;
}

// ---- the lease, re-read from disk before every step -------------------------
function leaseLost(req) {
  if (!req.lease || !req.token) return null;      // no lease was handed down
  let txt;
  try { txt = fs.readFileSync(req.lease, 'utf8'); } catch (e) { return 'gone'; }
  const m = txt.match(/^token=(.*)$/m);
  return m && m[1] === req.token ? null : 'taken';
}
function assertLease(req, where) {
  const lost = leaseLost(req);
  if (!lost) return;
  const why = lost === 'gone'
    ? 'the lease on this browser was released or reaped while this run was in progress'
    : 'the lease on this browser was TAKEN by someone else — a person redeeming a viewer preempts an agent';
  const e = new Error(`${where}: refusing to continue — ${why}. Stopping here rather than typing into a ` +
    `session somebody else is using. Whatever steps already ran are still real: bin/browser re-reads the ` +
    `artifact out of band and that re-read, not this message, is the verdict.`);
  throw e;
}

// ---------------------------------------------------------------- serve mode
async function serveMode(profile, sock, broker, input) {
  if (!profile || !fs.existsSync(profile)) die(E_UNAVAILABLE, `no profile directory at ${profile}`);
  const site = path.basename(profile);
  const selfBrowser = path.join(__dirname, 'browser');
  const ownUid = process.getuid();

  // THE BROKER REFUSES A CALLER IT CANNOT NAME. This socket is group-reachable,
  // so the file mode has stopped being the whole access control and the
  // attribution IS the rest of it. Failing open here would give an anonymous
  // seat a live logged-in session and an audit trail that says `claude` did it.
  const callerOf = (conn) => {
    if (!broker) return { seat: null, uid: ownUid };
    const p = peerOf(conn);
    if (!p) return null;
    return { seat: seatOfUid(p.uid), uid: p.uid, pid: p.pid };
  };

  // Every request the broker serves leaves a row naming the CALLER, written by
  // re-entering bin/browser as the owner — one lease implementation and one
  // audit format, rather than a second copy here that nothing exercises.
  const brokerCall = (args, behalf) => {
    const env = Object.assign({}, process.env);
    if (behalf) env.FIVEDIVE_BROWSER_ON_BEHALF_OF = behalf;
    return cp.spawnSync(selfBrowser, args, { env, encoding: 'utf8' });
  };
  const chrome = process.env.FIVEDIVE_BROWSER_CHROME;
  if (!chrome) die(E_UNAVAILABLE, 'no chrome named for this daemon — a session must be held in the same ' +
    'browser the profile was logged in with, so the executable is passed in rather than guessed here.');

  // DIVE-7204: the last serve was stopped, not closed; say it closed cleanly so
  // the window opens with no "Restore pages?" bubble (lib/clean-exit.cjs).
  cleanExit.markCleanExit(profile);
  // INPUT MODE (DIVE-5287): plain Chrome, driven through the X display. No
  // Playwright, no CDP pipe, nothing on the page to detect. See inputLaunch.
  let ctx;
  if (input) {
    ctx = await inputLaunch(profile, chrome);
  } else {
  // DIVE-4951. Read ONCE, at start: a running daemon keeps the route it launched
  // with, and `proxy set`/`clear` say so rather than moving a live login's IP.
  let viaProxy;
  try { viaProxy = proxy.launchProxy(profile); } catch (e) { die(E_UNAVAILABLE, e.message); }
  // DIVE-7643: a proxy with no login is a plain --proxy-server arg (lib/proxy.cjs
  // launchRoute), so Playwright adds no flag that raises Chrome's warning bar.
  const route = proxy.launchRoute(viaProxy);
  const { chromium } = loadPlaywright();
  const launch = (sandbox) => chromium.launchPersistentContext(profile, {
    headless: false,
    executablePath: chrome,
    args: [...launchArgs(sandbox), ...route.args],
    chromiumSandbox: sandbox,
    viewport: null,
    ...route.option,
  });
  try {
    ctx = await launch(sandboxWanted());
  } catch (e) {
    if (!sandboxWanted()) die(E_UNAVAILABLE, `could not open the ${profile} profile: ${e.message}`);
    process.stderr.write(`${PROG}: NOTE — Chrome would not start with its sandbox ` +
      `(${String(e.message).split('\n')[0]}); starting it without the sandbox.\n`);
    try {
      ctx = await launch(false);
    } catch (e2) {
      die(E_UNAVAILABLE, `could not open the ${profile} profile: ${e2.message}`);
    }
  }

  // OPEN THE SITE (DIVE-4944). `serve` exists so a person can log in, and the
  // cold path it replaced launched Chrome AT the site. Playwright's persistent
  // context opens about:blank instead, so from DIVE-4621 until this line every
  // Connect showed the customer an empty page. Not awaited: `ready` must not wait
  // on a slow site, and a request that navigates the same tab first simply
  // supersedes this load. A failure is noted and the session stays up, because
  // a blank tab the person can type into beats no browser at all.
  const startUrl = process.env.FIVEDIVE_BROWSER_START_URL || '';
  if (/^https?:\/\//i.test(startUrl)) {
    Promise.resolve()
      .then(() => ctx.pages()[0] || ctx.newPage())
      .then((p) => p.goto(startUrl, { waitUntil: 'domcontentloaded' }))
      .catch((e) => process.stderr.write(`${PROG}: NOTE — could not open ${startUrl}: ` +
        `${String(e && e.message).split('\n')[0]}\n`));
  }
  }

  // THE BROWSER IS THE DAEMON'S REASON TO EXIST. When Chrome goes, the daemon
  // goes — otherwise `_daemon_live` (a live pid + a socket that accepts) would
  // read healthy while every request into it failed, which is DIVE-4400's defect
  // wearing a different hat: a surface that says yes with nothing behind it.
  // GUARDED, because the harness's recording stub is not an EventEmitter and a
  // daemon that cannot be tested is a daemon whose refusals are unmeasured. The
  // real playwright context always has it.
  //
  // NOT DURING OUR OWN SHUTDOWN (DIVE-7314 it3). Playwright emits `close` when
  // Chrome drops the CDP pipe, which is the START of its shutdown, and exiting
  // node there makes Playwright kill Chrome before it writes the profile out:
  // on CI's Chrome the stopped profile had no cookie file at all, so neither a
  // kept session login nor an ordinary lasting cookie reached the next browser.
  // A `shutdown` request sets this and waits for ctx.close() to see Chrome exit.
  let shuttingDown = false;
  if (typeof ctx.on === 'function') ctx.on('close', () => { if (shuttingDown) return; cleanup(); process.exit(0); });

  // WHAT IS IN FLIGHT, not only THAT something is: a refusal that cannot say
  // who has the browser sends the caller to a `lease --status` that reads free.
  let busy = null;
  const cleanup = () => { try { fs.unlinkSync(sock); } catch (e) { /* already gone */ } };

  const server = net.createServer((conn) => {
    // The request's bytes, searched only where they are new (DIVE-7303, as callMode):
    // an upload step carries its file, up to 16 MB, inside this one line.
    let parts = [];
    const send = (o) => { try { conn.write(JSON.stringify(o) + '\n'); } catch (e) { /* caller left */ } };
    const end = (rc) => { send({ t: 'end', rc }); try { conn.end(); } catch (e) { /* caller left */ } };
    conn.on('error', () => { /* a caller that walks away is not an error here */ });
    conn.on('data', async (d) => {
      const nl = d.indexOf(10);
      if (nl < 0) { parts.push(d); return; }
      parts.push(d.subarray(0, nl));
      const line = Buffer.concat(parts).toString('utf8');
      parts = nl + 1 < d.length ? [d.subarray(nl + 1)] : [];
      let req;
      try { req = JSON.parse(line); } catch (e) { send({ t: 'err', msg: `request is not JSON: ${e.message}` }); return end(E_NOTHING_RAN); }

      if (req.op === 'ping') { send({ t: 'out', data: 'pong\n' }); return end(0); }

      // WHO IS ASKING, BEFORE ANYTHING IS DONE FOR THEM.
      const who = callerOf(conn);
      if (!who) {
        send({ t: 'err', msg: 'this session is brokered and the kernel would not name the process on the other end of this socket, so nothing can be attributed to a seat. Refusing: an anonymous caller driving a logged-in session is the one thing the rendezvous must not allow. Nothing ran.' });
        return end(E_PERM);
      }
      // ALWAYS NAMED, even when the caller IS the owner. A field that appears
      // only for brokered callers is a field whose absence has to be
      // interpreted, and "the owner did it" is exactly the reading that was
      // wrong before. The name is the kernel's; `req` has no say in it, and a
      // request that puts an on_behalf_of of its own in the JSON is ignored
      // here on purpose — there is nowhere for a caller to sign someone else's
      // name.
      // On a brokered socket the name is ALWAYS written, even when the caller
      // IS the owner: a field that appears only for other seats is a field
      // whose absence has to be interpreted, and "the owner did it" is exactly
      // the reading that was wrong before. On the old in-profile socket there
      // is only one possible caller, so there is nothing to disambiguate and
      // bin/browser's own default (the owner) stands.
      // The name is the KERNEL'S. `req` has no say in it — a request carrying
      // an on_behalf_of of its own is ignored here on purpose, because there
      // must be nowhere for a caller to sign somebody else's name.
      const behalf = broker ? (who.seat || `uid:${who.uid}`) : null;

      // SHUTDOWN IS THE OWNER'S. A brokered seat stopping the box's browser
      // would take the session out from under every other seat AND from under
      // whoever is at the viewer — `serve --stop` is the owner's verb and this
      // is the socket-shaped door into it.
      if (req.op === 'shutdown') {
        if (broker && who.uid !== ownUid) {
          send({ t: 'err', msg: `stopping this session is the owning seat's act: it is the box's login and other seats are using it. Nothing was stopped.` });
          return end(E_PERM);
        }
        // A swap (bin/browser's own stop-and-start) keeps the session-only
        // logins (DIVE-7314, lib/session-keep.cjs). Input mode has no cookie
        // API; bin/browser's file rewrite is that mode's only keep.
        let kept = 0;
        if (req.keep_session && typeof ctx.cookies === 'function') {
          // DIVE-8367: a person's window is kept longer (keep_s, at most 30 days).
          const ks = Number.isInteger(req.keep_s) && req.keep_s > 0 && req.keep_s <= 2592000 ? req.keep_s : undefined;
          try { kept = await sessionKeep.keepSessionCookies(ctx, ks); } catch (e) { /* a stop must not fail on this */ }
          send({ t: 'out', data: `kept=${kept}\n` });
        }
        shuttingDown = true;
        end(0); cleanup(); try { await ctx.close(); } catch (e) { /* going anyway */ } process.exit(0);
      }

      // THE LEASE, FOR A CALLER THAT CANNOT WRITE IN THE PROFILE (scope (a)).
      // It is not re-implemented here: bin/browser owns the lease and the daemon
      // re-enters it as the profile's owner, carrying the caller's name.
      if (req.op === 'lease') {
        const act = req.act;
        if (!['acquire', 'release', 'status'].includes(act)) {
          send({ t: 'err', msg: `lease act must be acquire, release or status; got '${act}'` });
          return end(E_NOTHING_RAN);
        }
        const anchor = act === 'acquire' ? anchorOf(req, who) : '';
        if (anchor === null) {
          send({ t: 'err', msg: `the lease anchor ${req.anchor} is not a process of the calling seat, so it cannot hold this browser. Nothing was taken.` });
          return end(E_PERM);
        }
        const r = brokerCall(['_broker-lease', site, act,
          String(req.purpose || 'brokered'), String(req.ttl || ''), String(req.token || ''), anchor], behalf);
        if (r.stderr) send({ t: 'err', msg: String(r.stderr).trim() });
        if (r.stdout) send({ t: 'out', data: String(r.stdout) });
        return end(r.status === null ? E_UNAVAILABLE : r.status);
      }

      // THE HANDOFF AND THE TITLE ARE ANSWERED AT ONCE (DIVE-5287). Neither
      // touches the page: `hand` flips who may drive, `title` reads the window
      // name. A person being called in must not queue behind the very run that
      // is calling them, and `handoff --wait` polls `hand status` for minutes.
      if (input && (req.op === 'hand' || req.op === 'title')) {
        try { await inputRequest(ctx, profile, req, send, end, behalf); }
        catch (e) { send({ t: 'err', msg: e && e.message ? e.message : String(e) }); end(E_FAILED); }
        return;
      }

      // THE SITE'S TAB IN FRONT, AT ONCE (DIVE-7257). A person is being shown
      // this window for one site; the viewer must not queue behind a run, and
      // bringing a tab forward reads and loads nothing the lease protects.
      // In input mode it presses keys (DIVE-7674), so it never types into a
      // request in flight: it waits a moment for one to end, and holds the
      // window while it types.
      if (req.op === 'front') {
        let held = false;
        try {
          if (input) {
            const until = Date.now() + FRONT_IDLE_WAIT_MS;
            while (busy && Date.now() < until) await new Promise((r) => setTimeout(r, 50));
            if (!busy) { busy = { op: 'front', seat: behalf, since: Date.now() }; held = true; }
          }
          await frontRequest(ctx, input, req, send, end, input && !held);
        }
        catch (e) { send({ t: 'err', msg: e && e.message ? e.message : String(e) }); end(E_FAILED); }
        finally { if (held) busy = null; }
        return;
      }

      // ONE REQUEST AT A TIME — AND A SHORT WAIT, THEN A REFUSAL (DIVE-4927).
      // This used to refuse on the spot, on the theory that the lease already
      // serialises callers so a second request mid-run must be one that skipped
      // it. That theory is false: `status` probes WITHOUT the lease (it only
      // looks, in its own tab), and a leased caller's request landing inside one
      // was refused and told it "did not hold" a lease it did hold — measured on
      // a box, twice, from a second seat, while `lease --status` read free.
      // Waiting is safe because the lease is not enforced HERE: every acting op
      // re-reads the lease file before each step (assertLease), so a request
      // that waited behind somebody else's still refuses if the lease moved.
      // Bounded, and a refusal after the bound says what is in flight.
      if (busy) {
        const until = Date.now() + BUSY_WAIT_MS;
        while (busy && Date.now() < until) await new Promise((r) => setTimeout(r, 50));
      }
      if (busy) {
        const secs = Math.round((Date.now() - busy.since) / 1000);
        send({ t: 'err', msg: `this session is still busy with a '${busy.op}' request from ${busy.seat || 'the owner'}, running for ${secs}s; waited ${Math.round(BUSY_WAIT_MS / 1000)}s for it. Nothing ran.` });
        return end(E_NOTHING_RAN);
      }
      busy = { op: String(req.op), seat: behalf, since: Date.now() };
      try {
        if (behalf) brokerCall(['_broker-audit', site, req.op, String(req.url || '')], behalf);
        if (input) await inputRequest(ctx, profile, req, send, end, behalf);
        else if (req.op === 'probe') await probeRequest(ctx, req, send, end);
        else if (req.op === 'tree') await treeRequest(ctx, req, send, end);
        else if (req.op === 'snapshot') await snapshotRequest(ctx, req, send, end);
        else if (req.op === 'render') await renderRequest(ctx, req, send, end);
        else if (req.op === 'read') await readRequest(ctx, req, send, end);
        else if (req.op === 'plan') await planRequest(ctx, req, send, end);
        else if (req.op === 'totp') await totpRequest(ctx, profile, req, send, end);
        else if (req.op === 'download') await downloadRequest(ctx, req, send, end);
        else { send({ t: 'err', msg: `unknown op '${req.op}'` }); end(E_NOTHING_RAN); }
      } catch (e) {
        send({ t: 'err', msg: e && e.message ? e.message : String(e) });
        end(E_FAILED);
      } finally { busy = null; }
    });
  });

  // THE SOCKET IS CREATED UNDER umask 077, INSIDE THE 0700 PROFILE. Both, not
  // either: the directory keeps other seats out, the mode keeps the socket itself
  // from being the one thing in there that is not 0700.
  // 077 IN THE PROFILE, 007 IN THE RENDEZVOUS. In the profile the directory
  // already keeps every other seat out and the socket must not be the one thing
  // in there that is looser. In the rendezvous the GROUP is the access control —
  // a 0700 socket there would be reachable by nobody and the broker would be a
  // directory with an unusable file in it.
  const prevUmask = process.umask(broker ? 0o007 : 0o077);
  try { fs.unlinkSync(sock); } catch (e) { /* no stale socket */ }
  server.listen(sock, () => {
    process.umask(prevUmask);
    // DIVE-4400's contract, re-implemented rather than inherited: say READY only
    // when the context is open AND the socket is accepting. `serve` prints
    // success on this line and on nothing else.
    process.stdout.write(`ready sock=${sock} pid=${process.pid} broker=${broker ? 'yes' : 'no'}\n`);
  });
  server.on('error', (e) => die(E_UNAVAILABLE, `could not listen on ${sock}: ${e.message}`));
  for (const sig of ['SIGTERM', 'SIGINT', 'SIGHUP']) {
    // The same wait as `shutdown` (DIVE-7314 it3): a signalled stop lets Chrome
    // write its profile out instead of exiting on the context's close event.
    process.on(sig, async () => { shuttingDown = true; cleanup(); try { await ctx.close(); } catch (e) { /* going anyway */ } process.exit(0); });
  }
}

// THE TAB AGENTS DRIVE is the first one, until a person is shown another tab of
// this window for its site (DIVE-7257, frontRequest): from then on it is that
// one, so the person watches the tab the agent's next step acts in. It goes back
// to the first tab when that one closes.
let driven = null;
async function pageOf(ctx) {
  if (driven && (driven.isClosed() || !ctx.pages().includes(driven))) driven = null;
  const p = driven || ctx.pages()[0] || popup.mine(await ctx.newPage());
  p.setDefaultTimeout(STEP_TIMEOUT);
  return p;
}

// A SITE OF A GROUP SHOWS ITS OWN TAB (DIVE-7257). The sites of a sign-in group
// share this one window, so the viewer for bing.com showed the Google Play tab
// that was in front. Before the window is handed to a person: a tab on the
// site comes to the front (lib/front-tab.cjs picks it), or a new tab opens on the
// site's URL when none is on it. No other tab is navigated or closed.
//
// INPUT MODE (DIVE-7674): no automation channel lists the tabs, so the window's
// own record decides (lib/front-tab.cjs inputFront): a window last sent to
// another site gets one new tab on this site's URL, typed through the keyboard;
// a window already on this site is left as it is. It was "nothing moves" until
// report 688: Connect for business.facebook.com showed CJ's live session.
async function frontRequest(ctx, input, req, send, end, inUse) {
  const url = String(req.url || '');
  if (!/^https?:\/\/[^\s]+$/i.test(url) || url.length > 2000) {
    send({ t: 'err', msg: 'front needs the site\'s http(s) url' }); return end(E_NOTHING_RAN);
  }
  const host = frontTab.hostOf(url);
  const out = (o) => send({ t: 'out', data: JSON.stringify(o) + '\n' });
  if (input) {
    if (inUse) { out({ host, moved: false, why: 'another request is driving this window, so nothing was typed into it' }); return end(0); }
    out(await frontTab.inputFront(ctx, url, {
      sleep: sleepMs, keys: () => keysReachBrowser(ctx),
      typeUrl: (u) => gotoByKeys(ctx, u),
    }));
    return end(0);
  }
  let page = frontTab.pick(ctx.pages(), host, driven || ctx.pages()[0]);
  const opened = !page;
  if (opened) {
    page = popup.mine(await ctx.newPage());
    // Not awaited, as the start URL is not: the person must not wait on a slow
    // site, and a tab they can see loading beats a viewer that never opens.
    page.goto(url, { waitUntil: 'domcontentloaded' })
      .catch((e) => process.stderr.write(`${PROG}: NOTE — could not open ${url}: ${String(e && e.message).split('\n')[0]}\n`));
  }
  await page.bringToFront();
  driven = page;
  out({ host, moved: true, opened, tab: ctx.pages().indexOf(page) });
  return end(0);
}

// THE POPUP AN EARLIER ACT LEFT IN VIEW (DIVE-6392). This browser outlives each
// request, so the follower of the last act does too: a request on a URL of the
// popup's own site goes to the popup (an OAuth chooser is answered in the window
// it opened in, not in a second load of its URL in the main tab), and any other
// URL goes to the main tab as before. lib/popup.cjs, shared with the cold loop.
let front = null;
// The popup a read was just handed because it came after the last act (below):
// it is read where it is, never navigated to the URL the read named.
let latePopup = null;
async function pageFor(ctx, url, { read = false } = {}) {
  const base = await pageOf(ctx);
  latePopup = null;
  if (!front || front.base !== base) {
    if (front) front.stop();
    front = popup.follow(base, { stepTimeout: STEP_TIMEOUT });
  }
  // A WINDOW THAT CAME AFTER THE LAST ACT'S WAIT (DIVE-7680) is taken now, before
  // this request picks its page. Box bug 690: Supliful's Google chooser came after
  // the act's report, and the snapshot with no URL read the sign-up form under it.
  // A snapshot with no URL names the page the last act reported, which is the
  // opener: so a READ of the opener's own URL is handed the late popup, the window
  // on top of it. An act that names that URL still goes to the opener.
  if (front.waiting) {
    const before = front.page;
    front.use({ log: (l) => process.stderr.write(`${PROG}: ${l}\n`) });
    try { await front.drain(); } catch (e) { /* the page in view is read as it is */ }
    if (read && front.page !== before && url && sameUrl(base.url(), url)) latePopup = front.page;
  }
  front.use({});   // the last request's lines go nowhere now; a plan sets its own
  return latePopup || front.pageFor(url) || base;
}
// A popup still on the URL asked for is not loaded again: a reload of an OAuth
// window can lose the sign-in it is in the middle of.
function inPopup(page, url) {
  return !!front && page !== front.base && (page === latePopup || sameUrl(page.url(), url));
}

// ---- the probe, and the thing it un-breaks ---------------------------------
//
// `status` could never look at a SERVED profile. Chrome allows one instance per
// --user-data-dir, so a second launch at a held profile hands its URL to the
// running instance and exits with an empty document — which arrived as "UNKNOWN
// (probe did not load)", worst exactly when it matters, because server mode is
// how a customer logs in at all and the window right after that login is the
// window the tile most needs to read. bin/browser names that condition instead
// of lying about it, and its comment says why it could not be fixed: probing
// through the served browser needs CDP, a pipe dies with the process that opened
// it, and a debug PORT hands every seat on the box full control of a logged-in
// profile.
//
// THE DAEMON IS WHAT CHANGES THAT ARGUMENT. The pipe no longer dies with the
// command, because the process holding it outlives the command; and the face it
// exposes is a 0700 unix socket, not a port. So a served profile can be probed
// after all, by the only process that can already drive it.
//
// IN ITS OWN TAB, ALWAYS. The first page belongs to whoever is at the viewer —
// navigating it to run a background health check would yank a person's browser
// out from under them mid-login, which is the one thing every other path here
// refuses to do.
//
// ...AND A SINGLE-PAGE APP HAS NOT DECIDED ITS LOGIN STATE AT DCL+800ms
// (DIVE-4794). Telegram Web ships ONE static shell for both states — body
// carries `has-auth-pages` in the bytes the server sends — and the app removes
// it only after its own network init decides it is logged in. Dumped at the
// probe's old fixed settle, a LIVE session and a DEAD one were byte-identical
// in the fields that matter, so an adapter marker written against the shell
// stamped `expired` on a live login (measured 2026-09-21, 16:58Z) and every
// acting verb then refused. No regex can separate two identical documents; the
// missing thing was the WAIT.
//
// THE DAEMON DOES NOT CLASSIFY — IT ONLY KNOWS WHEN TO STOP WAITING. The
// markers travel in the request purely as an early exit; the verdict is still
// bin/browser's, made by grepping the document that comes back. That split is
// deliberate: two regex engines (grep -E here, JS RegExp there) must never be
// able to disagree about a LOGIN, so only one of them is allowed to decide.
// A request carrying no markers waits exactly as it did before.
const reOf = (p) => {
  if (typeof p !== 'string' || !p) return null;
  try { return new RegExp(p, 'i'); } catch (e) { return null; }  // bin/browser greps it anyway
};

// A PAGE THAT IS STILL NAVIGATING HAS NOT ANSWERED YET (DIVE-7648). Shopify's
// admin redirects admin.shopify.com/ -> /store/<id> and then routes inside the
// app; a content() that lands in one of those hops throws "Unable to retrieve
// content because the page is navigating" (or "Execution context was
// destroyed"), and the probe reported that as a page that did not load. It is
// "not yet": wait for the next DOM, bounded, and say so with null.
const NAVIGATING = /page is navigating|Execution context was destroyed/i;
async function contentOrNull(page, ms) {
  try { return await page.content(); }
  catch (e) {
    if (!NAVIGATING.test(String(e && e.message))) throw e;
    try { await page.waitForLoadState('domcontentloaded', { timeout: Math.max(1, ms) }); } catch (e2) { /* the next look decides */ }
    return null;
  }
}
// The same, for a caller that needs a document: a few looks, then the error.
async function contentSettled(page, ms) {
  const stop = Date.now() + Math.max(1, ms);
  for (;;) {
    const html = await contentOrNull(page, Math.max(1, stop - Date.now()));
    if (html !== null) return html;
    if (Date.now() >= stop) throw new Error('the page was still navigating when the wait ran out');
  }
}

async function probeRequest(ctx, req, send, end) {
  if (typeof req.url !== 'string' || !/^https?:\/\//.test(req.url)) {
    send({ t: 'err', msg: 'probe needs an http(s) url to load' }); return end(E_NOTHING_RAN);
  }
  const settle = Number(process.env.FIVEDIVE_BROWSER_PROBE_SETTLE_MS || 800);
  const until = (req.until && typeof req.until === 'object') ? req.until : {};
  const positive = reOf(until.logged_in);
  // WHERE THE PAGE LANDED CAN END THE WAIT TOO (DIVE-7648): an adapter may name
  // the address a signed-in session lands on. Like the markers, only an early
  // exit — bin/browser makes the verdict from the final URL it is told.
  const landed = reOf(until.logged_in_url);
  const marks = [reOf(until.challenge), reOf(until.logged_out), positive].filter(Boolean);
  // THE POSITIVE MARKER IS WHAT MAKES A WAIT TERMINATE, so it is also what
  // permits one. Every request carries a challenge marker (bin/browser has a
  // built-in default for it), so keying the wait on "any marker" would make
  // every probe on the box pay up to eight seconds to reach the answer it
  // already had — including the server-rendered adapters that classify on the
  // absence of a login form. Without a logged-in marker this is the old single
  // settle to the millisecond.
  const hardMs = Number(req.hard) > 0 ? Math.min(Number(req.hard), PROBE_HARD_MS) : PROBE_HARD_MS;
  const t0 = Date.now();
  const left = () => hardMs - (Date.now() - t0);
  const deadline = (positive || landed)
    ? Math.max(settle, Number(req.wait) > 0 ? Number(req.wait) : PROBE_WAIT_MS)
    : settle;
  const step = Math.min(Number(process.env.FIVEDIVE_BROWSER_PROBE_POLL_MS || 400), Math.max(1, deadline));
  let page, over = false;
  const urlNow = () => { try { return page.url(); } catch (e) { return ''; } };
  const said = (html) => (html !== null && marks.some(r => r.test(html))) || (!!landed && landed.test(urlNow()));
  const work = (async () => {
    page = popup.mine(await ctx.newPage());
    if (over) return null;
    page.setDefaultTimeout(Math.max(1, Math.min(Number(process.env.FIVEDIVE_BROWSER_PROBE_TIMEOUT || 20000), left())));
    // A REDIRECT THAT INTERRUPTS THE LOAD IS THE LOAD (DIVE-6795's goTo), which
    // the admin's own hop to /store/<id> can do.
    await goTo(page, req.url);
    // THE WHOLE DOCUMENT, uncapped, like the cold probe: a challenge banner is
    // as likely to be late in a large DOM as early, and a truncating capture
    // cannot see a marker past the cap. bin/browser greps what comes back.
    await page.waitForTimeout(settle);
    let html = await contentOrNull(page, Math.min(NAV_SETTLE_MS, left()));
    let waited = settle;
    // NEVER `networkidle`: a web app that long-polls never idles, and waiting
    // for it is what made a `read` hang for 150s on a real box. The evidence
    // itself is the signal instead — the first document in which the page has
    // said something about its login state is the one we answer with. A look
    // that met a navigation (null) is a look that said nothing yet.
    while (!over && waited < deadline && (html === null || !said(html))) {
      if (html !== null) await page.waitForTimeout(step);
      waited += step;
      html = await contentOrNull(page, Math.min(NAV_SETTLE_MS, left()));
    }
    if (html === null) html = await contentSettled(page, Math.min(NAV_SETTLE_MS, left()));
    return html;
  })();
  try {
    const html = await within(Math.max(1, hardMs), work,
      `the page did not settle within ${Math.round(hardMs / 1000)}s; the probe was stopped and the session freed`);
    // WHERE THE PAGE LANDED (DIVE-5388), for the generic check: a redirect to a
    // sign-in path is a signed-out login whatever the page says. A log line, so
    // it reaches the caller's stderr and never the document it greps.
    if (req.report_url) send({ t: 'log', line: `5dive-probe-final-url: ${urlNow()}` });
    send({ t: 'out', data: html.endsWith('\n') ? html : html + '\n' });
    end(0);
  } catch (e) {
    over = true;
    send({ t: 'err', msg: `could not load ${req.url}: ${e.message}` });
    end(E_FAILED);
  } finally {
    over = true;
    // The abandoned work may still reject once its tab is gone; that is expected.
    work.catch(() => {});
    // NEVER WAIT ON THE CLOSE: a tab whose script never yields can hold close()
    // as long as it held content(), and the session must be free now.
    const shut = (p) => { try { Promise.resolve(p.close()).catch(() => {}); } catch (e) { /* going anyway */ } };
    if (page) shut(page);
    // A tab newPage() hands over after the deadline is closed when it arrives.
    else work.finally(() => { if (page) shut(page); }).catch(() => {});
  }
}

// ---- totp: the owner's authenticator code (DIVE-5336) -----------------------
//
// IN ITS OWN TAB, like the probe: the first page may be a person's at the viewer.
// The seed is read HERE, as the profile's owner, from inside the 0700 profile —
// a brokered seat that asked for the fill never sees the seed or the code, only
// which field was typed into. Lease re-read first, as every acting op does.
async function totpRequest(ctx, profile, req, send, end) {
  if (typeof req.url !== 'string' || !/^https?:\/\//.test(req.url)) {
    send({ t: 'err', msg: 'totp needs the http(s) url where the site asks for the code' }); return end(E_NOTHING_RAN);
  }
  let page;
  try {
    assertLease(req, 'totp');
    page = popup.mine(await ctx.newPage());
    page.setDefaultTimeout(STEP_TIMEOUT);
    const r = await totp.fill(page, profile, { url: req.url, base: req.host,
      settleMs: Number(process.env.FIVEDIVE_BROWSER_RUN_SETTLE_MS || 1500) });
    send({ t: 'out', data: JSON.stringify(r) + '\n' });
    end(0);
  } catch (e) {
    send({ t: 'err', msg: `could not type the authenticator code: ${e.message}` });
    end(E_FAILED);
  } finally {
    try { if (page) await page.close(); } catch (e) { /* the tab is going anyway */ }
  }
}

// ---- render: what `shot` and `read` needed and DIVE-4621 did not build ------
//
// Those two were the last verbs still driving a chrome of their own, which a
// brokered seat cannot do at all: --user-data-dir on somebody else's 0700
// profile is an EACCES, and the profile is the whole point. So the render
// happens in the browser that already holds the session and the BYTES come
// back — never a path to write. A request carrying an --out= would be this
// process writing a caller-chosen path as the profile's owner, which is the
// rig DIVE-4662's hand test used and the row explicitly said not to ship.
//
// IN ITS OWN TAB, like the probe, so a person at the viewer is not navigated
// away — and both halves come from ONE page instant, which the cold path
// (two chromes, --screenshot then --dump-dom) cannot promise.
async function renderRequest(ctx, req, send, end) {
  if (typeof req.url !== 'string' || !/^https?:\/\//.test(req.url)) {
    send({ t: 'err', msg: 'render needs an http(s) url' }); return end(E_NOTHING_RAN);
  }
  let page;
  try {
    assertLease(req, 'render');
    page = popup.mine(await ctx.newPage());
    page.setDefaultTimeout(Number(process.env.FIVEDIVE_BROWSER_STEP_TIMEOUT || STEP_TIMEOUT));
    const w = Number(req.width) || 1280, h = Number(req.height) || 800;
    if (typeof page.setViewportSize === 'function') {
      try { await page.setViewportSize({ width: w, height: h }); } catch (e) { /* headed ctx may refuse */ }
    }
    await page.goto(req.url, { waitUntil: 'domcontentloaded' });
    const inter = await aria.waitInterstitial(page);   // DIVE-6317, as snapshot
    // `read --wait-for` on a brokered seat (DIVE-4983), the same wait snapshot has.
    const waited = req.wait_for
      ? await aria.waitForPast(page, String(req.wait_for), inter, { timeoutMs: STEP_TIMEOUT }) : null;
    await page.waitForTimeout(Number(req.wait) || Number(process.env.FIVEDIVE_BROWSER_TREE_SETTLE_MS || 1200));
    const buf = await page.screenshot({ fullPage: !!req.full });
    // A client-side redirect mid-render is "not yet", not a failed shot (DIVE-7648).
    const html = await contentSettled(page, NAV_SETTLE_MS);
    send({ t: 'out', data: JSON.stringify({
      url: req.url,
      png: Buffer.isBuffer(buf) ? buf.toString('base64') : Buffer.from(String(buf)).toString('base64'),
      html,
      ...(waited ? { wait_for: waited } : {}),
      ...(inter ? { interstitial: inter } : {}),
    }) + '\n' });
    end(0);
  } catch (e) {
    send({ t: 'err', msg: `could not render ${req.url}: ${e.message}` });
    end(E_FAILED);
  } finally {
    try { if (page) await page.close(); } catch (e) { /* the tab is going anyway */ }
  }
}

// ---- download: the bytes at one URL (DIVE-7646) ----
//
// Fetched through this context's own request client, so the profile's cookies
// ride along, and sent back as the act's download lines (lib/downloads.cjs
// stream): this process is the profile's OWNER and never writes a path the
// caller chose (DIVE-4662). No tab is opened, so a person at the viewer is not
// navigated away. One line {act_download, i:0, name, bytes, type} then the chunks,
// or {act_download, i:0, name, error} and exit 1.
async function downloadRequest(ctx, req, send, end) {
  if (typeof req.url !== 'string' || !/^https?:\/\//.test(req.url)) {
    send({ t: 'err', msg: 'download needs an http(s) url' }); return end(E_NOTHING_RAN);
  }
  try { assertLease(req, 'download'); } catch (e) { send({ t: 'err', msg: e.message }); return end(E_FAILED); }
  const r = await downloads.fetchFile(ctx, req.url);
  if (!r.ok) {
    send({ t: 'out', data: JSON.stringify({ act_download: true, i: 0, name: downloads.safeName(downloads.nameFrom({}, req.url), new Set()), error: r.error }) + '\n' });
    return end(E_FAILED);
  }
  let dir = null;
  try {
    dir = fs.mkdtempSync(path.join(require('os').tmpdir(), '5dive-dl-'));
    const entries = await downloads.save({ list: [], files: [{ name: r.name, type: r.type, buf: r.buf }] }, dir);
    downloads.stream(entries, (line) => send({ t: 'out', data: line }));
    end(entries[0] && entries[0].error ? E_FAILED : 0);
  } catch (e) {
    send({ t: 'err', msg: `the file was fetched but could not be handed back: ${e.message}` });
    end(E_FAILED);
  } finally {
    if (dir) { try { fs.rmSync(dir, { recursive: true, force: true }); } catch (e) { /* its TMPDIR is reaped */ } }
  }
}

// ---- read: several pages in ONE request, loaded side by side (DIVE-6771) ----
//
// `read <url> <url>…` on a served profile used to send one `render` per page,
// and this loop takes one request at a time: on the bench rig the three R1
// pages came back ~10 s apart (35.7 s, against 9.4 s for one), each one also
// sitting through `read`'s 8 s --virtual-time-budget as a REAL wait and taking
// a screenshot nobody asked for. Here every page gets its own tab (a person at
// the viewer is not navigated away), all of them load at once, and each waits
// only the settle the cold executor's readMode waits. No PNG: a read keeps the
// document. A page that fails is named in its own entry; the others still land.
async function readRequest(ctx, req, send, end) {
  const urls = Array.isArray(req.urls) ? req.urls : [];
  if (!urls.length || urls.length > 5 || !urls.every((u) => typeof u === 'string' && /^https?:\/\//.test(u))) {
    send({ t: 'err', msg: 'read needs one to five http(s) urls' }); return end(E_NOTHING_RAN);
  }
  try { assertLease(req, 'read'); } catch (e) { send({ t: 'err', msg: e.message }); return end(E_FAILED); }
  const settle = Number(req.wait) || TREE_SETTLE_MS;
  // THE PAGE THE BROWSER IS ALREADY ON IS READ AS IT IS (DIVE-6778), as snapshot reads
  // it: `snapshot <url>` then `links <url>` loaded the same page a second time.
  let shown = null;
  try { shown = await pageFor(ctx, urls[0], { read: true }); } catch (e) { shown = null; }
  const pages = await Promise.all(urls.map(async (url) => {
    let page;
    try {
      return await within(READ_PAGE_MS, (async () => {
        if (shown && (inPopup(shown, url) || isOn(shown, url))) {
          return { url, ok: true, html: await shown.content(), shown: true };
        }
        page = popup.mine(await ctx.newPage());
        page.setDefaultTimeout(Number(process.env.FIVEDIVE_BROWSER_STEP_TIMEOUT || STEP_TIMEOUT));
        // The default settle ends when this tab is quiet (DIVE-6778); a --wait is waited in full.
        const watch = !Number(req.wait) && typeof page.context === 'function' ? aria.requestWatch(page) : null;
        await page.goto(url, { waitUntil: 'domcontentloaded' });
        const inter = await aria.waitInterstitial(page, { timeoutMs: Math.min(READ_PAGE_MS / 2, 20000) });
        await aria.settleQuiet(page, settle, watch);
        const html = await page.content();
        return { url, ok: true, html, ...(inter ? { interstitial: inter } : {}) };
      })(), `the page did not finish loading within ${Math.round(READ_PAGE_MS / 1000)} s; nothing of it was read`);
    } catch (e) {
      return { url, ok: false, error: e.message };
    } finally {
      // Not awaited: closing a tab whose script never yields can hang too.
      try { if (page) page.close().catch(() => { /* the tab is going anyway */ }); } catch (e) { /* same */ }
    }
  }));
  // One page at a time: the extraction is CPU, and the tabs are already closed.
  for (const p of pages) if (p.ok) p.extracted = await extractFor(req, p.html, p.url);
  send({ t: 'out', data: JSON.stringify({ pages }) + '\n' });
  end(0);
}

async function treeRequest(ctx, req, send, end) {
  if (typeof req.url !== 'string' || !/^https?:\/\//.test(req.url)) {
    send({ t: 'err', msg: 'tree needs an http(s) url to enumerate' }); return end(E_NOTHING_RAN);
  }
  try {
    const page = await pageFor(ctx, req.url, { read: true });
    assertLease(req, 'tree');
    // Not reloaded when the browser is already on it (DIVE-6778), as snapshot.
    const stay = inPopup(page, req.url) || isOn(page, req.url);
    if (!stay) await goTo(page, req.url);
    // NEVER network idle: a live web app long-polls and never idles — that is
    // what makes a `read` hang for 150s on a real Gmail.
    const settle = settleOf(req, stay ? 0 : TREE_SETTLE_MS);
    if (settle > 0) await page.waitForTimeout(settle);
    const { nodes } = await aria.walk(page, { interactiveOnly: !!req.interactive });
    send({ t: 'out', data: JSON.stringify({ url: req.url, nodes }) + '\n' });
    end(0);
  } catch (e) {
    send({ t: 'err', msg: `could not enumerate ${req.url}: ${e.message}` });
    end(E_NOTHING_RAN);
  }
}

// ---- snapshot: the decision payload, warm and in one round trip (DIVE-4653)
//
// This is the op the DIVE-4621 header said the daemon did not have. `shot` and
// `read` kept a cold chrome of their own because the daemon could only navigate
// and enumerate — it had no way to hand back a document or a picture, so giving
// those verbs the warm session would have meant rendering nothing.
//
// `snapshot` closes that without retrofitting either verb: one request, one
// navigation inside the browser that is ALREADY holding this profile, one
// page-side walk that returns the refs AND the document, and one screenshot of
// that same tab. Three cold cycles (a launch, a session probe and a load each)
// become one socket call.
//
// THE DOCUMENT AND THE PNG ARE WRITTEN TO FILES THE CALLER NAMED, and the socket
// carries only the small payload. The daemon is this seat's own process writing
// inside this seat's own 0700 artifact directory, which bin/browser made — so
// this adds no reach, and it keeps a multi-megabyte document out of a protocol
// framed as JSON lines.
//
// ...EXCEPT THAT A BROKERED CALLER IS NOT THIS SEAT (DIVE-4794). The paragraph
// above assumes the artifact directory was made by the same seat the daemon
// runs as. Under the box login it was not: `bin/browser` makes its staging
// directory 0700 to the CALLER, and the daemon — the profile's owner — cannot
// write into it. So every brokered `snapshot` died with
// `EACCES: permission denied, open '/tmp/5dive-browser-read.XXXX/page.html'`,
// which is the verb the skill tells an agent to reach for first, dark for every
// seat that does not own the login (measured on a box, 2026-09-21).
//
// `inline` IS THE BROKERED SHAPE, and it is the same trade `render` already
// made: the bytes come back over the socket and the CALLER writes them, in a
// directory it owns, at a path the daemon never learns. That keeps the fix on
// the right side of DIVE-4662 — the alternative (the caller hands over a path,
// the owner widens it or writes there anyway) is the owning seat writing a
// caller-chosen path, which is the rig that row said not to ship.
async function snapshotRequest(ctx, req, send, end) {
  if (typeof req.url !== 'string' || !/^https?:\/\//.test(req.url)) {
    send({ t: 'err', msg: 'snapshot needs an http(s) url to capture' }); return end(E_NOTHING_RAN);
  }
  const inline = !!req.inline;
  if (!inline && (typeof req.html !== 'string' || !req.html.startsWith('/'))) {
    send({ t: 'err', msg: 'snapshot needs an absolute path to write the captured document to, or inline:true to have the bytes returned' });
    return end(E_NOTHING_RAN);
  }
  try {
    const page = await pageFor(ctx, req.url, { read: true });
    assertLease(req, 'snapshot');
    if (page === latePopup) {
      send({ t: 'log', line: `  a popup opened after the last act: ${popup.hostOf(page.url())}. It is on top of ${popup.hostOf(req.url)}, so this read is of it (${page.url()}).` });
    }
    // The document's HTTP status, as the cold driver records it (DIVE-6725).
    let resp = null;
    // THE PAGE THE BROWSER IS ALREADY ON IS READ AS IT IS (DIVE-6778), as `act`'s
    // own URL already is (DIVE-5817). The reload cost a full page load plus the
    // settle on every snapshot after an act (bench: 8.8 s median against 0.4 s for
    // agent-browser's snapshot), and it threw away what the act had just done to
    // the page: a typed value, an open menu. No load, so no settle either: the
    // act that left the page here already waited its own.
    // A SNAPSHOT WITH NO URL (req.here, DIVE-7801) is the page in view, wherever it
    // went: the url it names is only the last act's, kept to pick the tab. Box bug
    // 738: a same-tab OAuth redirect left that tab on Google's chooser, and a load
    // of its URL again would replay a sign-in already under way.
    const stay = !!req.here || inPopup(page, req.url) || isOn(page, req.url);
    // A late popup (DIVE-7680) is read at its own address, not the one the read named.
    const readAt = page === latePopup || req.here ? String(page.url()) : req.url;
    if (stay) send({ t: 'log', line: `  the browser is already on ${readAt}; read as it is, not reloaded` });
    // The load's settle ends when the page is quiet, as act's does (DIVE-6778).
    const watch = !stay && typeof page.context === 'function' ? aria.requestWatch(page.context()) : null;
    let inter, waited, loading = false;
    try {
      if (!stay) resp = await goTo(page, req.url);
      // A Cloudflare "Just a moment..." clears in this same load, or not at all
      // (DIVE-6317). A --wait-for behind one that never cleared would only wait again.
      inter = await aria.waitInterstitial(page);
      // --wait-for (DIVE-4983), exactly as the cold driver's snapshotMode does it,
      // bounded as an act's wait_for is (DIVE-7303): a miss waited 30 s on the bench.
      waited = req.wait_for
        ? await aria.waitForPast(page, String(req.wait_for), inter, { timeoutMs: stepLimit(req) }) : null;
      // The settle never waits for the network to go quiet (a page with ads never
      // does); it SAYS so instead (DIVE-7303), so the agent knows a late part may
      // still come and can look again, as Claude in Chrome's agent does.
      const settle = settleOf(req, stay ? 0 : TREE_SETTLE_MS);
      if (settle > 0) loading = !(await aria.settleQuiet(page, settle, watch)) && !!watch;
    } finally { if (watch) watch.stop(); }
    const snap = await aria.snapshot(page, { interactiveOnly: !!req.interactive });
    // The agent has now seen this tab: the next act on it says what changed since.
    if (req.look) {
      let text = '';
      try { text = String(await page.evaluate(aria._textIn, { textOf: true }) || ''); } catch (e) { /* refs alone */ }
      looks.remember(page, look.lookOf(snap.url || req.url, snap.nodes, text));
    }
    let png = null;
    if (!inline) {
      fs.writeFileSync(req.html, snap.html || '', { mode: 0o600 });
      if (req.shot) await page.screenshot({ path: req.shot, fullPage: !!req.full });
    } else if (req.shot) {
      const buf = await page.screenshot({ fullPage: !!req.full });
      png = Buffer.isBuffer(buf) ? buf.toString('base64') : Buffer.from(String(buf)).toString('base64');
    }
    send({ t: 'out', data: JSON.stringify({
      url: snap.url || readAt,
      title: snap.title || '',
      nodes: snap.nodes || [],
      html_bytes: Buffer.byteLength(snap.html || ''),
      png: inline ? null : (req.shot || null),
      html_inline: inline ? (snap.html || '') : undefined,
      png_b64: png,
      ...(waited ? { wait_for: waited } : {}),
      ...(inter ? { interstitial: inter } : {}),
      ...(loading ? { still_loading: true } : {}),
      // A served browser is a headed one (the launch above), recorded as the cold one is.
      browser_mode: 'headed',
      // The popup this was read from, when it is one (DIVE-7680).
      ...(front && page !== front.base && front.popup ? { popup: front.popup } : {}),
      ...(resp ? { http_status: resp.status() } : {}),
      extracted: await extractFor(req, snap.html, snap.url || readAt),
    }) + '\n' });
    end(0);
  } catch (e) {
    send({ t: 'err', msg: `could not capture ${req.url}: ${e.message}` });
    end(E_NOTHING_RAN);
  }
}

// The same page, as a browser normalises it (`https://a.test` is `https://a.test/`).
// The fragment counts: a hash-routed app's `#/inbox` and `#/drafts` are two pages.
function sameUrl(a, b) {
  try { return new URL(a).href === new URL(b).href; } catch (e) { return false; }
}
// WHERE A PAGE WAS SENT, AND WHERE IT LANDED (DIVE-6778). `snapshot https://www.amtrak.com/`
// lands on /home, and the agent's next `links https://www.amtrak.com/` loaded the
// site again in a new tab (9-11 s on the bench) because neither URL equals the
// other. A page is on <url> when it shows it, or when <url> is what its last goto
// asked for and it has not moved since.
const sentTo = new WeakMap();
// A LOAD THE PAGE'S OWN REDIRECT INTERRUPTED IS THAT PAGE, LOADED (DIVE-6795).
// The served browser is started ON the first url; when the site redirects it
// (amtrak.com -> /home) while the snapshot's goto runs, Playwright throws
// "interrupted by another navigation", and 2 of the bench's first 5 snapshots
// died on it (exit 69, then a second call). The navigation that won is waited for.
// ...AND SO IS A LOAD THAT ABORTED BECAUSE THE SAME SITE WAS STILL LOADING
// (DIVE-7303). The first snapshot of the public profile starts the served browser
// ON its url, then loads it again; Chrome drops one of the two with
// net::ERR_ABORTED, and 8 of the fresh-100 bench's jobs opened with that exit 69
// and a second call that found the browser already there. When the page did land
// on the site it was sent to, that is the load; anywhere else, or still on the
// page it left (a same-site download aborts too), the error stands.
const sameOrigin = (a, b) => { try { return new URL(a).origin === new URL(b).origin; } catch (e) { return false; } };
async function goTo(page, url) {
  let resp = null, before = '';
  try { before = page.url(); } catch (e) { /* none */ }
  try { resp = await page.goto(url, { waitUntil: 'domcontentloaded' }); }
  catch (e) {
    const msg = String(e && e.message);
    if (/net::ERR_ABORTED/.test(msg)) {
      try { await page.waitForLoadState('domcontentloaded'); } catch (e2) { /* judged by where it is */ }
      if (!sameOrigin(page.url(), url) || page.url() === before) throw e;
    } else {
      if (!/interrupted by another navigation/.test(msg)) throw e;
      await page.waitForLoadState('domcontentloaded');
    }
  }
  try { sentTo.set(page, { asked: url, landed: page.url() }); } catch (e) { /* only a shortcut is lost */ }
  return resp;
}
function isOn(page, url) {
  if (sameUrl(page.url(), url)) return true;
  const s = sentTo.get(page);
  return !!s && s.landed === page.url() && sameUrl(s.asked, url);
}

async function planRequest(ctx, req, send, end) {
  const steps = Array.isArray(req.steps) ? req.steps : null;
  if (!steps || !steps.length) { send({ t: 'err', msg: 'the plan carries no steps' }); return end(E_NOTHING_RAN); }
  const args = (req.args && typeof req.args === 'object') ? req.args : {};

  // VALIDATE AND INTERPOLATE THE WHOLE PLAN BEFORE ANYTHING TOUCHES THE PAGE.
  // Half an action is the outcome with no clean recovery.
  let resolved;
  try {
    resolved = steps.map((s, i) => {
      const spec = STEPS[s && s.op];
      // DIVE-8241: a click by position and a read-only page script are an act's
      // (guarded) steps, never a recipe's: `run` keeps the closed vocabulary.
      if (!spec && req.guard === true && s && point.ACT_ONLY.has(s.op)) {
        try { return point.validate(s, i + 1); } catch (e) { e.nothingRan = true; throw e; }
      }
      if (!spec) {
        const e = new Error(`step ${i + 1} uses '${s && s.op}', which is outside the fixed vocabulary ` +
          `(${Object.keys(STEPS).join(' ')}). The vocabulary is the point: an adapter that can express ` +
          `anything is freeform reasoning with extra syntax.`);
        e.nothingRan = true; throw e;
      }
      const out = { op: s.op };
      // DIVE-6844: the site a saved login is for (bin/browser sets it, never a page).
      if ((s.op === 'fill' || s.op === 'type') && typeof s.host === 'string' && s.host) out.host = s.host;
      // DIVE-7237: an act's upload carries the file's bytes, read by the calling seat.
      if (s.op === 'upload' && s.file && typeof s.file === 'object' && typeof s.file.b64 === 'string') out.file = s.file;
      for (const field of spec) {
        if (typeof s[field] !== 'string' || !s[field]) {
          const e = new Error(`step ${i + 1} (${s.op}) is missing '${field}'`); e.nothingRan = true; throw e;
        }
        // A SELECTOR IS NEVER INTERPOLATED — an argument that could choose which
        // element gets clicked is the hole, and `ref=<role>/<name>` is a selector
        // by this rule too.
        // `literal` (DIVE-4943): `act`'s values are the agent's own text, typed as given.
        out[field] = field === 'selector' || req.literal ? s[field]
          : interpOrThrow(s[field], args, `step ${i + 1} (${s.op})`, field === 'url' ? encodeURIComponent : null);
      }
      // `type`'s delay_ms and value, checked with the rest, as the one-shot driver does.
      if (s.op === 'type') {
        const why = aria.typeRefusal(s.delay_ms, out.value);
        if (why) { const e = new Error(`step ${i + 1} (type) ${why}`); e.nothingRan = true; throw e; }
        out.delay_ms = aria.typeDelay(s.delay_ms);
      }
      // `intent`, as the one-shot driver keeps it: never interpolated.
      if (typeof s.intent === 'string' && s.intent) out.intent = s.intent;
      return out;
    });
  } catch (e) {
    send({ t: 'err', msg: e.message }); return end(E_NOTHING_RAN);
  }

  // A STEP COUNTS AS RUN ONCE ITS AWAIT IS ENTERED, not once it returns: a goto
  // that throws may already have navigated, a click may already have posted. The
  // expensive direction is claiming nothing ran when something did — that is the
  // blind retry that double-posts.
  let stepsRun = 0, signedIn = false, needsOwner = null, retry = null, at = -1, lastOp = null;
  const stepMs = stepLimit(req);
  let page;
  // The act's own URL picks the window (DIVE-6392): the popup an earlier act left
  // open when it is on that popup's site or the act names no URL, otherwise the main tab.
  const first = resolved[0] && resolved[0].op === 'goto' ? resolved[0].url : null;
  try { page = await pageFor(ctx, first); }
  catch (e) {
    send({ t: 'err', msg: `the session is open but would not give up a page: ${e.message}` });
    send({ t: 'err', msg: 'not one step ran, so nothing was published and there is nothing to re-read.' });
    return end(E_NOTHING_RAN);
  }
  // A FILE A CLICK DOWNLOADS (DIVE-5751), watched from before step one and handed
  // back after the re-read — lib/downloads.cjs, shared with the one-shot loop.
  const dl = (req.report && req.report.downloads) ? downloads.watch(ctx, page) : null;
  // The requests the steps start, on every tab of the context (a popup's too), so
  // the settles below end when the page is quiet (DIVE-6778, lib/aria.cjs settleQuiet).
  const watch = typeof page.context === 'function' ? aria.requestWatch(page.context()) : null;
  const done = () => { front.use({}); if (watch) watch.stop(); };
  const quiet = watch ? (ms) => aria.settleQuiet(front.page, ms, watch) : null;
  if (page === front.base) front.home();
  front.use({
    log: (l) => send({ t: 'log', line: `  ${l}` }),
    onOpen: async (p) => {
      const inter = await aria.waitInterstitial(p);   // watched, never clicked (DIVE-6317)
      if (inter) send({ t: 'log', line: `  the popup's "${inter.title}" ${inter.cleared ? `cleared by itself after ${inter.waited_ms} ms` : `was still there after ${inter.waited_ms} ms`}` });
    },
  });
  try {
    for (let i = 0; i < resolved.length; i++) {
      const s = resolved[i];
      const where = `step ${i + 1} (${s.op})`;
      at = i;
      page = await front.sync(lastOp, quiet);
      // BEFORE THE RESOLVE AND BEFORE THE COUNTER. Both touch the page, and the
      // point is to touch nothing once the browser is someone else's.
      assertLease(req, where);
      // A ref `wait_for` WAITS, like its CSS twin always did (DIVE-4674). The
      // choice of which ops wait lives in lib/aria.cjs, shared by this loop and
      // the other one, because the defect was that there are two of them.
      // One retry on a picked element when a ref matches nothing — the same call
      // as the one-shot driver's loop (lib/aria.cjs resolveOrRepick).
      // GOOGLE'S SIGN-IN PAGES (DIVE-6228), before the step touches one: a password,
      // a code, a robot check, adding an account or a wider grant stops the plan
      // here, whatever the steps say. lib/google-signin.cjs, shared by both loops.
      const gs = await gsignin.stepStop(page, s, (req && req.gates) || []);
      if (gs) {
        send({ t: 'err', msg: gsignin.STOP_PREFIX.trim() + ' ' + JSON.stringify(gs) });
        throw new Error(`${where}: not run. ${gs.why}`);
      }
      // DIVE-7168: the sign-in the guard allowed, said once per act for the owner's record.
      if (!signedIn) { const gg = await gsignin.stepGrant(page, s); if (gg) { signedIn = true; send({ t: 'err', msg: gsignin.GRANT_PREFIX.trim() + ' ' + JSON.stringify(gg) }); } }
      // DIVE-8241: BY POSITION, OR A PAGE SCRIPT (lib/point.cjs, shared by both loops).
      // The owner's four are read off the element under the point; an eval only reads.
      if (point.ACT_ONLY.has(s.op)) {
        if (s.op === 'eval') {
          const json = await point.evalStep(page, s);
          send({ t: 'log', line: `  ${where} = ${json}` });
        } else {
          if (req.guard && !req.approved) {
            const risk = await point.pointRisk(page, s);
            if (risk && Array.isArray(req.allow_kinds) && req.allow_kinds.includes(risk.cls)) {
              send({ t: 'err', msg: aria.OWNER_ALLOWED_PREFIX.trim() + ' ' + JSON.stringify({ ...risk, step: i + 1, op: s.op }) });
            } else if (risk) { needsOwner = { ...risk, step: i + 1, op: s.op }; break; }
          }
          stepsRun++;
          send({ t: 'log', line: `  ${where}: ${await point.runPoint(page, s, { timeoutMs: stepMs })}` });
        }
        lastOp = s.op;
        send({ t: 'log', line: `  ${where} ok` });
        continue;
      }
      const { sel, retry: r } = await aria.resolveOrRepick(page, s, i + 1, { timeoutMs: stepMs });
      if (r) assertLease(req, where);
      retry = r;
      // THE OWNER'S FOUR (DIVE-4943) — the same check, in the same place, as the
      // one-shot driver's loop; lib/aria.cjs holds it so the two cannot differ.
      if (req.guard && !req.approved) {
        const risk = await aria.stepRisk(page, s, sel);
        // The owner's policy (DIVE-4982), exactly as the one-shot driver reads it.
        if (risk && Array.isArray(req.allow_kinds) && req.allow_kinds.includes(risk.cls)) {
          send({ t: 'err', msg: aria.OWNER_ALLOWED_PREFIX.trim() + ' ' + JSON.stringify({ ...risk, step: i + 1, op: s.op }) });
        } else if (risk) { needsOwner = { ...risk, step: i + 1, op: s.op }; break; }
      }
      stepsRun++;
      // A REF WHOSE ELEMENT THE PAGE REPLACED IS FOUND AGAIN (DIVE-5335), never a
      // step that may have acted, and the owner's check is read again on it —
      // lib/aria.cjs onRef, shared by both loops.
      const on = (act) => aria.onRef(page, s, sel, act, {
        timeoutMs: stepMs, log: (l) => send({ t: 'log', line: `  ${l}` }),
        check: (req.guard && !req.approved) ? async (x) => {
          const k = await aria.stepRisk(page, s, x);
          return !k || (Array.isArray(req.allow_kinds) && req.allow_kinds.includes(k.cls));
        } : null,
      });
      // DIVE-6844: a saved login carries the site it is for, and is typed on
      // no other (the page may have moved since the act began). Checked here,
      // not on the case lines, which older harnesses match byte for byte.
      if (s.op === 'fill' || s.op === 'type') savedHostCheck(page, s);
      // DIVE-8241: a tab a saved value went into is one no page script reads.
      if ((s.op === 'fill' || s.op === 'type') && s.host) point.markSaved(page);
      // DIVE-7237: an act's upload carries the file's bytes, read by the caller
      // (who may hold files this browser's seat cannot open); an adapter's names a path.
      if (s.op === 'upload' && s.file && typeof s.file.b64 === 'string') {
        s.path = { name: String(s.file.name || 'upload'), mimeType: String(s.file.mimeType || 'application/octet-stream'), buffer: Buffer.from(s.file.b64, 'base64') };
      }
      let landedFile = false;   // DIVE-7646: a file is no page to judge a landing by
      switch (s.op) {
        case 'goto': {
          // THE ACT'S OWN URL DOES NOT RELOAD THE PAGE IT IS ALREADY ON (DIVE-5817).
          // `act <url>` puts a goto in front of the steps; in a served browser
          // that sat on <url> since the last act, the reload threw away what the
          // page held (a 6-digit code box a site had just opened). Only that
          // first, caller-less goto, and only on an exact URL match: a goto the
          // steps name themselves still navigates, which is how to ask for a reload.
          // A popup an earlier act left on this URL is never reloaded either (DIVE-6392).
          if (i === 0 && (req.stay === true || inPopup(page, s.url)) && sameUrl(page.url(), s.url)) {
            send({ t: 'log', line: `  ${where}: already on ${s.url}; not reloaded, so the page keeps what it holds` });
            break;
          }
          // A GOTO THAT LANDS ON A FILE HANDS IT OVER (DIVE-7646), as the cold driver.
          let resp = null;
          try { resp = await goTo(page, s.url); }
          catch (e) {
            if (!(dl && /Download is starting/.test(String(e && e.message)))) throw e;
            send({ t: 'log', line: `  ${where}: ${s.url} is a file, and it is downloading` });
            landedFile = true;
            break;
          }
          const kept = await downloads.keepResponse(dl, ctx, resp);
          if (kept) { send({ t: 'log', line: `  ${where}: ${s.url} is a file (${kept.type || 'attachment'}); it is handed over with the act` }); landedFile = true; break; }
          const inter = await aria.waitInterstitial(page);   // DIVE-6317
          if (inter) send({ t: 'log', line: `  ${where}: "${inter.title}" ${inter.cleared ? `cleared by itself after ${inter.waited_ms} ms` : `was still there after ${inter.waited_ms} ms`}` });
          const ms = settleOf(req, RUN_SETTLE_MS);
          if (ms > 0) await aria.settleQuiet(page, ms, watch);
          break;
        }
        case 'fill':     await on((x, timeout) => page.fill(x, s.value, { timeout })); break;
        case 'type':     await aria.typeKeys(page, sel, s.value, s.delay_ms, { timeoutMs: stepMs }); break;
        case 'click':    await on((x, timeout) => aria.clickStep(page, s, x, timeout, { log: (l) => send({ t: 'log', line: `  ${l}` }) })); break;
        case 'wait_for': await page.waitForSelector(sel, { timeout: stepMs }); break;
        case 'select':   await on((x, timeout) => page.selectOption(x, s.value, { timeout })); break;
        case 'upload':   await on((x, timeout) => page.setInputFiles(x, s.path, { timeout })); break;
        case 'press':    await on((x, timeout) => page.press(x, s.key, { timeout })); break;
      }
      if (retry) send({ t: 'log', line: `  ${retry}ok` });
      retry = null;
      lastOp = s.op;
      send({ t: 'log', line: `  ${where} ok` });
      // WHERE THE GOTO LANDED (DIVE-4991), said every time, exactly as the cold
      // driver says it. This IS the served browser, so there is nothing to retry in.
      if (s.op === 'goto' && req.landing && !landedFile) {
        const land = await aria.checkLanding(page, s.url, req.landing);
        if (land.line) send({ t: 'log', line: land.line });
        if (land.loginWall) throw new Error(`${where}: ${land.loginWall}`);
      }
    }
    at = -1;
  } catch (e) {
    if (retry) send({ t: 'log', line: `  ${retry}failed` });
    // Without Playwright's 30-line "Call log:" (DIVE-6795, aria.stepErrorText).
    send({ t: 'err', msg: aria.stepErrorText(e.message) });
    // Which step (DIVE-4990), exactly as the one-shot driver says it.
    if (at >= 0) send({ t: 'err', msg: aria.STEP_FAILED_PREFIX.trim() + ' ' + JSON.stringify(aria.failedStep(at + 1, resolved[at], e)) });
    if (!stepsRun) {
      if (dl) dl.stop();
      send({ t: 'err', msg: 'the session was open but not one step ran, so nothing was published and ' +
        'there is nothing to re-read.' });
      done();
      return end(E_NOTHING_RAN);
    }
    // The step that failed may have opened the popup: the re-read shows it either way.
    try { page = await front.sync(resolved[at] ? resolved[at].op : lastOp); } catch (e2) { /* re-read the page we have */ }
    await sendReport(page, req, send, { failed: true, watch });
    done();
    await sendDownloads(dl, send);
    return end(E_FAILED);
  }
  if (needsOwner) send({ t: 'err', msg: aria.NEEDS_OWNER_PREFIX.trim() + ' ' + JSON.stringify(needsOwner) });
  page = await front.sync(lastOp, quiet);
  // A click whose page went quiet inside the popup wait has settled already.
  await sendReport(page, req, send, { watch, settled: front.settled });
  done();
  await sendDownloads(dl, send);
  // THE SESSION STAYS WARM AND THE PAGE STAYS WHERE IT IS. Closing the context
  // here would give back exactly the launch this daemon exists to stop paying.
  end(needsOwner ? aria.E_NEEDS_OWNER : 0);
}

// `act`'s re-read (DIVE-4943), sent back INLINE: the caller may be a brokered
// seat that cannot hand this process a path (the DIVE-4794 trade `snapshot`
// already makes). One `out` line of JSON, and only when the request asked.
async function sendReport(page, req, send, { failed = false, watch = null, settled = false } = {}) {
  if (!req.report) return;
  const r = req.report;
  // A READ-ONLY ACT (DIVE-8443): only where the page is. No text, document, refs,
  // picture or look is read, so none of it reaches the caller.
  if (r.bare) {
    try { send({ t: 'out', data: JSON.stringify({ act_report: true, bare: true, url: page.url() }) + '\n' }); }
    catch (e) { send({ t: 'err', msg: `the steps ran but where the page is could not be read: ${e.message}` }); }
    return;
  }
  try {
    // DIVE-4983: the same wait, --expect window and refs the cold driver's report takes,
    // and nothing waited for after a failed step (DIVE-6778, as the cold driver): a
    // step that timed out changed nothing, so its re-read settles 0.3 s, not 1.2 s.
    const readOpts = (ms) => ({
      settleMs: ms, waitFor: failed ? null : (r.wait_for || null), waitTimeoutMs: STEP_TIMEOUT,
      expect: r.expect || null, expectWaitMs: failed ? 0 : (Number(r.expect_wait_ms) || 0),
      walk: r.tree ? { interactiveOnly: !!r.interactive } : null,
      scope: r.scope || null, expectDoc: !!r.expect_doc, watch,
    });
    const shoot = async (pg) => {
      if (!r.shot) return null;
      const buf = await pg.screenshot({});
      return Buffer.isBuffer(buf) ? buf.toString('base64') : Buffer.from(String(buf)).toString('base64');
    };
    let after = await aria.pageAfter(page, readOpts(failed ? Math.min(FAILED_SETTLE_MS, settleOf(req, RUN_SETTLE_MS)) : settled && req.settle === undefined ? 0 : settleOf(req, RUN_SETTLE_MS)));
    // ONE REPORT, ONE PAGE (DIVE-7680): a window that arrived during the settle is
    // the page in view, so the report is of it; and a page that moved between the
    // read and the picture is read again, so url, title, refs and png agree.
    if (front && front.waiting) {
      const was = page;
      try { page = await front.drain(); } catch (e) { /* the page we have */ }
      if (page !== was) after = await aria.pageAfter(page, readOpts(POPUP_REREAD_SETTLE_MS));
    }
    // DIVE-8051: the picture shows what --expect matched, scrolled to it when it is off screen.
    if (!failed && r.expect && !r.scope && r.shot) {
      const shown = await aria.showExpect(page, r.expect, after.text);
      if (shown && shown.scrolled) send({ t: 'log', line: `  the picture is scrolled to what --expect matched: "${shown.text}"` });
    }
    let png = await shoot(page);
    const moved = aria.movedSince(page, after);
    if (moved) {
      send({ t: 'log', line: `  the page moved while it was being read (${moved}); read again so the picture and the page agree` });
      after = await aria.pageAfter(page, readOpts(POPUP_REREAD_SETTLE_MS));
      png = await shoot(page);
    }
    // WHAT CHANGED SINCE THE AGENT LAST SAW THIS TAB (DIVE-6795), when asked. A
    // scoped re-read is one element's text, not the page's, so it is no look.
    const seen = req.look && !after.scope && Array.isArray(after.nodes)
      ? looks.since(page, look.lookOf(after.url, after.nodes, after.text)) : undefined;
    const report = { act_report: true, url: after.url, title: after.title,
      text: after.text, values: after.values,
      wait_for: after.wait_for, expect_polled_ms: after.expect_polled_ms, scope: after.scope,
      // DIVE-6392: the mode the steps ran in (a served browser is headed), and the
      // popup in view when there is one.
      browser_mode: 'headed', popup: (front && front.popup) || null,
      look: seen,
      extracted: await extractFor(req, after.html, after.url) };
    // SPLIT, when the caller asked (DIVE-6795): the document, the picture and the
    // refs each on a line of their own, so bin/browser reads the small report
    // without parsing megabytes of HTML six times over (1.6 s on a Wikipedia
    // article). Base64 for the two files: a sed and a decode, no JSON parse. A
    // caller that did not ask gets the one line it always got.
    if (!req.split) {
      send({ t: 'out', data: JSON.stringify({ ...report, html_inline: after.html, png_b64: png, nodes: after.nodes }) + '\n' });
    } else {
      send({ t: 'out', data: JSON.stringify(report) + '\n' });
      send({ t: 'out', data: '{"act_html_b64":"' + Buffer.from(after.html || '').toString('base64') + '"}\n' });
      if (png) send({ t: 'out', data: '{"act_png_b64":"' + png + '"}\n' });
      if (Array.isArray(after.nodes)) send({ t: 'out', data: JSON.stringify({ act_tree: true, url: after.url, title: after.title, nodes: after.nodes }) + '\n' });
    }
  } catch (e) {
    send({ t: 'err', msg: `the steps ran but the page could not be re-read afterwards: ${e.message}` });
  }
}

// The downloads an act started (DIVE-5751), sent back INLINE for the reason the
// re-read is: this process is the profile's owner, the caller may be another
// seat, and the owner writing a caller-chosen path is the DIVE-4662 hole. Saved
// into a directory of this process's own (its TMPDIR is private, DIVE-5190),
// streamed as chunk lines, and removed. Never fatal: the steps already ran.
async function sendDownloads(dl, send) {
  if (!dl) return;
  dl.stop();
  if (!dl.list.length && !dl.files.length) return;
  let dir = null;
  try {
    dir = fs.mkdtempSync(path.join(require('os').tmpdir(), '5dive-act-dl-'));
    const entries = await downloads.save(dl, dir);
    downloads.stream(entries, (line) => send({ t: 'out', data: line }));
  } catch (e) {
    send({ t: 'err', msg: `the act started a download that could not be handed back: ${e.message}` });
  } finally {
    if (dir) { try { fs.rmSync(dir, { recursive: true, force: true }); } catch (e) { /* its TMPDIR is reaped */ } }
  }
}

// ---------------------------------------------------------------- call mode
// The client half, in this same file on purpose: one program that knows the
// protocol cannot drift from itself across a release.
// ============================================================================
// INPUT MODE (DIVE-5287) — plain Chrome, driven the way a person drives it.
//
// Some sites will not render for a browser under automation control. tiktok.com
// was measured on chill-gorge 2026-09-30: through the Playwright launch above
// (--remote-debugging-pipe) /foryou stayed a blank loading page with no
// challenge and no sign-in form, while plain Chrome on the same profile, box and
// IP rendered it. So the fix is the channel, not the IP.
//
// In this mode the daemon launches Chrome itself, with exactly the flags of the
// DIVE-5203 login view (no --remote-debugging-*, no --enable-automation, no
// headless) on the site's Xvfb, and holds NO channel into it. It acts through
// the X server (lib/x11.cjs: XTEST pointer and keys, which the page receives
// as isTrusted input) and reads through a screenshot of the display and the
// window title. The person's viewer streams the same display, so a handoff is
// the same window with no restart and no profile swap.
//
// WHAT IT CANNOT DO, said rather than faked: there is no DOM here. `tree`, the
// DOM `snapshot`, `render` with HTML, adapter `run` plans and the DOM sign-in
// guard all need a channel into the page, and this mode exists because that
// channel is what the site refuses. Those ops answer with a refusal naming the
// input-mode verb to use instead.
// ============================================================================
const INPUT_SETTLE_MS = Number(process.env.FIVEDIVE_BROWSER_INPUT_SETTLE_MS || 1200);
const INPUT_GOTO_SETTLE_MS = Number(process.env.FIVEDIVE_BROWSER_INPUT_GOTO_SETTLE_MS || 2500);
const INPUT_WINDOW_WAIT_MS = Number(process.env.FIVEDIVE_BROWSER_INPUT_WINDOW_WAIT_MS || 20000);
// DIVE-7572: how long a typed address gets to LOAD before the read says it did
// not. INPUT_GOTO_SETTLE_MS is the least it waits; this is the most. "Loaded" is
// the window title no longer being the address (lib/page-load.cjs).
const INPUT_LOAD_WAIT_MS = Number(process.env.FIVEDIVE_BROWSER_INPUT_LOAD_WAIT_MS || 20000);
// THE PAGE MUST BE TAKING INPUT BEFORE INPUT IS SENT (quinn's rejection of the
// first delivery). Measured on Chrome 153 / Xvfb, 2026-09-30: a click and keys
// sent within ~100ms of a page's title appearing are DROPPED — no mousedown, no
// keydown, nothing in the page, and every X request succeeds, so the daemon
// used to report rc=0 over input that never landed. At 100ms and later, 5 of 5
// landed. X focus was on Chrome's window in every dropped run, so this is
// Chrome still bringing the page up, not a focus problem. The daemon therefore
// watches the window title and holds each input request until the title has
// been quiet for INPUT_QUIET_MS (bounded by INPUT_QUIET_CAP_MS: a page that
// retitles itself forever, a ticker or a chat badge, is driven anyway).
const INPUT_QUIET_MS = Number(process.env.FIVEDIVE_BROWSER_INPUT_QUIET_MS || 500);
const INPUT_QUIET_CAP_MS = Number(process.env.FIVEDIVE_BROWSER_INPUT_QUIET_CAP_MS || 8000);
const INPUT_MAX_STEPS = 50, INPUT_MAX_TEXT = 5000, INPUT_MAX_WAIT_MS = 30000;
const sleepMs = (ms) => new Promise((r) => setTimeout(r, ms));

// The SAME refusal as launchArgs, widened by the two flags this mode exists to
// be without: an --enable-automation or a --headless in the operator's extra
// args would quietly turn input mode back into the browser the site refuses.
function plainArgs(profile, sandbox) {
  const extra = (process.env.FIVEDIVE_BROWSER_CHROME_ARGS || '').split(/\s+/).filter(Boolean);
  const args = [`--user-data-dir=${profile}`, '--no-first-run', '--no-default-browser-check',
    '--window-size=1280,800', '--window-position=0,0', '--disable-features=TranslateUI',
    // DIVE-6345: a tab behind another is still painted. Chrome stops painting a
    // background tab, so Claude in Chrome's screenshots of its own working tab
    // hung for 30 s and the agent looped (10-14 head-to-head). The automated
    // launch gets the same three from Playwright's defaults already.
    '--disable-background-timer-throttling', '--disable-renderer-backgrounding',
    '--disable-backgrounding-occluded-windows',
    // DIVE-7204: the "Restore pages?" bubble sits where a real click can land.
    '--hide-crash-restore-bubble',
    ...(sandbox ? [] : ['--no-sandbox']), ...extra];
  const bad = args.filter(a => /^--(remote-debugging|enable-automation|headless)/.test(a));
  if (bad.length) {
    die(E_NOTHING_RAN, `refusing to launch an input-mode browser with ${bad.join(' ')}. Input mode is plain ` +
      `Chrome with no automation channel; any of these makes it the browser the site refuses (and a debug ` +
      `port is full control of the session for every seat on the box).`);
  }
  return args;
}

async function inputLaunch(profile, chrome) {
  const x11 = require(path.join(__dirname, '..', 'lib', 'x11.cjs'));
  if (!process.env.DISPLAY) die(E_UNAVAILABLE, 'input mode needs the display the browser is drawn on, and no DISPLAY was set.');
  // A PROXY WITH A LOGIN DOES NOT GET INPUT MODE (DIVE-4951's rule, same reason).
  // Plain Chrome cannot carry the proxy's login, so it would put this login on
  // the box's own IP — the route the proxy is there to avoid.
  // A PROXY WITH NO LOGIN DOES (DIVE-7476). --proxy-server takes
  // scheme://host:port, which is all such a proxy is (`proxy set` refuses a
  // login on socks5 anyway, so every socks proxy lands here). Refusing it too
  // closed the one escape a site that refuses the automated browser has: report
  // 617, amazon.co.jp behind the owner's login-less residential socks5.
  let viaProxy = null;
  try { viaProxy = proxy.launchProxy(profile); } catch (e) { die(E_UNAVAILABLE, e.message); }
  if (viaProxy && (viaProxy.username || viaProxy.password)) {
    die(E_UNAVAILABLE, 'this seat has a proxy with a login set, and input mode is plain Chrome, which cannot carry a proxy ' +
      'login: it would take this login out through the box\'s own IP. Nothing was started. Use a proxy endpoint ' +
      'with no username and password, or clear the proxy (`5dive browser proxy clear`), to use input mode here.');
  }
  // `server` is scheme://host:port with no userinfo (lib/proxy.cjs strips it).
  const proxyArgs = viaProxy ? [`--proxy-server=${viaProxy.server}`] : [];
  const startUrl = process.env.FIVEDIVE_BROWSER_START_URL || '';
  const start = async (sandbox) => {
    const args = [...plainArgs(profile, sandbox), ...proxyArgs];
    if (/^https?:\/\//i.test(startUrl)) args.push(startUrl);
    const child = cp.spawn(chrome, args, { stdio: ['ignore', 'ignore', 'pipe'] });
    let tail = '';
    child.stderr.on('data', (d) => { tail = (tail + d.toString('utf8')).slice(-2000); });
    const x = await x11.open(process.env.DISPLAY);
    const until = Date.now() + INPUT_WINDOW_WAIT_MS;
    while (Date.now() < until) {
      if (child.exitCode !== null || child.signalCode) {
        x.close();
        const why = tail.split('\n').filter(l => l && !/dbus|DBus/.test(l)).slice(-3).join(' ').slice(0, 400);
        throw new Error(`Chrome exited (${child.exitCode ?? child.signalCode}) before it opened a window${why ? ': ' + why : ''}`);
      }
      const t = await x.windowTitle().catch(() => ({ window: '' }));
      // READY IS A WINDOW THAT HOLDS THE KEYBOARD, not a window with a name.
      // A named window is mapped and viewable (windowTitle reads only those);
      // the focus is then made explicit and confirmed with the server, so the
      // first key does not depend on how Chrome read a pointer it never saw
      // cross into it.
      if (t.window && t.id && (await x.isBrowserWindow(t.id, child.pid))) {
        try { await x.ensureBrowserFocus(child.pid, Math.max(1000, until - Date.now())); }
        catch (e) {
          // Not ours to leave running: the no-sandbox retry below would meet
          // this Chrome's profile lock and exit into it.
          try { child.kill('SIGKILL'); } catch (e2) { /* gone */ }
          x.close();
          throw e;
        }
        return { child, x };
      }
      await sleepMs(200);
    }
    try { child.kill('SIGKILL'); } catch (e) { /* gone */ }
    x.close();
    throw new Error(`Chrome opened no window within ${Math.round(INPUT_WINDOW_WAIT_MS / 1000)}s`);
  };
  let got;
  try { got = await start(sandboxWanted()); }
  catch (e) {
    if (!sandboxWanted()) die(E_UNAVAILABLE, `could not open the ${path.basename(profile)} profile in plain Chrome: ${e.message}`);
    process.stderr.write(`${PROG}: NOTE — Chrome would not start with its sandbox (${e.message}); starting it without the sandbox.\n`);
    try { got = await start(false); }
    catch (e2) { die(E_UNAVAILABLE, `could not open the ${path.basename(profile)} profile in plain Chrome: ${e2.message}`); }
  }
  const { child, x } = got;
  // The title watcher behind the quiet gate (INPUT_QUIET_MS). One title read
  // is a handful of X round trips; every 100ms is nothing next to a screenshot.
  const seen = { title: null, since: Date.now() };
  const watch = setInterval(() => {
    x.windowTitle().then((t) => {
      if (t.window !== seen.title) { seen.title = t.window; seen.since = Date.now(); }
    }).catch(() => { /* the display is going; close() follows */ });
  }, 100);
  watch.unref();
  child.on('exit', () => clearInterval(watch));
  return {
    input: true, child, x, seen,
    handoff: null,
    // The host this window was last sent to (DIVE-7674): the start URL, then
    // every goto typed into it. `front` reads it; nothing else does.
    lastHost: /^https?:\/\//i.test(startUrl) ? frontTab.hostOf(startUrl) : '',
    // SIGTERM is Chrome's clean shutdown: it writes the profile out, which is
    // the durable half (the login). SIGKILL only for one that will not go.
    close: async () => {
      if (child.exitCode !== null || child.signalCode) return;
      try { child.kill('SIGTERM'); } catch (e) { return; }
      for (let i = 0; i < 100 && child.exitCode === null && !child.signalCode; i++) await sleepMs(50);
      if (child.exitCode === null && !child.signalCode) { try { child.kill('SIGKILL'); } catch (e) { /* gone */ } }
      x.close();
    },
    on: (ev, fn) => { if (ev === 'close') child.on('exit', fn); },
  };
}

// Is a person in the viewer right now? The viewer's pidfile names x11vnc, and
// x11vnc is -once: alive means a person holds (or is about to hold) this display.
function viewerLive(profile) {
  let txt;
  try { txt = fs.readFileSync(path.join(profile, '.5dive-viewer'), 'utf8'); } catch (e) { return false; }
  const m = txt.match(/^vnc_pid=(\d+)$/m);
  if (!m) return false;
  try { process.kill(Number(m[1]), 0); return true; } catch (e) { return false; }
}

// ONE DRIVER AT A TIME (the row's rule 3), checked before EVERY input step, not
// once per request: a person who arrives mid-plan stops the next keystroke.
function inputRefusal(be, profile, req, where) {
  if (be.handoff) {
    return `${where}: the owner has this tab — handed over ${Math.round((Date.now() - be.handoff.since) / 1000)}s ago` +
      `${be.handoff.reason ? ` (${be.handoff.reason})` : ''}. The agent's input is suspended until they tap Done. ` +
      `Wait for them: 5dive browser handoff ${path.basename(profile)} --wait`;
  }
  if (viewerLive(profile)) {
    return `${where}: a person is in the viewer on this browser, so an agent's input is refused until they leave. ` +
      `Nothing was typed or clicked.`;
  }
  assertLease(req, where);
  return null;
}

// Hold until the page has stopped changing title for INPUT_QUIET_MS (see the
// constant for the measurement). Returns the ms it waited.
async function settled(be) {
  const t0 = Date.now(), cap = t0 + INPUT_QUIET_CAP_MS;
  for (;;) {
    const t = await be.x.windowTitle();
    if (t.window !== be.seen.title) { be.seen.title = t.window; be.seen.since = Date.now(); }
    const quiet = Date.now() - be.seen.since;
    if (quiet >= INPUT_QUIET_MS || Date.now() >= cap) return Date.now() - t0;
    await sleepMs(Math.min(100, INPUT_QUIET_MS - quiet));
  }
}

// Keys go to the focus window. Make it the browser's, confirmed, or throw:
// typing on regardless is how input used to vanish with rc=0.
async function keysReachBrowser(be) {
  await be.x.ensureBrowserFocus(be.child.pid, 2000);
}

// A click is delivered to the window under the pointer, whoever owns it. The
// point is checked AFTER the pointer is there (a window can open under it on
// the way) and BEFORE the button goes down; afterwards the browser must hold
// the keyboard focus, or the next step's keys would go nowhere.
async function pointerOnBrowser(be, what) {
  const under = await be.x.underPointer();
  if (!(await be.x.anyBrowser(under, be.child.pid))) {
    const p = await be.x.pointer();
    throw new Error(`nothing was ${what}: the point ${p.x},${p.y} is covered by a window that is not the browser ` +
      `(0x${(under[0] || 0).toString(16)}), so the input would land there instead`);
  }
}

async function clickInBrowser(be, s) {
  await be.x.move(s.x, s.y);
  await pointerOnBrowser(be, 'clicked');
  await be.x.click(s.x, s.y, { button: { left: 1, middle: 2, right: 3 }[s.button || 'left'], count: s.count || 1,
    steps: 0, from: { x: s.x, y: s.y } });
  let k;
  for (let i = 0; i < 20; i++) {
    // DIVE-5740: a click on an upload control opens the browser's file chooser,
    // and the focus falls to the root window. That is the click WORKING: give
    // the chooser the keyboard and say so, instead of calling the click lost.
    const dlg = await be.x.browserDialog(be.child.pid);
    if (dlg) {
      await be.x.focusOn(dlg.id, 2000, `the browser's "${dlg.name || 'dialog'}" window`);
      return { dialog: dlg.name || 'dialog' };
    }
    k = await be.x.keyboardTarget(be.child.pid);
    if (k.browser) return;
    // ...and a click that CLOSED one (its Open or Cancel) drops the focus to
    // the root window the same way. The click landed on the browser (checked
    // above), so hand the keyboard back to it, as a window manager would.
    if (k.focus === be.x.root) {
      try { await be.x.ensureBrowserFocus(be.child.pid, 1000); return; } catch (e) { /* reported below */ }
    }
    await sleepMs(50);
  }
  throw new Error(`the click at ${s.x},${s.y} was sent, but afterwards the keyboard focus is not on the browser ` +
    `(${k.focus === 0 ? 'no window' : k.focus === 1 ? 'the window under the pointer' : '0x' + k.focus.toString(16)}), ` +
    `so it may not have reached the page; stopping rather than typing into nothing`);
}

// DIVE-5740: an upload as a person does it. Click the page's upload control,
// let the browser's file chooser open, type the absolute path into it (ctrl+l
// opens its location field), Open (alt+o), and confirm the chooser CLOSED. A chooser
// still up means the path was not taken: Escape (or a window close, DIVE-6775),
// then drop the file on the same point (DIVE-6704), and fail by name if that
// does not take either, so nothing goes on to type into a dialog or a page by mistake.
async function uploadByChooser(be, s) {
  const pid = be.child.pid;
  if (await be.x.browserDialog(pid)) throw new Error('a file chooser is already open; finish or close it (press Escape) first');
  const r = await clickInBrowser(be, s);
  let dlg = r && r.dialog ? await be.x.browserDialog(pid) : null;
  for (let i = 0; !dlg && i < 50; i++) { await sleepMs(100); dlg = await be.x.browserDialog(pid); }
  if (!dlg) throw new Error(`no file chooser opened after the click at ${s.x},${s.y}: point the upload step at the page's upload button (take a shot first)`);
  // Paced the same with FIVEDIVE_BROWSER_INPUT_FAST: the waits are not a
  // person's, they are GTK's. Its location field completes the path from a
  // folder it reads in the background, and keys that outrun that read come out
  // of the field in a different order than they went in.
  await be.x.focusOn(dlg.id, 2000, `the "${dlg.name}" window`);
  await be.x.press('ctrl+l'); await sleepMs(300);
  await be.x.type(s.path, 20);
  await sleepMs(600);
  // OPEN, NOT RETURN. CI at f1a440c showed the path typed exactly right and
  // Return closing the chooser with "No file chosen". The field reports said
  // the same ("click Open: Return alone can close it with nothing attached").
  // alt+o is the chooser's own mnemonic for its Open button, so it is that
  // click without needing the button's position: with no window manager the
  // chooser can be taller than the screen, and Open is then cut off.
  // FIVEDIVE_BROWSER_CHOOSER_OPEN_KEY: another key for a box whose chooser
  // wants one; the harness sets a dead key to grade the drop below.
  await be.x.press(process.env.FIVEDIVE_BROWSER_CHOOSER_OPEN_KEY || 'alt+o');
  for (let i = 0; i < 50; i++) {
    await sleepMs(100);
    if (!(await be.x.browserDialog(pid))) {
      try { await be.x.ensureBrowserFocus(pid, 1000); } catch (e) { /* the next key step says so */ }
      return `the file chooser took ${s.path} and closed (check the shot: the page should now name the file)`;
    }
  }
  // DIVE-6704: A CHOOSER THAT WILL NOT TAKE THE PATH IS NOT THE END. chill-gorge's
  // (Chrome 154) showed the typed path in its field and stayed open on Open for
  // every path, while CI's passed. So the same file is dropped on the same
  // point: the upload control the step names takes a drop with no dialog.
  // Escape up to three times. One Escape left a real chooser open (Chrome 153,
  // the dev host's grade of L14): with the path's completion list up, the
  // first Escape can close only the list.
  // FIVEDIVE_BROWSER_CHOOSER_CLOSE_KEY: as the Open key above, for the harness.
  const closeKey = process.env.FIVEDIVE_BROWSER_CHOOSER_CLOSE_KEY || 'Escape';
  for (let k = 0; k < 3 && (await be.x.browserDialog(pid)); k++) {
    try { await be.x.focusOn(dlg.id, 1000, 'the file chooser'); await be.x.press(closeKey); } catch (e) { /* reported below */ }
    for (let i = 0; i < 10 && (await be.x.browserDialog(pid)); i++) await sleepMs(100);
  }
  // DIVE-6775: AND A CHOOSER THAT IGNORES ITS KEYS IS NOT THE END EITHER.
  // chill-gorge's took neither alt+o nor Escape, while a mouse click on its
  // Cancel closed it. So close it without a key: WM_DELETE_WINDOW is what a
  // window manager's close button sends, and GTK answers it as Cancel.
  // FIVEDIVE_BROWSER_CHOOSER_WINDOW_CLOSE=0 skips it: the harness's way to make
  // the chooser no close will shut, and grade the way out the error names.
  let how = 'Escape';
  if (process.env.FIVEDIVE_BROWSER_CHOOSER_WINDOW_CLOSE !== '0' && (await be.x.browserDialog(pid))) {
    how = 'a window close';
    try { await be.x.closeWindow(dlg.id); } catch (e) { /* reported below */ }
    for (let i = 0; i < 20 && (await be.x.browserDialog(pid)); i++) await sleepMs(100);
  }
  const what = `the file chooser did not take ${s.path} (still open after Open)`;
  if (await be.x.browserDialog(pid)) {
    const c = await chooserCancelPoint(be, dlg.id);
    throw new Error(`${what}, and it would not close on Escape or a window close; nothing was attached. ` +
      `Click its Cancel${c ? ` at about ${c.x},${c.y}` : ' (bottom right, left of Open)'} with a click step, then drop the file instead`);
  }
  try { await be.x.ensureBrowserFocus(pid, 1000); } catch (e) { /* the drop checks the pointer itself */ }
  try {
    return `${what}, so it was closed (${how}) and the file ${await dropOnPage(be, s)}`;
  } catch (e) {
    throw new Error(`${what}; it was closed (${how}), and dropping the file on ${s.x},${s.y} instead failed too: ${e.message}`);
  }
}

// Where a GTK chooser's Cancel sits, for a person to click: bottom right, left
// of Open, about 217 by 30 px in from that corner (chill-gorge's 1124x822 had
// it at 985,792), and never past the screen's edge. A guess to name, not to click.
async function chooserCancelPoint(be, win) {
  try {
    const g = await be.x.geometry(win), sc = { w: be.x.width, h: be.x.height };
    return { x: Math.max(0, Math.min(sc.w - 1, g.x + g.w - 217)), y: Math.max(0, Math.min(sc.h - 1, g.y + g.h - 30)) };
  } catch (e) { return null; }
}

// DIVE-6704: a file DROPPED on the page, the way a person drags one in from a
// file manager (lib/x11.cjs dropFile: XDND). There is no chooser, so nothing
// rests on GTK taking a typed path. Whatever is at the point gets the drop: an
// <input type=file> takes the file, a site's drop area uploads it. A point that
// is neither makes Chrome OPEN the file in the tab instead; the title says so,
// and that is said by name rather than called a success.
async function dropOnPage(be, s) {
  const pid = be.child.pid;
  if (await be.x.browserDialog(pid)) throw new Error('a file chooser is open; close it (press Escape) before dropping a file');
  await be.x.move(s.x, s.y);
  await pointerOnBrowser(be, 'dropped');
  const before = (await be.x.windowTitle()).page;
  const r = await be.x.dropFile(s.x, s.y, s.path, pid);
  await sleepMs(500);
  const after = (await be.x.windowTitle()).page, base = path.basename(s.path);
  if (after !== before && (after === base || after === s.path || after.startsWith('file://'))) {
    throw new Error(`the point ${s.x},${s.y} is not an upload control or a drop area, so the browser opened ${base} ` +
      'in the tab instead of attaching it (go back with alt+Left, then point at the upload control or drop area)');
  }
  try { await be.x.ensureBrowserFocus(pid, 1000); } catch (e) { /* the next key step says so */ }
  return r.finished
    ? `was dropped at ${s.x},${s.y} and the browser took it (check the shot: the page should now name the file)`
    : `was dropped at ${s.x},${s.y}; the browser did not confirm it (check the shot: the page should name the file)`;
}

async function gotoByKeys(be, url) {
  // As a person does it: focus the address bar, type, Enter. isTrusted keys all
  // the way; the page sees a navigation typed by a person, not a script's goto.
  const x = be.x;
  await settled(be);
  await keysReachBrowser(be);
  await x.press('ctrl+l'); await sleepMs(150);
  await x.type(url, process.env.FIVEDIVE_BROWSER_INPUT_FAST === '1' ? 0 : 12);
  await sleepMs(80);
  await x.press('Return');
}

// Type <url> and wait for it to load: at least <minMs>, then until the title is
// no longer the address (at most INPUT_LOAD_WAIT_MS), then the quiet gate. The
// title is read only after this, so a refused or challenge title is matched on
// the page, not on the address Chrome shows while it loads (DIVE-7572).
async function gotoLoaded(be, url, minMs) {
  await gotoByKeys(be, url);
  return pageLoad.untilLoaded(async () => (await be.x.windowTitle()).page, () => settled(be),
    { url, minMs, maxMs: Math.max(minMs, INPUT_LOAD_WAIT_MS), pollMs: 100, sleep: sleepMs });
}
const notLoadedMsg = (site, ld) =>
  `NOT LOADED: the ${site} page did not finish loading within ${Math.round(ld.waited_ms / 1000)}s: its title is still ` +
  `its address ("${ld.title}"), so nothing on it was read as the page. The screenshot shows how far it got. ` +
  `Try again; if it never loads, the site or the connection is not answering this browser.`;

async function screenOf(be) {
  const png = await be.x.screenshotPNG();
  const t = await be.x.windowTitle();
  // A popup window of the browser on top (DIVE-7680) is the page the input goes
  // to, so the report names it: its title is the one the hard stops read.
  const pw = await be.x.browserPopup(be.child.pid).catch(() => null);
  return { drive: 'input', title: pw ? pw.page : t.page, window_title: pw ? pw.name : t.window,
    ...(pw ? { popup_window: pw.page || pw.name, opener_title: t.page } : {}),
    width: be.x.width, height: be.x.height, png_b64: png.toString('base64') };
}

const INPUT_STEPS = {
  click:  (s) => num(s.x) && num(s.y) && (s.button === undefined || ['left', 'middle', 'right'].includes(s.button))
                 && (s.count === undefined || [1, 2, 3].includes(s.count)),
  move:   (s) => num(s.x) && num(s.y),
  type:   (s) => typeof s.value === 'string' && s.value.length > 0 && s.value.length <= INPUT_MAX_TEXT,
  paste:  (s) => typeof s.value === 'string' && s.value.length > 0 && Buffer.byteLength(s.value) <= 200000,
  press:  (s) => typeof s.key === 'string' && /^[A-Za-z0-9+_ -]{1,40}$|^.$/u.test(s.key),
  scroll: (s) => (s.dy === undefined || (Number.isInteger(s.dy) && Math.abs(s.dy) <= 50))
                 && (s.dx === undefined || (Number.isInteger(s.dx) && Math.abs(s.dx) <= 50))
                 && (s.dy !== undefined || s.dx !== undefined),
  goto:   (s) => typeof s.url === 'string' && /^https?:\/\/[^\s]+$/.test(s.url) && s.url.length <= 2000,
  wait:   (s) => Number.isInteger(s.ms) && s.ms >= 0 && s.ms <= INPUT_MAX_WAIT_MS,
  upload: (s) => num(s.x) && num(s.y) && typeof s.path === 'string' && /^\/[^\n\r\0]{1,4095}$/.test(s.path),
  drop:   (s) => num(s.x) && num(s.y) && typeof s.path === 'string' && /^\/[^\n\r\0]{1,4095}$/.test(s.path),
};
function num(v) { return Number.isInteger(v) && v >= 0 && v < 10000; }
const INPUT_VOCAB = 'click{x,y[,button,count]} move{x,y} type{value} paste{value} press{key} scroll{dy[,dx,x,y]} goto{url} wait{ms} upload{x,y,path} drop{x,y,path}';

async function inputRequest(be, profile, req, send, end, behalf) {
  const site = path.basename(profile);
  const reChallenge = reOf(req.challenge);
  // DIVE-7528: a site's own error page, served instead of the page (Amazon's
  // "ご迷惑をおかけしています！"). A stop like a challenge, but there is nothing on
  // it for a person to clear, so it must not send anyone to a handoff.
  const reRefused = reOf(req.refused);
  const stopOf = (title, lead, tail) => {
    if (reRefused && reRefused.test(title))
      return { rc: E_SITE_REFUSED, msg: `REFUSED${lead}: ${site} served its own error page ("${title}") instead of the page you asked for. This is the site refusing this browser, not a security check: there is nothing on it for a person to clear, so a handoff will not help.${tail}` };
    if (reChallenge && reChallenge.test(title))
      return { rc: 75, msg: `CHALLENGE${lead}: the page title is "${title}", which is a security check.${tail} Try it like a person first (tick its box, or wait and look again); a person clears it only if it stays, or if the owner gated it: 5dive browser handoff ${site}` };
    return null;
  };
  const out = (o) => send({ t: 'out', data: JSON.stringify(o) + '\n' });

  if (req.op === 'hand') {
    const act = req.act;
    if (act === 'open') {
      if (!be.handoff) {
        be.handoff = { since: Date.now(), by: behalf || 'owner',
          reason: String(req.reason || '').replace(/[\x00-\x1f\x7f]/g, ' ').slice(0, 200) };
      }
    } else if (act === 'close') {
      be.handoff = null;
    } else if (act !== 'status') {
      send({ t: 'err', msg: `hand act must be open, close or status; got '${act}'` }); return end(E_NOTHING_RAN);
    }
    const t = await be.x.windowTitle().catch(() => ({ page: '', window: '' }));
    out({ open: !!be.handoff, since: be.handoff ? new Date(be.handoff.since).toISOString() : null,
      by: be.handoff ? be.handoff.by : null, reason: be.handoff ? be.handoff.reason : null,
      viewer: viewerLive(profile), title: t.page });
    return end(0);
  }

  if (req.op === 'title') {
    const t = await be.x.windowTitle();
    // `focused`: the browser holds the keyboard (explicit X focus, confirmed).
    // `quiet_ms`: how long the title has been unchanged — input is held until
    // it reaches INPUT_QUIET_MS. Together they are the readiness input waits on.
    const k = await be.x.keyboardTarget(be.child.pid).catch(() => ({ browser: 0 }));
    out({ drive: 'input', title: t.page, window_title: t.window, handoff: !!be.handoff, viewer: viewerLive(profile),
      focused: !!k.browser, quiet_ms: t.window === be.seen.title ? Date.now() - be.seen.since : 0 });
    return end(0);
  }

  // THE LOGIN CHECK, IN A TAB OF ITS OWN (DIVE-5388). bin/browser's probe asks
  // only when nobody is driving; a person or a handoff that arrived since is
  // re-checked here, before a key is pressed. New tab, the probe URL typed into
  // it as a person would, the title read once it settles, the tab closed. The
  // tab is closed only when it is provably OURS — the window title changed when
  // Ctrl+T was pressed, and no person or handoff has arrived since — because
  // Ctrl+W on the last tab of the person's window would close Chrome. A tab
  // left open is the safe failure. Classification is the
  // caller's: this only reports the title.
  if (req.op === 'title_probe') {
    const skip = (why) => { out({ drive: 'input', navigated: false, why, title: '' }); return end(0); };
    if (!INPUT_STEPS.goto({ url: req.url })) { send({ t: 'err', msg: 'title_probe needs an http(s) url' }); return end(E_NOTHING_RAN); }
    if (be.handoff) return skip('the owner has the window (handoff)');
    if (viewerLive(profile)) return skip('a person is in the viewer');
    try {
      await settled(be);
      await keysReachBrowser(be);
      const before = (await be.x.windowTitle()).window;
      await be.x.press('ctrl+t');
      let opened = false;
      for (let i = 0; i < 20 && !opened; i++) { await sleepMs(100); opened = (await be.x.windowTitle()).window !== before; }
      if (!opened) return skip('no new tab opened, so nothing was loaded');
      // DIVE-7572: the title once the page has LOADED, not the address Chrome
      // shows while it loads. Classification stays the caller's; `loaded` says
      // whether the title is the page's own.
      const ld = await gotoLoaded(be, req.url,
        Number.isFinite(Number(req.wait)) && req.wait !== undefined ? Math.min(Number(req.wait), INPUT_MAX_WAIT_MS) : INPUT_GOTO_SETTLE_MS);
      const t = await be.x.windowTitle();
      if (!viewerLive(profile) && !be.handoff) {
        await keysReachBrowser(be);
        await be.x.press('ctrl+w');
        await sleepMs(150);
      }
      out({ drive: 'input', navigated: true, loaded: ld.loaded, url_requested: req.url, title: t.page, window_title: t.window });
      return end(0);
    } catch (e) {
      send({ t: 'err', msg: `could not check ${site} in a tab of its own: ${e.message}` }); return end(E_FAILED);
    }
  }

  // THE CLIPBOARD, FOR A KEY A SITE SHOWS ONLY AS A COPY BUTTON (DIVE-7171).
  // Read and cleared by the X client, answered to the lease holder only, and
  // refused while a person is in the window: then it may hold what THEY copied.
  // bin/browser pipes the text into the secret store and never prints it.
  if (req.op === 'clipboard') {
    const no = inputRefusal(be, profile, req, 'clipboard');
    if (no) { send({ t: 'err', msg: no }); return end(E_UNAVAILABLE); }
    let got;
    try { got = await be.x.readClipboard(); }
    catch (e) { send({ t: 'err', msg: `could not read the ${site} window's clipboard: ${e.message}` }); return end(E_FAILED); }
    if (got.text.length > INPUT_MAX_TEXT) {
      send({ t: 'err', msg: `the ${site} window's clipboard held ${got.text.length} characters, more than a key (${INPUT_MAX_TEXT} at most). It was cleared; nothing was sent.` });
      return end(E_NOTHING_RAN);
    }
    out({ drive: 'input', chars: got.text.length, cleared: got.cleared, text: got.text });
    return end(0);
  }

  if (req.op === 'screen') {
    let ld = null;
    try {
      if (req.url) {
        if (!INPUT_STEPS.goto({ url: req.url })) { send({ t: 'err', msg: 'screen --url needs an http(s) url' }); return end(E_NOTHING_RAN); }
        const no = inputRefusal(be, profile, req, 'screen');
        if (no) { send({ t: 'err', msg: no }); return end(E_UNAVAILABLE); }
        be.lastHost = frontTab.hostOf(req.url);
        ld = await gotoLoaded(be, req.url,
          Number.isFinite(Number(req.wait)) && req.wait !== undefined ? Math.min(Number(req.wait), INPUT_MAX_WAIT_MS) : INPUT_GOTO_SETTLE_MS);
      } else if (Number(req.wait) > 0) await sleepMs(Math.min(Number(req.wait), INPUT_MAX_WAIT_MS));
      const shot = await screenOf(be);
      if (ld && !ld.loaded) {
        // A refused title that showed up in the last instant still wins: it is the answer.
        const late = stopOf(shot.title, '', '');
        out({ ...shot, url_requested: req.url, handoff: !!be.handoff, viewer: viewerLive(profile),
              ...(late && late.rc === E_SITE_REFUSED ? { refused: true } : { loaded: false }) });
        if (late) { send({ t: 'err', msg: late.msg }); return end(late.rc); }
        send({ t: 'err', msg: notLoadedMsg(site, { ...ld, title: shot.title }) }); return end(E_NOT_LOADED);
      }
      const stop = stopOf(shot.title, '', '');
      out({ ...shot, url_requested: req.url || null, handoff: !!be.handoff, viewer: viewerLive(profile),
            ...(stop && stop.rc === E_SITE_REFUSED ? { refused: true } : {}) });
      if (stop) { send({ t: 'err', msg: stop.msg }); return end(stop.rc); }
      return end(0);
    } catch (e) {
      send({ t: 'err', msg: `could not read the ${site} screen: ${e.message}` }); return end(E_FAILED);
    }
  }

  if (req.op === 'input') {
    const steps = Array.isArray(req.steps) ? req.steps : null;
    if (!steps || !steps.length) { send({ t: 'err', msg: 'the input plan carries no steps' }); return end(E_NOTHING_RAN); }
    if (steps.length > INPUT_MAX_STEPS) { send({ t: 'err', msg: `at most ${INPUT_MAX_STEPS} input steps per call` }); return end(E_NOTHING_RAN); }
    for (let i = 0; i < steps.length; i++) {
      const s = steps[i] || {};
      const ok = INPUT_STEPS[s.op];
      if (!ok || !ok(s)) {
        send({ t: 'err', msg: `step ${i + 1} ${ok ? `(${s.op}) has missing or out-of-range fields` : `uses '${s.op}', which is not an input-mode step`}. ` +
          `Input mode takes: ${INPUT_VOCAB} — coordinates are pixels of the ${be.x.width}x${be.x.height} screenshot. Nothing ran.` });
        return end(E_NOTHING_RAN);
      }
      if ((s.op === 'click' || s.op === 'upload' || s.op === 'drop' || s.op === 'move' || (s.op === 'scroll' && s.x !== undefined)) &&
          ((s.x !== undefined && s.x >= be.x.width) || (s.y !== undefined && s.y >= be.x.height))) {
        send({ t: 'err', msg: `step ${i + 1} (${s.op}) points at ${s.x},${s.y}, outside the ${be.x.width}x${be.x.height} screen. Nothing ran.` });
        return end(E_NOTHING_RAN);
      }
    }
    let ran = 0;
    try {
      for (let i = 0; i < steps.length; i++) {
        const s = steps[i], where = `step ${i + 1} (${s.op})`;
        const no = inputRefusal(be, profile, req, where);
        if (no) throw Object.assign(new Error(no), { refused: true });
        // Every step waits for a quiet page, so a step after one that
        // navigated does not type into a page still coming up. Cheap when the
        // page is quiet already: one title read.
        if (s.op !== 'wait') await settled(be);
        ran++;
        try {
          switch (s.op) {
            case 'click': {
              const r = await clickInBrowser(be, s);
              if (r && r.dialog) send({ t: 'log', line: `  ${where}: the browser opened its "${r.dialog}" window, which now has the keyboard (a file chooser: type the file's absolute path and press alt+o (Open; Return can close it with nothing attached), or use an upload{x,y,path} step, or drop{x,y,path} onto the page instead)` });
              // A click that opened a popup window (DIVE-7680): it takes the keys
              // from here until it closes, and the output says so.
              else {
                const pw = await be.x.browserPopup(be.child.pid).catch(() => null);
                if (pw && pw.id !== be.popupWin) {
                  be.popupWin = pw.id;
                  try { await be.x.focusOn(pw.id, 2000, `the browser's popup window "${pw.page || pw.name}"`); } catch (e) { /* the next key step says so */ }
                  send({ t: 'log', line: `  ${where}: a popup window opened: "${pw.page || pw.name}". It is on top and now has the keyboard; the steps after this type into it, and when it closes the page under it has the keyboard again.` });
                } else if (!pw) be.popupWin = 0;
              }
              break;
            }
            case 'upload': send({ t: 'log', line: `  ${where}: ${await uploadByChooser(be, s)}` }); break;
            case 'drop': send({ t: 'log', line: `  ${where}: the file ${await dropOnPage(be, s)}` }); break;
            case 'move': await be.x.move(s.x, s.y); break;
            case 'type': await keysReachBrowser(be); await be.x.type(s.value); break;
            // DIVE-7237: code, or any long text, goes in whole (a code editor rewrites typed keys).
            case 'paste': {
              await keysReachBrowser(be);
              const r = await be.x.paste(s.value);
              if (!r.served) throw new Error('ctrl+v was pressed but the browser never read the clipboard: click into the text field first. Nothing was pasted');
              break;
            }
            case 'press': await keysReachBrowser(be); await be.x.press(s.key); break;
            case 'scroll':
              if (s.x !== undefined) await be.x.move(s.x, s.y);
              await pointerOnBrowser(be, 'scrolled');   // wheel notches go to the window under the pointer, too
              await be.x.scroll(s.dy || 0, s.dx || 0, null); break;
            case 'goto': {
              be.lastHost = frontTab.hostOf(s.url);
              const ld = await gotoLoaded(be, s.url, INPUT_GOTO_SETTLE_MS);
              // A refused/challenge title is the hard stop's to name, below.
              if (!ld.loaded && !stopOf(ld.title, '', '')) throw new Error(notLoadedMsg(site, ld) + ' Stopped; the rest of the plan did not run.');
              break;
            }
            case 'wait': await sleepMs(s.ms); break;
          }
        } catch (e) { e.message = `${where}: ${e.message}`; throw e; }
        send({ t: 'log', line: `  ${where} ok` });
        // THE HARD STOP, between steps: a plan does not keep typing into a
        // challenge that appeared under it.
        if (reChallenge || reRefused) {
          const t = await be.x.windowTitle();
          const stop = stopOf(t.page, ` after ${where}`, ' Stopped; the rest of the plan did not run.');
          if (stop) {
            await sleepMs(300);
            out({ ...(await screenOf(be)), act_report: true, steps_run: ran, ...(stop.rc === E_SITE_REFUSED ? { refused: true } : {}) });
            send({ t: 'err', msg: stop.msg });
            return end(stop.rc);
          }
        }
      }
    } catch (e) {
      send({ t: 'err', msg: e.message });
      if (!ran) {
        send({ t: 'err', msg: 'not one input step ran, so nothing was typed or clicked.' });
        return end(e.refused ? E_UNAVAILABLE : E_NOTHING_RAN);
      }
      try { out({ ...(await screenOf(be)), act_report: true, steps_run: ran }); } catch (e2) { /* the report is best effort */ }
      return end(E_FAILED);
    }
    const ms = Number.isFinite(Number(req.settle)) && req.settle !== undefined ? Number(req.settle) : INPUT_SETTLE_MS;
    if (ms > 0) await sleepMs(Math.min(ms, INPUT_MAX_WAIT_MS));
    const shot = await screenOf(be);
    const stop = stopOf(shot.title, ' (the page the steps left)', '');
    out({ ...shot, act_report: true, steps_run: ran, ...(stop && stop.rc === E_SITE_REFUSED ? { refused: true } : {}) });
    if (stop) { send({ t: 'err', msg: stop.msg }); return end(stop.rc); }
    return end(0);
  }

  // THE DOM OPS, REFUSED BY NAME. This browser has no channel into the page —
  // that is the point of it — so an answer here would be an invention.
  const instead = {
    probe: 'the login state is read from the window title here, not a DOM probe',
    tree: 'there is no DOM tree to enumerate: read the screenshot (`5dive browser shot`) and act on pixel coordinates',
    snapshot: '`5dive browser snapshot` on an input-mode site returns the screenshot and the window title, not a DOM',
    render: '`5dive browser shot` on an input-mode site returns a screenshot of the live window',
    download: 'this browser has no request client to fetch a file with; a file the page downloads lands in the browser\'s own download folder',
    plan: 'adapter actions address the page by selector, and input mode has no DOM to resolve a selector in: use `5dive browser act <site> --steps=` with input steps (' + INPUT_VOCAB + ')',
  }[req.op];
  send({ t: 'err', msg: instead
    ? `${site} is served in INPUT mode (plain Chrome, no automation channel), so '${req.op}' cannot run here: ${instead}.`
    : `unknown op '${req.op}'` });
  return end(E_NOTHING_RAN);
}

function callMode(sock) {
  const raw = fs.readFileSync(0, 'utf8');
  let req;
  try { req = JSON.parse(raw); } catch (e) { die(E_NOTHING_RAN, `the request on stdin is not JSON: ${e.message}`); }
  const conn = net.createConnection(sock);
  // ONLY THE NEW BYTES ARE SEARCHED FOR THE LINE'S END (DIVE-7303). The reply was
  // one string that every chunk was appended to and searched from its start, so a
  // multi-megabyte answer (a results page of 1,211 refs) cost the square of its
  // size: 90% CPU in this client for 150-220 s on the bench, while the browser
  // had answered in seconds. The pieces are kept as bytes and joined once per
  // line, which also never cuts a character that spans two chunks.
  let parts = [], ended = false;
  conn.on('connect', () => conn.write(JSON.stringify(req) + '\n'));
  conn.on('error', (e) => die(E_UNAVAILABLE, `no live session at ${sock}: ${e.message}`));
  conn.on('data', (d) => {
    let from = 0, nl;
    while ((nl = d.indexOf(10, from)) >= 0) {
      parts.push(d.subarray(from, nl)); from = nl + 1;
      const line = Buffer.concat(parts).toString('utf8'); parts = [];
      if (!line) continue;
      let f; try { f = JSON.parse(line); } catch (e) { continue; }
      if (f.t === 'log') process.stderr.write(f.line + '\n');
      else if (f.t === 'err') process.stderr.write(`${PROG}: ${f.msg}\n`);
      else if (f.t === 'out') process.stdout.write(f.data);
      // NEVER `process.exit` HERE (DIVE-4794). stdout is a PIPE for every caller
      // that reads us — bin/browser runs this inside `$( … )` — and a pipe write
      // over the OS buffer (~64 KB) is queued, not done. `process.exit` drops
      // whatever is still queued, so a brokered `read` or `render` of a real
      // page came back CUT: the caller's jq said `parse error: Unfinished string
      // at EOF` and the verb died on a capture that had actually succeeded.
      // Measured on a box 2026-09-21; invisible to any test whose payload fits
      // in the buffer. Setting the code and ending the socket lets node flush
      // and exit on its own, which is the only exit that cannot truncate.
      else if (f.t === 'end') { ended = true; process.exitCode = f.rc; conn.end(); }
    }
    if (from < d.length) parts.push(d.subarray(from));
  });
  // A DAEMON THAT DIES MID-REQUEST IS NOT A ZERO. Without this the socket simply
  // closes and node exits 0 — a publish whose browser crashed would read as a
  // clean run, and bin/browser would re-read the verify URL and report whatever
  // was already there.
  conn.on('close', () => { if (!ended) die(E_FAILED, 'the session daemon closed the connection without a verdict — the browser holding this profile is gone. Whatever steps already ran are still real.'); });
}

function main() {
  const [, , mode, arg] = process.argv;
  if (mode === 'serve') {
    const profile = arg;
    const rest = process.argv.slice(4);
    // --broker IS PASSED, NOT INFERRED from the socket's path. The rule it turns
    // on is a security rule, and a security rule that keys on a string
    // comparison is one rename away from being silently off.
    const broker = rest.includes('--broker');
    const input = rest.includes('--input');
    const sock = rest.filter(a => a !== '--broker' && a !== '--input')[0] || path.join(profile || '', '.5dive-session.sock');
    return serveMode(profile, sock, broker, input).catch(e => die(E_UNAVAILABLE, e && e.message ? e.message : String(e)));
  }
  if (mode === 'call') {
    if (!arg) die(E_USAGE_MISSING, 'call needs a socket path');
    return callMode(arg);
  }
  die(64, 'usage: session-daemon serve <profile> [<socket>] [--broker] [--input] | session-daemon call <socket>');
}
const E_USAGE_MISSING = 64;
main();
