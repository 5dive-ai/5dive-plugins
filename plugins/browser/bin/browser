#!/usr/bin/env bash
# `5dive browser` — DIVE-4021. A plugin VERB (contract §2), found by convention at
# <installed-plugin-dir>/bin/browser. The manifest names it and nothing else.
#
# THE MODEL, in one line: the user logs into a site ONCE, by hand, in a browser
# profile dedicated to that site; the agent is granted the SESSION, never the
# credentials. What it then does inside that session is decided by a deterministic
# adapter, not by a model looking at a page.
#
# THREE THINGS THIS FILE REFUSES TO DO, each because the alternative is how a
# half-written draft reaches a real account:
#
#   1. It never types a password. `auth` hands a browser to a human and exits.
#   2. It never improvises. An adapter step outside the fixed vocabulary below is
#      a load-time refusal, not a "best effort" — see _adapter_validate.
#   3. It never grades its own homework. `run` exits on the OUT-OF-BAND verify
#      (a separate fetch of the permalink), not on whether the driver's clicks
#      appeared to land. A DOM assertion on the page you just acted on cannot
#      tell "published" from "published a draft", and cannot tell "failed" from
#      "succeeded and reported failed" — and that second one double-posts on
#      retry.
set -uo pipefail

PROG="5dive browser"
STATE_DIR="${STATE_DIR:-/var/lib/5dive}"
PROFILE_ROOT="${FIVEDIVE_BROWSER_PROFILE_ROOT:-$STATE_DIR/browser-profiles}"
SETUP_CMD="sudo 5dive browser setup"
# WHERE AN ADAPTER LIVES, and why it is not one directory (DIVE-4524).
#
# It used to be exactly one: the `adapters/` folder inside the plugin package.
# That directory is REPLACED WHOLESALE by `5dive plugin upgrade` — measured
# 2026-09-14: a hand-written adapters/reddit.com.json was there before the
# upgrade and gone after, and `status reddit.com` went `authenticated` ->
# `UNKNOWN (no adapter)` with nothing else changed. An adapter is a customer's
# own data about their own site; a product that eats it on upgrade is a product
# that silently un-classifies a live session.
#
# So there are two, searched in order:
#   1. $PROFILE_ROOT/<seat>/.adapters  — the SEAT's own, next to the profiles it
#      describes. Already root-created and 0700-audited, on a path no package
#      upgrade touches. A leading dot keeps it out of the `*/` glob that
#      enumerates sites, and `_valid_site` forbids a leading dot, so it can never
#      collide with a real profile name.
#   2. the package's adapters/       — what 5dive ships, a read-only fallback.
# FIVEDIVE_BROWSER_ADAPTER_DIR overrides BOTH and is then the only one searched:
# an explicit override that silently still read two other places would be worse
# than no override at all.
_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ADAPTER_PKG_DIR="$(cd "$_SELF_DIR/.." && pwd)/adapters"
ADAPTER_SEAT_SUBDIR=".adapters"
READ_EXTRACTOR="${FIVEDIVE_BROWSER_EXTRACTOR:-$(cd "$_SELF_DIR/.." && pwd)/lib/extract.bundle.cjs}"
SYSTEMD_DIR="${FIVEDIVE_BROWSER_SYSTEMD_DIR:-/etc/systemd/system}"
SYSTEMCTL="${FIVEDIVE_BROWSER_SYSTEMCTL:-systemctl}"

E_USAGE=64; E_UNAVAILABLE=69; E_PERM=77; E_COLD=75

die() { printf '%s: %s\n' "$PROG" "$2" >&2; exit "$1"; }

# The calling seat. SUDO_USER first: under `sudo 5dive browser setup` the profile
# must belong to the human/seat that asked, never to root.
_seat() { echo "${SUDO_USER:-${USER:-$(id -un)}}"; }

usage() {
  cat <<'USAGE'
5dive browser — operate a site as yourself, in a profile you logged into by hand

  5dive browser setup                 # one-time, as root: create the profile store
  5dive browser auth <site>           # open a browser; log in yourself, once
  5dive browser status [site]         # per-site auth state (run on a SCHEDULE)
  5dive browser probe-all             # scheduled check; skips profiles in use
  5dive browser ls                    # profiles, and when each was last seen alive

  On a managed box there is no display, so the browser lives on one:
  5dive browser serve <site>          # persistent Chrome on its own Xvfb (server mode)
  5dive browser serve <site> --stop   # stop the browser; the profile survives
  5dive browser viewer <site> --bind=<session> [--ttl=600]
                                      # mint a ONE-TIME, expiring link a person logs in through
  5dive browser viewer-redeem <site> --nonce=- --session=<id>
                                      # the relay's gate: consumes the link, prints the loopback target
  5dive browser viewer-revoke <site>  # kill the view; the browser stays logged in

  5dive browser doc [--append=<file>]
                                      # print the agent-facing workflow doc (any harness),
                                      # or install it into a seat's AGENTS.md / CLAUDE.md

  A security challenge (CAPTCHA, 2FA, "unusual activity") is a HARD STOP that asks
  for a person. 5dive does not attempt to solve one. What this is: persistent
  human-authenticated sessions — not anti-bot bypassing.
  5dive browser run <site> <action> [--key=value ...]
                                      # execute an adapter action, deterministically,
                                      # inside the logged-in profile. The verdict is an
                                      # out-of-band re-read of the artifact, never the
                                      # executor's exit status.
  5dive browser shot <site> <url> [--out=<png>] [--dom=<file>] [--size=WxH|--full]
                                      # render a page INSIDE the logged-in profile:
                                      # a PNG (and the DOM) of what you would see.
                                      # Refuses unless the session probes authenticated —
                                      # a screenshot of a sign-in page is a lie that
                                      # looks exactly like evidence.
  5dive browser read <site> <url> [--out=<dir>] [--json]
                                      # one authenticated render -> page.md,
                                      # page.html and page.meta.json
  5dive browser links <site> <url> [--out=<dir>]
                                      # same evidence triple; print article links only

  A profile is a credential. Anything that can READ the directory can replay the
  session, whatever permission model sits above it — so each profile is owned by
  one seat, mode 0700, and every command here re-checks that and fails closed.

  <site> IS THE HOST: `linkedin.com`, `reddit.com`. That is the name the dashboard
  passes and the name the profile directory takes, and a name with a dot in it is
  used verbatim. A bare label (`linkedin`) is a different profile and is guessed
  as <label>.com, which is a guess and not the contract.
USAGE
}

# ---------------------------------------------------------------- profile store
#
# LAYOUT, and the reasoning is the part worth keeping: $STATE_DIR/browser-profiles
# (root, 0711) / <seat> (that seat's user, 0700) / <site>.
#
# 0711 on the parent is traverse-but-not-list: a seat reaches its own subtree and
# cannot enumerate anyone else's. It also means a seat CANNOT create its own dir
# there, which is deliberate — the alternative is a world-writable parent, and on
# a world-writable parent a hostile seat pre-creates `mkdir browser-profiles/dev`,
# owns it, and every profile `dev` later authenticates lands in a directory that
# seat can read. That is not a theoretical squat; it is the whole credential.
# So creation is a root act, once, and every later run AUDITS instead of trusting.
_seat_dir() { echo "$PROFILE_ROOT/$(_seat)"; }
_site_dir() { echo "$(_seat_dir)/$1"; }

# The search path, most-local first. Printed one per line so every caller reads
# the SAME order and there is one place it can drift.
_adapter_dirs() {
  if [[ -n "${FIVEDIVE_BROWSER_ADAPTER_DIR:-}" ]]; then
    printf '%s\n' "$FIVEDIVE_BROWSER_ADAPTER_DIR"; return 0
  fi
  printf '%s\n' "$(_seat_dir)/$ADAPTER_SEAT_SUBDIR"
  printf '%s\n' "$ADAPTER_PKG_DIR"
}
# The file for a site: the first that EXISTS, else where one should be WRITTEN.
# Both answers matter — the second is what every "no adapter" message names, and
# naming the read-only package directory there is how a customer's hand-written
# adapter came to be in the place an upgrade deletes.
_adapter_path() {
  local d
  while IFS= read -r d; do
    [[ -f "$d/$1.json" ]] && { printf '%s\n' "$d/$1.json"; return 0; }
  done < <(_adapter_dirs)
  printf '%s\n' "$(_adapter_dirs | head -1)/$1.json"
}

_valid_site() {
  # A site name becomes a directory name. Keep it to a shape that cannot traverse.
  [[ "$1" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ && "$1" != *..* ]]
}

# FAIL CLOSED, and note it audits the SEAT dir, not just the site dir: a correct
# 0700 site dir inside a group-writable seat dir is still readable by whoever owns
# the seat dir. Both, every time, before any profile path is handed to a browser.
_audit() {
  local d="$1" want_mode="$2" me; me=$(id -u)
  [[ -d "$d" ]] || return 1
  local owner mode
  owner=$(stat -c '%u' "$d") || return 1
  mode=$(stat -c '%a' "$d") || return 1
  [[ "$owner" == "$me" ]] || die "$E_PERM" "$d is owned by uid $owner, not by you (uid $me) — refusing to use it as a profile store. Someone else can read that session."
  [[ "$mode" == "$want_mode" ]] || die "$E_PERM" "$d is mode $mode, want $want_mode — refusing. Anything that can read a profile directory can replay the session."
  return 0
}

_require_store() {
  [[ -d "$PROFILE_ROOT" ]] || die "$E_UNAVAILABLE" "no profile store at $PROFILE_ROOT. 5dive does not create it behind your back: $SETUP_CMD"
  _audit "$(_seat_dir)" 700 || die "$E_UNAVAILABLE" "no profile directory for seat '$(_seat)' at $(_seat_dir). Create it once: $SETUP_CMD"
}

_ensure_profile_dir() {
  local d="$1"
  if [[ -d "$d" ]]; then
    _audit "$d" 700          # existed: grade it, do not launder it
  else
    mkdir -p "$d"; chmod 00700 "$d"; _audit "$d" 700
  fi
}

_install_probe_timer() {
  local seat="$1" five unit timer
  five=$(command -v 5dive 2>/dev/null || true)
  [[ "$five" == /* ]] || five=/usr/local/bin/5dive
  unit="$SYSTEMD_DIR/5dive-browser-probe@.service"
  timer="$SYSTEMD_DIR/5dive-browser-probe@.timer"
  mkdir -p "$SYSTEMD_DIR" || die "$E_UNAVAILABLE" "cannot create $SYSTEMD_DIR for the browser liveness timer"

  local staged_unit staged_timer
  staged_unit=$(mktemp "$SYSTEMD_DIR/.5dive-browser-probe.service.XXXXXX") \
    || die "$E_UNAVAILABLE" "cannot stage the browser liveness service"
  staged_timer=$(mktemp "$SYSTEMD_DIR/.5dive-browser-probe.timer.XXXXXX") \
    || { rm -f "$staged_unit"; die "$E_UNAVAILABLE" "cannot stage the browser liveness timer"; }
  cat >"$staged_unit" <<EOF
[Unit]
Description=Probe 5dive browser profiles for %i

[Service]
Type=oneshot
User=%i
ExecStart=$five browser probe-all
EOF
  cat >"$staged_timer" <<'EOF'
[Unit]
Description=Probe 5dive browser profiles every six hours

[Timer]
OnBootSec=15m
OnUnitActiveSec=6h
RandomizedDelaySec=30m
Persistent=true
Unit=5dive-browser-probe@%i.service

[Install]
WantedBy=timers.target
EOF
  chmod 00644 "$staged_unit" "$staged_timer"
  mv "$staged_unit" "$unit" && mv "$staged_timer" "$timer" \
    || { rm -f "$staged_unit" "$staged_timer"; die "$E_UNAVAILABLE" "cannot install the browser liveness timer"; }
  "$SYSTEMCTL" daemon-reload \
    && "$SYSTEMCTL" enable --now "5dive-browser-probe@$seat.timer" \
    || die "$E_UNAVAILABLE" "profile store is ready, but the scheduled browser probe could not be enabled"
}

cmd_setup() {
  [[ "$(id -u)" == 0 ]] || die "$E_PERM" "setup creates a root-owned store and a seat-owned subdirectory under it. Run: $SETUP_CMD"
  local seat; seat="$(_seat)"
  [[ "$seat" != root ]] || die "$E_USAGE" "refusing to make root a browser seat — run this via sudo from the seat that will own the profiles, so SUDO_USER names it."
  id -u "$seat" >/dev/null 2>&1 || die "$E_USAGE" "no unix user '$seat' — a profile is owned by a real uid or it is not isolated."
  mkdir -p "$PROFILE_ROOT" || die "$E_UNAVAILABLE" "cannot create $PROFILE_ROOT"
  chown root:root "$PROFILE_ROOT" 2>/dev/null || true
  chmod 00711 "$PROFILE_ROOT"        # traverse, do not list (5-digit: clears an inherited setgid, DIVE-4348)
  mkdir -p "$PROFILE_ROOT/$seat"
  chown "$seat" "$PROFILE_ROOT/$seat"
  chmod 00700 "$PROFILE_ROOT/$seat"  # one seat, and nobody else, reads its sessions (5-digit, see above)
  _install_probe_timer "$seat"
  printf 'profile store ready\n  %s  (root, 0711 — traverse, not list)\n  %s  (%s, 0700)\n  liveness probe: every ~6h (served profiles are skipped)\n\nNow, as %s:  5dive browser auth <site>\n' \
    "$PROFILE_ROOT" "$PROFILE_ROOT/$seat" "$seat" "$seat"
}

# ------------------------------------------------------------------------ auth
_chrome() {
  local c
  for c in google-chrome chromium chromium-browser google-chrome-stable; do
    command -v "$c" >/dev/null 2>&1 && { echo "$c"; return 0; }
  done
  return 1
}

cmd_auth() {
  local site="" status=0
  while (($#)); do
    case "$1" in
      --status) status=1 ;;
      -h|--help) usage; return 0 ;;
      -*) die "$E_USAGE" "unknown flag: $1" ;;
      *) site="$1" ;;
    esac; shift
  done
  (( status )) && { _auth_status "$site"; return $?; }

  [[ -n "$site" ]] || die "$E_USAGE" "which site? e.g. 5dive browser auth linkedin.com"
  _valid_site "$site" || die "$E_USAGE" "'$site' is not a usable profile name (lowercase letters, digits, . _ -)"
  _require_store
  local dir; dir="$(_site_dir "$site")"
  _ensure_profile_dir "$dir"

  local chrome; chrome=$(_chrome) || die "$E_UNAVAILABLE" "no Chrome or Chromium on this box — auth hands a real browser to a human and there is nothing to hand over."

  # NOT headless, and no automation flags: this window is for a PERSON. What this
  # capability IS, in the words the decision landed on (lodar, 2026-09-07): a
  # persistent human-authenticated browser session. It is NOT anti-bot bypassing,
  # and describing it that way invites exposure the design itself avoids.
  printf 'Opening a browser for %s.\n\n  profile: %s\n\nLog in yourself. 5dive never sees the password, and there is nothing here that\ntypes one. Close the window when you are logged in.\n\n' "$site" "$dir"
  # NO DISPLAY IS THE NORMAL CASE, NOT THE ERROR CASE. A managed box has no
  # display and never will; 4021 refused here and that refusal is what turned a
  # one-click product into "forward an X display over ssh". Server mode is the
  # default path now, and the old refusal survives only as the message a box
  # without the server-mode packages gets — where it is true.
  if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    printf 'No display here, so the browser runs on this box and you reach it through a\none-time link. Starting it:\n\n' >&2
    cmd_serve "$site" >&2
    printf '\nNow ask for a viewer link (the dashboard does this for you):\n  5dive browser viewer %s --bind=<your dashboard session>\n' "$site" >&2
    return 0
  fi
  "$chrome" --user-data-dir="$dir" --no-first-run --no-default-browser-check "$(_site_url "$site")"
}

# Where a profile is PROBED. Not a curated platform list — a site is whatever the
# user named, and this is only the URL its own adapter declares (or the bare
# domain we guessed from the name). We do not choose per-site API-vs-browser paths.
_site_url() {
  local a; a="$(_adapter_path "$1")"
  local u=""
  [[ -f "$a" ]] && u=$(jq -r '.probe.url // empty' "$a")
  [[ -n "$u" ]] && { printf '%s\n' "$u"; return 0; }
  # A NAME THAT ALREADY CONTAINS A DOT IS A HOST, and the suffix is a guess only
  # for a bare label. This was `https://$1.com/` unconditionally, and the profile
  # names the product actually uses come from the dashboard contract (GET
  # /server/browser/sites, the Connected-sites tile, the seeded profiles) — which
  # are hosts: `reddit.com`, `linkedin.com`. So `serve reddit.com` opened
  # `https://reddit.com.com/`, a parked domain that redirected the customer's
  # viewer onto a random subreddit instead of a login page, and `status` probed
  # the same wrong host. One function decides this for auth, serve, status and
  # the viewer, so there is exactly one place it can drift.
  case "$1" in
    *.*) echo "https://$1/" ;;
    *)   echo "https://$1.com/" ;;
  esac
}
_site_logged_out_marker() {
  local a; a="$(_adapter_path "$1")"
  [[ -f "$a" ]] && jq -r '.probe.logged_out_when_dom_matches // empty' "$a"
}
# THERE IS DELIBERATELY NO BYPASS BEHIND THIS. It classifies, names a human, and
# stops. Decided 2026-09-07: "if a platform presents a security challenge, the
# executor stops and requests human action rather than attempting to bypass it."
_site_challenge_marker() {
  local a; a="$(_adapter_path "$1")"
  local m; m=$([[ -f "$a" ]] && jq -r '.probe.challenge_when_dom_matches // empty' "$a")
  echo "${m:-(g-recaptcha|hcaptcha|cf-challenge|/checkpoint/challenge|two-factor|verify-your-identity)}"
}

# Liveness. Sessions die on the SITE's schedule, not ours — device checks, 2FA
# re-prompts, "unusual activity" interstitials — so a profile that worked Monday
# is logged out Thursday. Run this on a schedule; one page load a day is worth
# more than any adapter, because the alternative is finding out MID-PUBLISH.
_auth_status() {
  local only="${1:-}"
  _require_store
  local seat_dir; seat_dir="$(_seat_dir)"
  local rc=0 found=0 d site
  for d in "$seat_dir"/*/; do
    [[ -d "$d" ]] || continue
    site=$(basename "$d")
    [[ -z "$only" || "$only" == "$site" ]] || continue
    found=1
    _audit "$d" 700
    local state; state=$(_probe "$site" "$d"); local prc=$?
    printf '  %-20s %s\n' "$site" "$state"
    (( prc == 0 )) || rc=$E_COLD
  done
  (( found )) || { printf 'no profiles yet — 5dive browser auth <site>\n'; return 0; }
  if (( rc )); then
    printf '\nA cold profile is not an error path, it is the steady state — and only a person\nat a browser can clear it:\n  5dive browser auth <site>\n' >&2
  fi
  return $rc
}

# The probe loads one page in the profile and reads the URL it ENDED on. A site
# that logged you out redirects to its login page; that redirect is the signal,
# and it is cheap. It deliberately does not parse the DOM for a "Sign in" string:
# that string is on plenty of logged-in pages.
#
# TWO RULES ABOUT THE CAPTURE, both learned the expensive way (quinn, iteration 1):
#
#   1. NOTHING DOWNSTREAM OF THE BROWSER MAY DECIDE THE EXIT STATUS. The first
#      version piped --dump-dom into `head -c 200000` under `set -o pipefail`.
#      On a document over the cap, head exits at the cap, chrome takes SIGPIPE,
#      and the PIPELINE status is 141 — so a perfectly good page load was thrown
#      away as UNKNOWN. Real logged-in feeds and challenge interstitials are over
#      200KB essentially always, which means the classifier worked only in the
#      regime production never enters. So: redirect to a file, and read the
#      status of the BROWSER.
#   2. GREP THE WHOLE DOCUMENT. Even with the status fixed, a truncating capture
#      cannot see a marker past the cap, and a challenge banner is as likely to
#      be late in a large DOM as early. There is no cap here on purpose; the
#      bound is the one page we asked for.
_probe() {
  local site="$1" dir="$2"
  # SERVED MEANS WE CANNOT LOOK, AND SAYING SO IS THE WHOLE FIX. Chrome allows one
  # instance per --user-data-dir (SingletonLock); a second one launched at a held
  # profile hands its URL to the running instance and exits with an EMPTY document,
  # which arrived here as "UNKNOWN (probe did not load)". That blank is worst
  # exactly when it matters: server mode is how a customer logs in at all, so the
  # window in which the profile is served is the window right after the login the
  # tile is supposed to report. Name the condition instead of reporting a failure
  # that did not happen — and do NOT stamp, because the liveness file is the tile's
  # memory and the last real verdict outranks a transient "I could not look".
  #
  # WHY NOT PROBE THROUGH THE SERVED BROWSER (the other fix shape on the row): it
  # needs CDP, and CDP needs a port. --remote-debugging-pipe is fd-based and dies
  # with the process that opened it, so a later `status` in a different process
  # cannot reach it; a loopback --remote-debugging-port is reachable by every seat
  # on this box and hands them full control of a logged-in profile — the exact
  # credential the 0700 audit above exists to protect, given away with no file
  # permission needed at all. That trade is not the status command's to make.
  local sdisp
  if sdisp=$(_serve_running "$dir"); then
    echo "UNKNOWN (served on :$sdisp — the probe cannot open a profile the served browser holds; ask that browser, or stop it: 5dive browser serve $site --stop)"
    return 0
  fi
  local chrome; chrome=$(_chrome) || { echo "UNKNOWN (no chrome on this box)"; return 0; }
  local url; url=$(_site_url "$site")
  local marker; marker=$(_site_logged_out_marker "$site")
  local dom; dom=$(mktemp) || { echo "UNKNOWN (probe did not load)"; return 0; }
  "$chrome" --headless --no-sandbox --disable-gpu --user-data-dir="$dir" \
        --virtual-time-budget=8000 --dump-dom "$url" >"$dom" 2>/dev/null
  local rc=$?
  if (( rc != 0 )) || [[ ! -s "$dom" ]]; then
    rm -f "$dom"; echo "UNKNOWN (probe did not load)"; return 0
  fi
  # Challenge FIRST: a challenge page often still carries the login form's markup,
  # so testing logged-out first would classify an interrogated live session as a
  # dead one and send the user to re-authenticate a session that is fine.
  if grep -qiE "$(_site_challenge_marker "$site")" "$dom"; then
    rm -f "$dom"; _stamp "$dir" challenge
    echo "CHALLENGE — human action required (we do not solve these)"; return 1
  fi
  if [[ -n "$marker" ]] && grep -qiE "$marker" "$dom"; then
    rm -f "$dom"; _stamp "$dir" expired; echo "session expired — human action required"; return 1
  fi
  rm -f "$dom"
  # NO MARKER, NO VERDICT. `authenticated` is a claim about a LOGIN, and the only
  # evidence for it here is the adapter's logged-out marker failing to match. With
  # no adapter that test is skipped (`[[ -n "$marker" ]] &&`), so every page that
  # merely LOADED was stamped `authenticated` — observed on a profile nobody had
  # ever logged into. The only adapter shipped is example.json, which means this
  # was the state of every real profile, and the Connected-sites tile read it.
  # Reaching the challenge classification first is deliberate: its marker has a
  # built-in default, so a challenge page IS nameable with no adapter, and the
  # customer in front of a CAPTCHA still gets told to clear it rather than "we
  # cannot tell". Quiet (rc 0) like every other UNKNOWN: a state we cannot read
  # must not page a person. `run` still refuses on it — it accepts only
  # `authenticated*` — which is the fail-closed half.
  if [[ -z "$marker" ]]; then
    _stamp "$dir" unknown
    echo "UNKNOWN (no adapter for $site — the page loaded, but nothing here can tell logged-in from logged-out; write $(_adapter_path "$site") with probe.logged_out_when_dom_matches)"
    return 0
  fi
  _stamp "$dir" authenticated; echo "authenticated (checked $(date -u +%Y-%m-%dT%H:%MZ))"; return 0
}
_stamp() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$2" > "$1/.5dive-liveness" 2>/dev/null || true; }

cmd_probe_all() {
  _require_store
  local d site output found=0
  for d in "$(_seat_dir)"/*/; do
    [[ -d "$d" ]] || continue
    found=1
    site=$(basename "$d")
    _audit "$d" 700
    if _serve_running "$d" >/dev/null; then
      printf '  %-20s skipped: served\n' "$site"
      continue
    fi
    output=$(_auth_status "$site" 2>&1) || true
    printf '%s\n' "$output"
  done
  (( found )) || printf 'no profiles yet — 5dive browser auth <site>\n'
  # Expired/challenge is a liveness result, not a failed timer. Every eligible
  # profile was attempted; the stamp and journal output carry the outcome.
  return 0
}

cmd_ls() {
  _require_store
  local d site
  for d in "$(_seat_dir)"/*/; do
    [[ -d "$d" ]] || continue
    site=$(basename "$d")
    printf '  %-20s %s\n' "$site" "$(cat "$d/.5dive-liveness" 2>/dev/null || echo 'never probed')"
  done
}

# -------------------------------------------------------------------- adapters
#
# An adapter is DATA, not code, and this is the fixed vocabulary. A step outside
# it is a load-time refusal — that is what "deterministic" buys and it is the
# whole reason the adapter exists rather than a model reading the page. There is
# deliberately no `eval`, no `script`, and no free-text instruction step: any of
# those would make the adapter a program the executor merely hosts.
ADAPTER_STEPS="goto fill click wait_for select upload press"

_adapter_validate() {
  local f="$1" action="$2"
  [[ -f "$f" ]] || die "$E_USAGE" "no adapter for that site at $f — adapters are a public surface: write one, it is a JSON file with the fixed step vocabulary ($ADAPTER_STEPS)."
  jq -e . "$f" >/dev/null 2>&1 || die "$E_USAGE" "$f is not valid JSON"
  jq -e --arg a "$action" '.actions[$a]' "$f" >/dev/null 2>&1 \
    || die "$E_USAGE" "adapter defines no action '$action' (has: $(jq -r '.actions|keys|join(", ")' "$f"))"

  local bad
  bad=$(jq -r --arg a "$action" --arg v "$ADAPTER_STEPS" '
        ($v | split(" ")) as $ok
        | [.actions[$a].steps[]? | .op | select(. as $o | ($ok | index($o)) | not)] | unique | join(", ")' "$f")
  [[ -z "$bad" ]] && return 0 || die "$E_USAGE" "adapter action '$action' uses steps outside the fixed vocabulary: $bad. The vocabulary is the point — an adapter that can express anything is freeform reasoning with extra syntax."
}

# The verify block is MANDATORY and is checked before a single step runs, so an
# unverifiable action cannot be half-executed and then found unverifiable.
_verify_spec() {
  local f="$1" action="$2"
  jq -e --arg a "$action" '.actions[$a].verify | .url and .expect' "$f" >/dev/null 2>&1 \
    || die "$E_USAGE" "adapter action '$action' declares no out-of-band verify (needs .verify.url and .verify.expect). An adapter must not grade its own homework: after publishing, the artifact is re-read from a DIFFERENT path, or we do not claim it published."
}

cmd_run() {
  local site="${1:-}" action="${2:-}"; shift 2 2>/dev/null || true
  [[ -n "$site" && -n "$action" ]] || die "$E_USAGE" "usage: 5dive browser run <site> <action> [--key=value ...]"
  _valid_site "$site" || die "$E_USAGE" "'$site' is not a usable profile name"
  _require_store
  local dir; dir="$(_site_dir "$site")"
  [[ -d "$dir" ]] || die "$E_UNAVAILABLE" "no profile for $site — 5dive browser auth $site"
  _audit "$dir" 700

  local f; f=$(_adapter_path "$site")
  _adapter_validate "$f" "$action"
  _verify_spec "$f" "$action"

  # A RUN NEEDS THE PROFILE THE SAME WAY A RENDER DOES (DIVE-4524). Chrome allows
  # ONE instance per --user-data-dir: with a served browser holding this profile,
  # the driver's Chrome hands its work to the running instance and exits with an
  # empty document — the action would report nothing at all and the out-of-band
  # verify would correctly call it NOT VERIFIED, every time, for a reason nobody
  # could see. So `run` takes the same stop-render-restart cycle `shot` already
  # has (login lives in the directory, not in the process; measured DIVE-4464),
  # with the same one exception: a LIVE VIEWER is a person at a keyboard inside
  # this browser right now, most likely part-way through the login the viewer
  # exists for, and destroying their session to serve a machine is a refusal and
  # not a cycle. Restore is an EXIT trap because `die` exits — a failed action
  # must not leave a customer's browser stopped.
  local sdisp
  if sdisp=$(_serve_running "$dir"); then
    ! _viewer_live "$dir" || die "$E_UNAVAILABLE" "the $site browser is being viewed by a person right now (:$sdisp). Running an action means stopping that browser, which would take their session away mid-login. Wait, or end it deliberately: 5dive browser viewer-revoke $site"
    trap '_shot_restore' EXIT
    _SHOT_RESTORE_SITE="$site"
    cmd_serve "$site" --stop >/dev/null
  fi


  # Args become named values substituted into step arguments. They are inserted
  # by jq as VALUES, never spliced into a command line.
  local args='{}' kv k v
  for kv in "$@"; do
    [[ "$kv" == --*=* ]] || die "$E_USAGE" "arguments are --key=value; got: $kv"
    k="${kv%%=*}"; k="${k#--}"; v="${kv#*=}"
    args=$(jq --arg k "$k" --arg v "$v" '.[$k]=$v' <<<"$args")
  done

  # LIVENESS BEFORE ACTION. Finding out mid-publish is exactly the failure this
  # whole design is arranged around, and the answer is never to improvise a login.
  #
  # AND THE ONLY SAFE SHAPE IS A POSITIVE LIST. This was a `!= CHALLENGE && !=
  # expired` pair, which means every state the classifier has not got a name for
  # — UNKNOWN from a probe that did not load, UNKNOWN from a box with no browser
  # at all — fell straight through to the driver. A publish then ran with NO
  # liveness check, through a challenge page, and the no-bypass decision was
  # silently not enforced. UNKNOWN is asymmetric on purpose: QUIET at the
  # scheduler, because a network blip must not page a person, and a REFUSAL
  # here, because the action is the irreversible half.
  local state; state=$(_probe "$site" "$dir")
  case "$state" in
    CHALLENGE*)
      die "$E_COLD" "$site is presenting a security challenge. Stopping: 5dive does not attempt to solve one, by decision and not by limitation. A person clears it — 5dive browser auth $site" ;;
    session\ expired*)
      die "$E_COLD" "$site is logged out. Failing closed: no retry, no login attempt, no falling through to a generic click. A person clears this — 5dive browser auth $site" ;;
    authenticated*)
      : ;;
    *)
      die "$E_COLD" "cannot confirm the $site session is live ($state). Refusing to act on a session we did not verify: an unverified session is as likely to be a challenge page as a healthy one, and this is the irreversible half. This state is deliberately QUIET on \`5dive browser status\` — a probe that did not load must not page a person — and fatal here. Re-run the probe, or clear it by hand: 5dive browser auth $site" ;;
  esac

  # THE SHIPPED EXECUTOR IS THE DEFAULT NOW (DIVE-4524). This was a bare refusal
  # — FIVEDIVE_BROWSER_DRIVER was set by nothing but the test harness, so `run`
  # died "no executor backend" on every box and a logged-in profile was a
  # credential with no consumer. bin/driver-playwright drives THIS profile over
  # --remote-debugging-pipe (no listening socket, see its header); the env var
  # still overrides it, for the Browser Hand shape and for anyone driving their
  # own.
  #
  # IT IS STILL NOT A FALLBACK. The refusal the old message was protecting —
  # "never quietly drive a throwaway browser instead of the one a person logged
  # into" — is enforced inside the driver, which has no launch path that is not
  # this profile directory, rather than by having no driver at all.
  # The driver drives the SAME browser the profile was logged in with, so the
  # executable is resolved HERE, once, and passed down — a driver that picked its
  # own chrome could drive a build the session was never created in. This sits
  # AFTER the liveness probe deliberately: on a box with no browser at all the
  # answer a person needs is "I could not verify this session", not "no chrome" —
  # the missing-browser box is the one where an unverified session is most likely
  # to be a challenge page nobody has looked at.
  local chrome; chrome=$(_chrome) || die "$E_UNAVAILABLE" "no chrome on this box — an action needs the same browser the profile was logged in with."
  # PLAYWRIGHT TAKES A PATH, NOT A NAME. _chrome answers with whatever `command -v`
  # found first — the bare word `google-chrome` — which bash resolves through PATH
  # at every exec and Playwright's executablePath does not. Measured on
  # exact-swallow (DIVE-4538): a `run` that had cleared every refusal above died
  # "Failed to launch chromium because executable doesn't exist at google-chrome",
  # so the executor could not open a profile on any real box. Resolve it HERE,
  # once, where the executable is chosen; the driver still gets it handed down.
  chrome=$(command -v "$chrome" 2>/dev/null) || die "$E_UNAVAILABLE" "chrome is on this box but '$chrome' does not resolve to a path — an action needs the same browser the profile was logged in with."

  local driver="${FIVEDIVE_BROWSER_DRIVER:-$_SELF_DIR/driver-playwright}"
  [[ -n "$driver" && -x "$driver" ]] || die "$E_UNAVAILABLE" "no executor backend at $driver. Set FIVEDIVE_BROWSER_DRIVER to an executable that drives a REAL Chrome profile (the Browser Hand shape: extension + local relay), or reinstall the plugin so its own driver is back. This never falls back to a throwaway browser: an action that did not run inside the profile a person logged into by hand is not the thing that was asked for."

  local plan; plan=$(jq -c --arg a "$action" --arg profile "$dir" --argjson args "$args" \
      '{profile: $profile, steps: .actions[$a].steps, args: $args}' "$f")
  FIVEDIVE_BROWSER_PROFILE="$dir" FIVEDIVE_BROWSER_CHROME="$chrome" "$driver" <<<"$plan"
  local drc=$?

  # Put the browser back BEFORE the out-of-band verify: the verify is a plain
  # fetch that needs no profile, and a customer whose browser is down should not
  # be waiting on a 30s curl to get it back.
  _shot_restore
  trap - EXIT

  # EXIT 70 MEANS NOTHING RAN, and it must not reach the verify. The verify is an
  # out-of-band re-read of the artifact URL, which is exactly the right verdict
  # for an action that executed and exactly the WRONG one for an action that
  # never started: whatever is already at that URL would be reported as this
  # run's success. An executor that is not installed on this box would then read
  # as a green publish. The driver raises 70 for every refusal it makes before
  # its first step; a driver that does not use the code loses nothing (it falls
  # through to the re-read, which is the old behaviour).
  if (( drc == 70 )); then
    die "$E_UNAVAILABLE" "the executor refused before it ran a single step, so nothing was published and there is nothing to re-read (it exited 70; its own reason is above). Not treating the artifact URL as evidence: whatever is already there was not put there by this run."
  fi

  # AND HERE IS THE WHOLE POINT. The driver's exit status is evidence, not a
  # verdict: "posted the wrong thing and reported success" and "published fine and
  # reported failure" are both driver-green/driver-red lies, and the second one
  # double-posts on retry. So we go and LOOK, by a different path.
  local vurl vexpect
  # BOTH fields interpolate. The expect string is usually the thing that
  # IDENTIFIES the artifact — a slug, an id — so an uninterpolated expect can
  # never match and every publish reads as NOT VERIFIED.
  _interp() { jq -r --arg a "$action" --arg field "$1" --argjson args "$args" \
      '.actions[$a].verify[$field] as $u | ($args|to_entries|reduce .[] as $e ($u; gsub("\\{"+$e.key+"\\}"; $e.value)))' "$f"; }
  vurl=$(_interp url)
  vexpect=$(_interp expect)
  local body; body=$(curl -fsSL --max-time 30 "$vurl" 2>/dev/null)
  if grep -qE "$vexpect" <<<"$body"; then
    printf 'verified: %s is live at %s\n' "$action" "$vurl"
    return 0
  fi
  printf '%s: NOT VERIFIED — the driver exited %s but re-reading %s does not show the artifact.\nDo NOT retry blind: if it published and we misread, a retry double-posts.\n' \
    "$PROG" "$drc" "$vurl" >&2
  return 1
}


# =========================================================== server mode (DIVE-4118)
#
# WHY THIS EXISTS. DIVE-4021 shipped `auth` as "open a real Chromium and REFUSE
# without a display". On a MANAGED box there is never a display, so the shipped
# shape asked a paying customer for `ssh -X`, `apt install chromium` and a
# hand-written JSON file. lodar, 2026-09-09: "thats too difficult for customers."
#
# Server mode is the answer 4021's own design already named as the DEFAULT: the
# profile's Chrome lives on a persistent Xvfb display owned by the seat, and a
# human reaches it — to log in the first time, and to re-auth when the session
# dies — through a viewer that is handed out as a ONE-TIME, TIME-BOUND,
# SESSION-BOUND ticket.
#
# THE QUESTION 4021 LEFT OPEN, answered here: what protects the session WHILE the
# viewer is open? A viewer onto a logged-in profile is not a screenshot, it is
# the credential itself with a keyboard attached. Five things, and every one of
# them fails closed:
#
#   1. NOTHING LISTENS OFF-BOX. Xvfb runs -nolisten tcp; x11vnc binds -localhost;
#      the websocket bridge binds 127.0.0.1. The viewer reaches the customer
#      through the box's already-authenticated relay, never a port we opened.
#   2. THE TICKET IS A NONCE WE DO NOT KEEP. 32 bytes of urandom; the ticket file
#      stores only SHA-256 of it (gate-human-nonce-spec's rule, same reason: a
#      stored secret is a stealable secret). The raw value exists exactly once,
#      in the URL we print, and reading it back off this box is impossible.
#   3. IT IS SINGLE-USE, and it is what CARRIES the VNC password: redemption is
#      the only place the viewer's credential is ever emitted, so the port and the
#      key to it have exactly one lifetime. Redeeming consumes the ticket, in one file rename that
#      cannot interleave. A second redemption of a leaked URL gets nothing —
#      which is the property a TTL alone can never give you.
#   4. IT IS BOUND TO THE SESSION THAT ASKED. --bind names the dashboard session
#      the ticket was minted for; a redemption presenting a different one is
#      refused. A URL pasted into another browser is inert even inside its TTL.
#   5. IT EXPIRES IN MINUTES AND THE NONCE NEVER TOUCHES ARGV. /proc/<pid>/cmdline
#      is not a secret store, so redeem reads the nonce from STDIN and REFUSES a
#      nonce passed as an argument rather than quietly accepting it.
#
# Killing the viewer does NOT kill the browser: the profile is the durable thing
# and the view onto it is the ephemeral thing. That asymmetry is the design.

VIEWER_TTL_DEFAULT=600
VIEWER_TTL_MAX=3600
VIEWER_TTL_MIN=60
# How long a mint waits for the display server and the bridge to be accepting
# before it refuses. Starting them is not the same moment as them listening.
VIEWER_BRIDGE_WAIT_S=10

_serve_pidfile()  { echo "$1/.5dive-serve"; }
_viewer_ticket()  { echo "$1/.5dive-viewer.ticket"; }
_viewer_pidfile() { echo "$1/.5dive-viewer"; }

_have() { command -v "$1" >/dev/null 2>&1; }

# Loopback only. Nothing here ever binds 0.0.0.0 — the viewer reaches the customer
# through the box's already-authenticated relay, not through a port we opened.
_free_port() {
  local p="$1" tries=0
  while (( tries < 200 )); do
    if ! { exec 9<>"/dev/tcp/127.0.0.1/$p"; } 2>/dev/null; then echo "$p"; return 0; fi
    exec 9>&- 2>/dev/null || true
    p=$(( p + 1 )); tries=$(( tries + 1 ))
  done
  return 1
}

# Is anything LISTENING on this loopback port? Read it out of /proc/net/tcp
# instead of connecting to find out: the bridge's other side is an x11vnc started
# with -once, so a probe that opens a connection spends the customer's single
# admission to check that they can have it. A read costs the connection budget
# nothing. (_free_port established a moment earlier that the port was ours to
# take, which is what makes "something is listening here" mean "ours came up".)
_port_listening() {
  local hex f
  hex=$(printf '%04X' "$1")
  for f in /proc/net/tcp /proc/net/tcp6; do
    [[ -r "$f" ]] || continue
    awk -v pat="$hex" '$4=="0A" && $2 ~ (":" pat "$") {f=1} END{exit !f}' "$f" && return 0
  done
  return 1
}

# Wait, bounded, for a port to start accepting — and give up early if the process
# that was supposed to bind it is already gone.
_wait_listening() {  # _wait_listening <port> <pid>
  local port="$1" pid="$2" i=0 max=$(( VIEWER_BRIDGE_WAIT_S * 20 ))
  while (( i < max )); do
    _port_listening "$port" && return 0
    kill -0 "$pid" 2>/dev/null || { _port_listening "$port" && return 0; return 1; }
    sleep 0.05; i=$(( i + 1 ))
  done
  return 1
}

# Fail closed, and NAME what is missing. A managed box is provisioned with these;
# a box without them must say so out loud, because the alternative is a customer
# clicking Connect and watching nothing happen.
_serve_requires() {
  local missing=()
  _have Xvfb || missing+=("Xvfb (xvfb)")
  _chrome >/dev/null || missing+=("chromium")
  (( ${#missing[@]} == 0 )) && return 0
  die "$E_UNAVAILABLE" "this box cannot run a server-mode browser: missing $(printf "%s, " "${missing[@]}" | sed "s/, $//"). A managed 5dive box installs these at provision time; on a self-hosted box install them once."
}
_viewer_requires() {
  local missing=()
  _have x11vnc || missing+=("x11vnc")
  _have websockify || missing+=("websockify (novnc)")
  (( ${#missing[@]} == 0 )) && return 0
  die "$E_UNAVAILABLE" "this box cannot hand out a browser viewer: missing $(printf "%s, " "${missing[@]}" | sed "s/, $//"). Without it the only way in is a display forwarded over ssh, which is the thing server mode exists to remove."
}

# A display number that is stable per seat+site, so a reconnect finds the SAME
# Chrome rather than starting a second one on the same profile directory. Two
# Chromes on one --user-data-dir corrupt it; the lockfile below is what actually
# enforces one, this only picks a number that rarely collides.
_display_num() {
  local h; h=$(printf '%s' "$(_seat)/$1" | sha256sum | cut -c1-4)
  echo $(( 0x$h % 400 + 100 ))
}
# The X socket directory is a PATH, not a verdict: overriding it cannot make a
# dead display read as live, because liveness is the Xvfb PID (_serve_running).
X11_SOCKET_DIR="${FIVEDIVE_BROWSER_X11_DIR:-/tmp/.X11-unix}"
_display_socket() { [[ -e "$X11_SOCKET_DIR/X$1" ]]; }
_display_free()   { ! _display_socket "$1"; }

_serve_running() {  # _serve_running <dir> -> echoes display, 0 if live
  local f; f="$(_serve_pidfile "$1")"
  [[ -f "$f" ]] || return 1
  local xpid cpid disp; xpid=$(_kv "$f" xvfb_pid); cpid=$(_kv "$f" chrome_pid); disp=$(_kv "$f" display)
  [[ -n "$xpid" && -n "$cpid" ]] || return 1
  kill -0 "$xpid" 2>/dev/null && kill -0 "$cpid" 2>/dev/null || return 1
  echo "$disp"; return 0
}

_kv() { [[ -f "$1" ]] && sed -n "s/^$2=//p" "$1" | head -1; }

cmd_serve() {
  local site="" stop=0
  while (($#)); do
    case "$1" in
      --stop) stop=1 ;;
      -h|--help) usage; return 0 ;;
      -*) die "$E_USAGE" "unknown flag: $1" ;;
      *) site="$1" ;;
    esac; shift
  done
  [[ -n "$site" ]] || die "$E_USAGE" "which site? e.g. 5dive browser serve linkedin.com"
  _valid_site "$site" || die "$E_USAGE" "'$site' is not a usable profile name"
  _require_store
  local dir; dir="$(_site_dir "$site")"
  _ensure_profile_dir "$dir"

  if (( stop )); then
    # Revoke BEFORE killing: a ticket that survives its viewer redeems 0 onto a
    # port with nothing behind it, which is the same customer-facing failure as a
    # dead -timeout — a link that says yes and shows nothing.
    _viewer_revoke_file "$dir" revoked
    _viewer_stop "$dir"
    local f; f="$(_serve_pidfile "$dir")"
    local xpid cpid; xpid=$(_kv "$f" xvfb_pid); cpid=$(_kv "$f" chrome_pid)
    [[ -n "$cpid" ]] && kill "$cpid" 2>/dev/null
    [[ -n "$xpid" ]] && kill "$xpid" 2>/dev/null
    rm -f "$f"
    printf 'stopped the %s browser. The profile is untouched — it is the durable half.\n' "$site"
    return 0
  fi

  local disp
  if disp=$(_serve_running "$dir"); then
    printf 'already serving %s on :%s\n' "$site" "$disp"; return 0
  fi
  _serve_requires

  disp=$(_display_num "$site")
  local tries=0
  while ! _display_free "$disp"; do
    disp=$(( disp + 1 )); tries=$(( tries + 1 ))
    (( tries < 50 )) || die "$E_UNAVAILABLE" "no free X display in the seat's range"
  done

  # -nolisten tcp: the display is a unix socket and nothing else. An X server on
  # a TCP port is an unauthenticated remote keyboard for every seat on the box.
  Xvfb ":$disp" -screen 0 1280x800x24 -nolisten tcp >/dev/null 2>&1 &
  local xpid=$!
  local waited=0
  while ! _display_socket "$disp" && (( waited < 300 )); do waited=$(( waited + 1 )); sleep 0.05; done
  kill -0 "$xpid" 2>/dev/null || die "$E_UNAVAILABLE" "Xvfb did not start on :$disp"

  local chrome; chrome=$(_chrome)
  DISPLAY=":$disp" "$chrome" --user-data-dir="$dir" --no-first-run \
      --no-default-browser-check --window-size=1280,800 \
      --disable-features=TranslateUI "$(_site_url "$site")" >/dev/null 2>&1 &
  local cpid=$!

  ( umask 077; printf 'display=%s\nxvfb_pid=%s\nchrome_pid=%s\nstarted_at=%s\n' \
      "$disp" "$xpid" "$cpid" "$(date -u +%s)" > "$(_serve_pidfile "$dir")" )
  printf 'serving %s on :%s (persistent — the profile outlives every viewer)\n' "$site" "$disp"
}

# ------------------------------------------------------------------ the viewer
_viewer_stop() {
  local dir="$1" f; f="$(_viewer_pidfile "$dir")"
  local p
  for p in $(_kv "$f" vnc_pid) $(_kv "$f" ws_pid); do kill "$p" 2>/dev/null; done
  rm -f "$f"
  # The VNC password outlives nothing. It is only ever meaningful while the
  # process that was started with it is alive, so a copy left behind in the
  # profile directory is a stored secret with no live purpose.
  rm -f "$dir/.5dive-viewer.pw"
}

# A ticket is minted, printed ONCE, and never recoverable. The file holds the
# HASH; if this box is later read by anyone, there is no viewer URL in it.
cmd_viewer() {
  local site="" ttl="$VIEWER_TTL_DEFAULT" bind=""
  while (($#)); do
    case "$1" in
      --ttl=*)  ttl="${1#*=}" ;;
      --bind=*) bind="${1#*=}" ;;
      -h|--help) usage; return 0 ;;
      -*) die "$E_USAGE" "unknown flag: $1" ;;
      *) site="$1" ;;
    esac; shift
  done
  [[ -n "$site" ]] || die "$E_USAGE" "which site? e.g. 5dive browser viewer linkedin --bind=<dashboard session>"
  _valid_site "$site" || die "$E_USAGE" "'$site' is not a usable profile name"
  # BINDING IS MANDATORY. An unbound ticket is a bearer credential for a live
  # logged-in session, and "we will add the binding later" is how it ships as one
  # forever. `--bind=local` is the explicit, named escape for a hand-run on the
  # box; there is no implicit one.
  [[ -n "$bind" ]] || die "$E_USAGE" "--bind=<dashboard session id> is required: the viewer is a live keyboard on a logged-in profile, so a ticket anyone can redeem is the credential itself. Use --bind=local for a hand-run on this box."
  [[ "$bind" =~ ^[A-Za-z0-9._:-]{1,128}$ ]] || die "$E_USAGE" "--bind must be a short opaque session id"
  [[ "$ttl" =~ ^[0-9]+$ ]] || die "$E_USAGE" "--ttl is seconds"
  (( ttl >= VIEWER_TTL_MIN )) || die "$E_USAGE" "--ttl below ${VIEWER_TTL_MIN}s is not long enough for a person to log in"
  (( ttl <= VIEWER_TTL_MAX )) || die "$E_USAGE" "--ttl above ${VIEWER_TTL_MAX}s: this is a re-auth window, not a session. The browser persists; the VIEW does not."

  _require_store
  local dir; dir="$(_site_dir "$site")"
  [[ -d "$dir" ]] || die "$E_UNAVAILABLE" "no profile for $site — 5dive browser serve $site"
  _audit "$dir" 700

  local disp
  disp=$(_serve_running "$dir") || die "$E_UNAVAILABLE" "no browser is serving $site — start it first: 5dive browser serve $site"
  _viewer_requires

  # Replacing a ticket revokes the previous one. Two live tickets on one profile
  # is two answers to "who is allowed in right now" — and the revoke happens
  # BEFORE anything that can fail, so a mint that dies halfway cannot leave the
  # previous ticket redeemable onto the viewer this call just killed.
  _viewer_revoke_file "$dir" replaced
  _viewer_stop "$dir"

  local port vncport
  port=$(_free_port 6080) || die "$E_UNAVAILABLE" "no free loopback port for the viewer bridge"
  vncport=$(_free_port 5900) || die "$E_UNAVAILABLE" "no free loopback port for the display server"

  local nonce hash vncpw
  nonce=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
  hash=$(printf '%s' "$nonce" | sha256sum | cut -d' ' -f1)
  vncpw=$(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n')

  # -localhost and -once: the VNC side is reachable only from this box, and it
  # accepts exactly one client. The second connection on a leaked URL is refused
  # by x11vnc itself, not merely by our bookkeeping.
  #
  # -timeout IS THE TICKET'S TTL, not a constant. x11vnc -timeout n exits unless a
  # client connects inside the first n seconds, so a fixed 30 killed the viewer
  # half a minute into a ticket that advertises up to an hour — and redemption
  # still consumed the ticket, leaving the customer a spent link and a dead port.
  # The window the ticket promises and the window the VNC server honours are ONE
  # number; two constants thirty lines apart is how they drift.
  local pwfile="$dir/.5dive-viewer.pw"
  ( umask 077; printf '%s\n' "$vncpw" > "$pwfile" )
  # ONE CLOCK ORIGIN FOR BOTH WINDOWS. x11vnc starts counting its -timeout the
  # moment it is exec'd; expires_at used to be stamped AFTER _wait_listening, which
  # is bounded at VIEWER_BRIDGE_WAIT_S. Same length, two origins — so the VNC server
  # exited up to that many seconds BEFORE the ticket said it could, and a customer
  # who redeemed near the end of the advertised window got the iteration-1 failure
  # exactly: a spent link onto a dead port. Stamping BEFORE the launch is the
  # fail-closed direction of the two available fixes: the ticket advertises no more
  # life than the VNC server was actually given. Lengthening -timeout instead would
  # have kept a viewer accepting a client after its own ticket had expired.
  local clock0; clock0=$(date -u +%s)
  x11vnc -display ":$disp" -localhost -once -rfbport "$vncport" \
         -timeout "$ttl" -passwdfile "$pwfile" >/dev/null 2>&1 &
  local vncpid=$!
  websockify "127.0.0.1:$port" "127.0.0.1:$vncport" >/dev/null 2>&1 &
  local wspid=$!

  ( umask 077; printf 'vnc_pid=%s\nws_pid=%s\nport=%s\nvnc_port=%s\n' "$vncpid" "$wspid" "$port" "$vncport" > "$(_viewer_pidfile "$dir")" )

  # A TICKET IS ONLY MINTED ONTO A BRIDGE THAT IS ALREADY ACCEPTING. Both
  # programs are started in the background, so "the mint returned" and "the port
  # is bound" are two different moments — and the whole shape of this product is
  # a one-time link handed to a relay that redeems it AT ONCE. Redeem inside that
  # window and the relay is given 127.0.0.1:<port> with nothing behind it: the
  # customer gets a blank viewer and the link is spent, which is the same
  # customer-facing failure as the old hardcoded -timeout, arriving by a race
  # instead of a constant. So wait for both ports, and if either never comes up,
  # reap and refuse. NO link at all is strictly better than a live link onto a
  # dead port, because the second one costs the customer their one redemption.
  if ! _wait_listening "$vncport" "$vncpid" || ! _wait_listening "$port" "$wspid"; then
    _viewer_stop "$dir"
    die "$E_UNAVAILABLE" "the viewer for $site never started listening within ${VIEWER_BRIDGE_WAIT_S}s (the display server or the websocket bridge did not come up). No link was issued, so there is nothing to redeem onto a dead port. The browser session itself is untouched and still logged in."
  fi

  local expires=$(( clock0 + ttl ))
  ( umask 077; printf 'hash=%s\nexpires_at=%s\nbind=%s\nstate=open\nminted_at=%s\nport=%s\n' \
      "$hash" "$expires" "$bind" "$clock0" "$port" > "$(_viewer_ticket "$dir")" )
  chmod 600 "$(_viewer_ticket "$dir")"

  printf '/browser/viewer/%s/%s\n' "$site" "$nonce"
  printf 'one-time, expires %s, bound to session %s. Redeeming it consumes it.\n' \
    "$(date -u -d "@$expires" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "in ${ttl}s")" "$bind" >&2
}

# Redemption is the whole security boundary, so it is one verb with one answer.
# The relay calls this before it bridges a websocket; if this exits non-zero the
# relay must serve nothing.
cmd_viewer_redeem() {
  local site="" session="" nonce_from_argv=0
  while (($#)); do
    case "$1" in
      --session=*) session="${1#*=}" ;;
      --nonce=-)   : ;;                 # the only accepted form: read from stdin
      --nonce=*)   nonce_from_argv=1 ;;
      -h|--help) usage; return 0 ;;
      -*) die "$E_USAGE" "unknown flag: $1" ;;
      *) site="$1" ;;
    esac; shift
  done
  # /proc/<pid>/cmdline is readable by other seats on a default Linux box, so a
  # nonce on the command line is a nonce in a world-readable file for the life of
  # the process. Refuse it rather than accept it and hope.
  (( nonce_from_argv )) && die "$E_USAGE" "the viewer nonce must arrive on STDIN, not in argv — every seat on this box can read /proc/<pid>/cmdline. Use: ... | 5dive browser viewer-redeem $site --nonce=- --session=<id>"
  [[ -n "$site" ]] || die "$E_USAGE" "usage: 5dive browser viewer-redeem <site> --nonce=- --session=<id>"
  _valid_site "$site" || die "$E_USAGE" "'$site' is not a usable profile name"
  [[ -n "$session" ]] || die "$E_USAGE" "--session=<id> is required: a ticket is bound to the session that asked for it"

  _require_store
  local dir; dir="$(_site_dir "$site")"
  _audit "$dir" 700
  local tf; tf="$(_viewer_ticket "$dir")"
  [[ -f "$tf" ]] || die "$E_PERM" "no viewer ticket for $site"

  local presented; IFS= read -r presented || true
  [[ -n "$presented" ]] || die "$E_PERM" "no nonce on stdin"

  local state hash expires bind port
  state=$(_kv "$tf" state); hash=$(_kv "$tf" hash)
  expires=$(_kv "$tf" expires_at); bind=$(_kv "$tf" bind); port=$(_kv "$tf" port)

  # SINGLE USE FIRST. A consumed ticket must not even leak whether the nonce was
  # right, and checking state last is how a "used" ticket becomes an oracle.
  #
  # AND THIS BRANCH IS A PURE REFUSAL — it computes, it dies, it touches nothing.
  # It is hoisted above the session binding and the nonce compare for a LEAK
  # reason, which means it also runs before anything has established the caller is
  # anyone at all. A `_viewer_stop` here therefore let one unauthenticated call
  # (no nonce, no session, just the site name) kill the customer's LIVE viewer and
  # delete its credential: a hoisted check drags whatever side effect it carries
  # ahead of every auth check with it. The likeliest trigger was never an attacker
  # but the customer's own phone reloading the viewer URL mid-login. Reaping is
  # legitimate on the EXPIRED branch below, because expiry is a fact about the
  # ticket rather than a claim about who is calling; here it never is. x11vnc's
  # -once and -timeout reap the view on their own.
  [[ "$state" == open ]] || die "$E_PERM" "that viewer link has already been used (state: $state). Links are one-time by design — ask the dashboard for a new one. The browser session itself is untouched and still logged in."
  (( $(date -u +%s) < expires )) || { _viewer_revoke_file "$dir" expired; _viewer_stop "$dir"; die "$E_PERM" "that viewer link expired. Ask the dashboard for a new one; the browser session itself is untouched."; }
  [[ "$session" == "$bind" ]] || die "$E_PERM" "that viewer link was issued to a different dashboard session. Refusing: a link pasted somewhere else is exactly what the binding exists to stop."

  local got; got=$(printf '%s' "$presented" | sha256sum | cut -d' ' -f1)
  [[ "$got" == "$hash" ]] || die "$E_PERM" "that viewer link is not valid for $site."

  # THE PASSWORD IS PART OF THE ANSWER, not a second secret the relay must find.
  # x11vnc runs with -passwdfile, and that file lives inside the 0700 seat-owned
  # profile directory — which is precisely what DIVE-4021's isolation stops the
  # relay from reading. Handing over a target without it is handing over a port
  # that prompts for a password nobody has. Emitting it here is safe for exactly
  # the reasons the ticket is: this answer is printed once, to the session the
  # ticket was bound to, and the ticket is consumed in the same breath.
  #
  # Read it BEFORE consuming: a viewer whose password file is gone cannot be
  # entered, and spending the customer's one-time link to tell them so is the
  # worst of both.
  local pwfile="$dir/.5dive-viewer.pw" vncpw=""
  [[ -f "$pwfile" ]] || die "$E_UNAVAILABLE" "the viewer for $site is no longer running (its credential is gone). The ticket was NOT spent — ask the dashboard for a new viewer."
  IFS= read -r vncpw < "$pwfile"
  [[ -n "$vncpw" ]] || die "$E_UNAVAILABLE" "the viewer for $site has no usable credential. The ticket was NOT spent — ask the dashboard for a new viewer."

  _viewer_revoke_file "$dir" consumed
  printf 'target=127.0.0.1:%s\npassword=%s\n' "$port" "$vncpw"
}

_viewer_revoke_file() {
  local dir="$1" newstate="$2" tf; tf="$(_viewer_ticket "$dir")"
  [[ -f "$tf" ]] || return 0
  local tmp="$tf.$$"
  ( umask 077; sed "s/^state=.*/state=$newstate/" "$tf" > "$tmp" ) && mv -f "$tmp" "$tf"
  chmod 600 "$tf" 2>/dev/null || true
}

cmd_viewer_revoke() {
  local site="${1:-}"
  [[ -n "$site" ]] || die "$E_USAGE" "usage: 5dive browser viewer-revoke <site>"
  _valid_site "$site" || die "$E_USAGE" "'$site' is not a usable profile name"
  _require_store
  local dir; dir="$(_site_dir "$site")"
  _audit "$dir" 700
  _viewer_revoke_file "$dir" revoked
  _viewer_stop "$dir"
  rm -f "$dir/.5dive-viewer.pw"
  printf 'viewer for %s revoked. The browser keeps running and stays logged in.\n' "$site"
}

# ======================================================= shot (DIVE-4488)
#
# THE ACT HALF, verb one. `serve`/`viewer` get a human's LOGIN into a profile;
# until now nothing could use it — `run` dies "no executor backend" on every box,
# so a logged-in profile was a credential with no consumer. `shot` is the
# smallest thing that consumes one: render a URL INSIDE the profile and hand back
# a PNG (and, on request, the DOM). No adapter, no step vocabulary, no writes to
# the site — it is a READ, which is why it can ship ahead of the executor.
#
# WHY THIS IS WORTH A VERB. Two consumers, both measured on the queue:
#   1. A logged-in page of our own product. A grader or merger cannot open one
#      (it is behind the owner's login), so "the PR carries a rendered screenshot
#      and someone LOOKED at it" costs a human tap every single time.
#   2. A read session on a site that shows a logged-out visitor nothing useful
#      (x.com, reddit.com threads). The shot + DOM IS the read.
#
# ---- THE SINGLETON PROBLEM, and which of the two fixes this took -------------
#
# Chrome allows ONE instance per --user-data-dir. A second one launched at a
# profile a served Chrome is holding hands its URL to the running instance and
# exits with an empty document — which is why `status` refuses to probe a served
# profile at all (see _probe). `shot` has the same wall and only two ways past:
#
#   (a) stop the served browser, render, start it again. The login survives — it
#       is in the profile directory, not in the process.
#   (b) drive the SERVED Chrome over CDP on a loopback --remote-debugging-port.
#
# THIS TOOK (a), and the reason is not convenience. A loopback CDP port is
# reachable by EVERY SEAT ON THIS BOX, and CDP is full control of the browser
# holding the session: read cookies, navigate, act. That hands away the exact
# thing the 0700 audit exists to protect, and it hands it away with no file
# permission needed at all — a seat that could never read the profile directory
# would get the session anyway. The profile's 0700 mode would become decorative.
# (a) opens NO listening socket, so the attack surface stays exactly what it
# already was: the profile directory, already audited on both the seat dir and
# the site dir before anything is launched. That is the proof the other seat
# cannot reach the render — there is nothing to reach. The harness's chrome stub
# records the argv it was called with and T15c asserts no --remote-debugging-*
# among it, so (b) cannot be reintroduced without reddening an arm.
#
# The one case (a) must NOT take: a LIVE VIEWER. That is a person at a keyboard
# looking at this browser right now, most likely part-way through the login the
# viewer exists for. Killing it to take a screenshot would destroy the human's
# work to serve a machine's convenience, so a live viewer is a refusal, not a
# stop. A serve with no viewer is nobody's session and is cycled.
#
# ---- WHAT IT REFUSES ---------------------------------------------------------
#
# Only `authenticated` renders, the same positive list `run` uses and for a
# sharper reason: the failure mode here is not a crash, it is a PNG of the SIGN-IN
# PAGE captioned as the artifact. A grader who is handed that has been handed a
# lie that looks exactly like evidence. Everything else — expired, CHALLENGE,
# UNKNOWN, no adapter to tell them apart — is a refusal.
#
# NO ADAPTER IS NOT A SPECIAL CASE. With no adapter, _probe cannot tell logged-in
# from logged-out, so it says UNKNOWN and `shot` refuses. Shipping a guessed
# logged-out marker to "unblock" a site would be worse than shipping none: a
# marker that never matches stamps every logged-out page `authenticated`, which
# is precisely the mutant above with our own signature on it. One adapter file
# per site, written by someone who looked at that site's logged-out page.

SHOT_SIZE_DEFAULT=1280x800
# --full is a TALL VIEWPORT, and the name is the most it can honestly promise:
# headless Chrome screenshots the viewport, it does not scroll-stitch a page.
SHOT_SIZE_FULL=1280x5000
SHOT_WAIT_DEFAULT=8000

# Set by cmd_shot when it stopped a serve it must put back, and read by the EXIT
# trap: `die` exits, so restoring only on the success path would leave a customer's
# browser stopped by a screenshot that failed.
_SHOT_RESTORE_SITE=""
_shot_restore() {
  [[ -n "$_SHOT_RESTORE_SITE" ]] || return 0
  local s="$_SHOT_RESTORE_SITE"; _SHOT_RESTORE_SITE=""
  # THE SUBSHELL IS THE WHOLE POINT, and without it the `||` below can never run
  # (DIVE-4524). `cmd_serve` reports failure by calling `die`, and `die` EXITS —
  # attaching a catch to a command that exits does not make it catchable, it just
  # hides the message (this call silences stderr, so the die text goes nowhere).
  # The observed shape: a render or an action that fully SUCCEEDED, whose browser
  # could not be restarted, exited 69 with no output at all — no PNG line, no
  # verify line, no reason. A subshell contains the exit, so the warning is
  # printed, the command keeps its own verdict, and the one thing that is true is
  # the one thing the caller is told: the profile is intact, the browser is not
  # back up.
  ( cmd_serve "$s" >/dev/null 2>&1 ) || \
    printf '%s: WARNING — could not restart the %s browser afterwards. The profile is intact — it is the durable half; start it again: 5dive browser serve %s\n' "$PROG" "$s" "$s" >&2
}

# A viewer is LIVE when the process that answers it is alive. The pidfile alone
# is not the test: x11vnc is started with -once and -timeout, so it exits on its
# own and leaves the file behind.
_viewer_live() {
  local f; f="$(_viewer_pidfile "$1")"
  [[ -f "$f" ]] || return 1
  local p; p=$(_kv "$f" vnc_pid)
  [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null
}

# The host a profile is ALLOWED to render. A profile is a credential scoped to a
# site by its own name, and `shot <site> <url>` with an unrelated url is either a
# typo or a way to make one profile's name vouch for another site's page. The
# render would be logged OUT and look like a bug in the feature; refuse instead.
# A subdomain passes: the login lives on the registrable name (app.5dive.com is
# reached with 5dive.com's cookies) and that is consumer 1's whole shape.
_shot_host_ok() {  # _shot_host_ok <site> <host>
  local base="$1" host="$2"
  [[ "$base" == *.* ]] || base="$base.com"
  [[ "$host" == "$base" || "$host" == *".$base" ]]
}

# ---------------------------------------------------------------------------
# THE PROLOGUE EVERY RENDER SHARES — DIVE-4515 lifted it out of cmd_shot rather
# than writing a second copy for `read`. Everything a verb must be sure of
# BEFORE it points chrome at a page: the url is an http(s) page OF THIS SITE,
# the profile store is this seat's and 0700, a chrome exists, any served browser
# has been cycled out of the way (with nobody inside it), and the session probes
# AUTHENTICATED. That last one is the whole reason this is shared code and not a
# second copy: `read` has exactly the failure `shot` has — a sign-in page is a
# perfectly well-formed article, and Defuddle will hand back clean Markdown of
# it, with a title and a word count, looking like the page that was asked for.
# A forked copy is a copy that loses the gate on somebody's next edit.
#
# Publishes _PG_DIR (the profile dir) and _PG_CHROME (the binary), and may arm
# the EXIT trap that puts back a serve it stopped.
_PG_DIR=""; _PG_CHROME=""
_page_open() {  # _page_open <site> <url>
  local site="$1" url="$2"
  # SCHEME AND HOST, before the store is even opened. file:// and chrome:// are
  # not pages of a site and have no business being rendered by a verb whose whole
  # contract is "a page of the site you logged into".
  [[ "$url" =~ ^https?://[^/]+ ]] || die "$E_USAGE" "browser renders only http(s) pages; got: $url"
  local host="${url#*://}"; host="${host%%/*}"; host="${host%%\?*}"
  host="${host##*@}"; host="${host%%:*}"; host="${host,,}"
  _shot_host_ok "$site" "$host" || die "$E_USAGE" "$url is not a page of '$site' (its host is $host). A profile is a credential scoped to the site it is named for: rendering another site's page inside it produces a LOGGED-OUT screenshot that looks like a bug in this command. Use the profile for that site — or 5dive browser auth $host."

  _require_store
  local dir; dir="$(_site_dir "$site")"
  [[ -d "$dir" ]] || die "$E_UNAVAILABLE" "no profile for $site — 5dive browser auth $site"
  _audit "$dir" 700

  local chrome; chrome=$(_chrome) || die "$E_UNAVAILABLE" "no chrome on this box — a render needs the same browser the profile was logged in with."

  # The served browser holds the profile. Cycle it (never with a person inside).
  local sdisp
  if sdisp=$(_serve_running "$dir"); then
    ! _viewer_live "$dir" || die "$E_UNAVAILABLE" "the $site browser is being viewed by a person right now (:$sdisp). Rendering means stopping that browser, which would take their session away mid-login. Wait, or end it deliberately: 5dive browser viewer-revoke $site"
    trap '_shot_restore' EXIT
    _SHOT_RESTORE_SITE="$site"
    cmd_serve "$site" --stop >/dev/null
  fi

  # LIVENESS, positive list only. See the header: the failure this stops is a PNG
  # of the sign-in page handed over as the artifact.
  local state; state=$(_probe "$site" "$dir")
  case "$state" in
    authenticated*) : ;;
    CHALLENGE*)
      die "$E_COLD" "$site is presenting a security challenge, so anything rendered now is the challenge page and not the page you asked for. A person clears it — 5dive browser auth $site" ;;
    session\ expired*)
      die "$E_COLD" "$site is logged out. Refusing rather than handing back a screenshot of the sign-in page: that PNG would look exactly like evidence and would be the opposite. A person clears this — 5dive browser auth $site" ;;
    *)
      die "$E_COLD" "cannot confirm the $site session is live ($state), so a render now could be the sign-in page with no way for the reader to tell. Refusing." ;;
  esac

  _PG_DIR="$dir"; _PG_CHROME="$chrome"
  return 0
}

cmd_shot() {
  local site="" url="" out="" domout="" size="$SHOT_SIZE_DEFAULT" wait="$SHOT_WAIT_DEFAULT"
  while (($#)); do
    case "$1" in
      --out=*)  out="${1#*=}" ;;
      --dom=*)  domout="${1#*=}" ;;
      --size=*) size="${1#*=}" ;;
      --full)   size="$SHOT_SIZE_FULL" ;;
      --wait=*) wait="${1#*=}" ;;
      -h|--help) usage; return 0 ;;
      -*) die "$E_USAGE" "unknown flag: $1" ;;
      *) if [[ -z "$site" ]]; then site="$1"; else url="$1"; fi ;;
    esac; shift
  done
  [[ -n "$site" && -n "$url" ]] || die "$E_USAGE" "usage: 5dive browser shot <site> <url> [--out=<png>] [--dom=<file>] [--size=WxH|--full] [--wait=<ms>]"
  _valid_site "$site" || die "$E_USAGE" "'$site' is not a usable profile name"
  [[ "$size" =~ ^[0-9]{2,5}x[0-9]{2,5}$ ]] || die "$E_USAGE" "--size takes WxH in pixels, e.g. --size=1280x800; got: $size"
  [[ "$wait" =~ ^[0-9]{1,7}$ ]] || die "$E_USAGE" "--wait takes milliseconds; got: $wait"

  _page_open "$site" "$url"
  local dir="$_PG_DIR" chrome="$_PG_CHROME"

  local stamp; stamp=$(date -u +%Y%m%dT%H%M%SZ)
  [[ -n "$out" ]] || out="$PWD/${site}-${stamp}.png"
  local odir; odir=$(dirname "$out")
  [[ -d "$odir" ]] || die "$E_USAGE" "no directory $odir to write the PNG into"

  # --out AND --dom AT THE SAME PATH IS A REFUSAL (DIVE-4488 precision note).
  # The DOM is a SECOND load, and it runs AFTER the PNG has been written and
  # checked — so the same path means this prints "rendered ... <path>" over a
  # file that now holds HTML. The reader is told there is a screenshot there and
  # there is not, which is this verb's own failure mode wearing a new hat.
  if [[ -n "$domout" ]] && [[ "$(cd "$(dirname "$domout")" 2>/dev/null && pwd)/$(basename "$domout")" == "$(cd "$odir" && pwd)/$(basename "$out")" ]]; then
    die "$E_USAGE" "--out and --dom resolve to the same file ($out). The DOM is written after the PNG, so this would report a successful render over a file holding HTML. Give them separate paths."
  fi

  local w="${size%x*}" h="${size#*x}"

  # CLEAR THE DESTINATION BEFORE THE LAUNCH, not after the failure. The check
  # below asks "did THIS render write an image", and it answers with `-s "$out"`
  # — which a file left there by an EARLIER render satisfies for a chrome that
  # wrote nothing at all. That is the same lie this verb exists to refuse: a PNG
  # of yesterday's dashboard is exactly as evidence-shaped as a PNG of the
  # sign-in page, and the reader cannot tell either one from the real thing. The
  # reach is this command's own first consumer — a grader re-renders to the same
  # --out after a change and attaches the old image to the PR the merge rides on.
  # If the stale file cannot be removed, REFUSE: a destination we cannot clear
  # leaves chrome's exit status as the only evidence, and trusting that is the
  # thing the check exists not to do. (--dom= needs no equivalent: `>"$domout"`
  # truncates before chrome runs.)
  if ! rm -f "$out" 2>/dev/null || [[ -e "$out" ]]; then
    die "$E_UNAVAILABLE" "cannot clear $out before the render, so a file already there would be reported as this render's image. Remove it or choose another --out."
  fi

  # The flags are the security claim: --headless with NO --remote-debugging-*, so
  # this render opens no socket any other seat could reach. See the header.
  "$chrome" --headless --no-sandbox --disable-gpu --hide-scrollbars \
      --user-data-dir="$dir" --window-size="$w,$h" \
      --virtual-time-budget="$wait" --screenshot="$out" "$url" >/dev/null 2>&1
  local rc=$?
  if (( rc != 0 )) || [[ ! -s "$out" ]]; then
    rm -f "$out"
    die "$E_UNAVAILABLE" "the render produced no image (chrome exited $rc). Nothing was written — an empty, missing or stale PNG must not be reported as a screenshot."
  fi

  # The DOM is a SECOND load on purpose: --screenshot writes a file and
  # --dump-dom writes stdout, and asking one chrome for both gets whichever that
  # build decided wins. Two loads, each with one job, is the only shape whose
  # result is the same on every chrome.
  if [[ -n "$domout" ]]; then
    "$chrome" --headless --no-sandbox --disable-gpu \
        --user-data-dir="$dir" --virtual-time-budget="$wait" \
        --dump-dom "$url" >"$domout" 2>/dev/null
    local drc=$?
    if (( drc != 0 )) || [[ ! -s "$domout" ]]; then
      rm -f "$domout"
      printf '%s: WARNING — the PNG rendered but the DOM dump did not (chrome exited %s). %s was not written.\n' "$PROG" "$drc" "$domout" >&2
    fi
  fi

  _shot_restore
  trap - EXIT
  printf 'rendered %s as the logged-in %s profile\n  %s  (%sx%s)\n' "$url" "$site" "$out" "$w" "$h"
  [[ -n "$domout" && -s "$domout" ]] && printf '  %s  (DOM)\n' "$domout"
  return 0
}

# ------------------------------------------------------------- read / links
# `read` deliberately uses Chrome's --dump-dom rather than CDP. It gets the
# post-script DOM from the same authenticated profile and opens no debugger
# socket. The raw dump, the derived Markdown and the metadata travel together:
# callers can verify the hash and re-extract without revisiting the live page.
READ_WAIT_DEFAULT=8000
_READ_STAGE=""

_read_cleanup() {
  local d="$_READ_STAGE"; _READ_STAGE=""
  case "$d" in /tmp/5dive-browser-read.*) rm -rf -- "$d" ;; esac
  _shot_restore
}

_read_output_dir() { # _read_output_dir <site> <explicit-or-empty> <profile-dir>
  local site="$1" out="$2" profile="$3" base made=0 resolved profile_resolved
  if [[ -n "$out" ]]; then
    [[ ! -e "$out" || -d "$out" ]] || die "$E_USAGE" "$out exists and is not a directory"
    if [[ ! -d "$out" ]]; then
      (umask 077; mkdir -p -- "$out") || die "$E_UNAVAILABLE" "cannot create artifact directory $out"
      made=1
    fi
  else
    base="$(_seat_dir)/.read-artifacts"
    if [[ ! -d "$base" ]]; then
      (umask 077; mkdir -- "$base") || die "$E_UNAVAILABLE" "cannot create private artifact root $base"
      chmod 00700 "$base"
    fi
    _audit "$base" 700
    out="$(mktemp -d "$base/${site}.XXXXXXXX")" || die "$E_UNAVAILABLE" "cannot create a private artifact directory under $base"
    made=1
  fi

  # `--out` is evidence, never browser state. Resolve symlinks before comparing:
  # writing even one derived file into the profile makes it credential-adjacent
  # and makes later cleanup capable of deleting browser-owned data.
  resolved="$(realpath -m -- "$out")" || die "$E_USAGE" "cannot resolve artifact directory $out"
  profile_resolved="$(realpath -m -- "$profile")" || die "$E_USAGE" "cannot resolve browser profile $profile"
  case "$resolved/" in
    "$profile_resolved/"*)
      if (( made )); then rmdir -- "$out" 2>/dev/null || true; fi
      die "$E_PERM" "--out must not be the browser profile or live beneath it; choose an evidence directory outside $profile_resolved" ;;
  esac
  _audit "$out" 700 || die "$E_PERM" "$out must be owned by this seat and mode 0700"
  printf '%s\n' "$resolved"
}

_cmd_read_like() { # _cmd_read_like read|links <site> <url> [flags]
  local kind="$1"; shift
  local site="" url="" out="" json=0 wait="$READ_WAIT_DEFAULT"
  while (($#)); do
    case "$1" in
      --out=*) out="${1#*=}" ;;
      --json) [[ "$kind" == read ]] || die "$E_USAGE" "--json belongs to browser read; browser links already prints JSON"; json=1 ;;
      --wait=*) wait="${1#*=}" ;;
      -h|--help)
        printf '%s %s <site> <url> [--out=<dir>]%s [--wait=<ms>]\n' "$PROG" "$kind" "$([[ "$kind" == read ]] && printf ' [--json]')"
        return 0 ;;
      -*) die "$E_USAGE" "unknown flag: $1" ;;
      *) if [[ -z "$site" ]]; then site="$1"; elif [[ -z "$url" ]]; then url="$1"; else die "$E_USAGE" "unexpected argument: $1"; fi ;;
    esac
    shift
  done
  [[ -n "$site" && -n "$url" ]] || die "$E_USAGE" "usage: 5dive browser $kind <site> <url> [--out=<dir>]"
  _valid_site "$site" || die "$E_USAGE" "'$site' is not a usable profile name"
  [[ "$wait" =~ ^[0-9]{1,7}$ ]] || die "$E_USAGE" "--wait takes milliseconds; got: $wait"
  [[ -r "$READ_EXTRACTOR" ]] || die "$E_UNAVAILABLE" "the pinned page extractor is missing from this install ($READ_EXTRACTOR)"
  command -v node >/dev/null 2>&1 || die "$E_UNAVAILABLE" "node is required to run the pinned page extractor"
  command -v jq >/dev/null 2>&1 || die "$E_UNAVAILABLE" "jq is required to assemble the evidence metadata"

  # Authenticate BEFORE making the destination. A logged-out call writes
  # nothing — not even an empty output directory that looks like a failed read.
  _page_open "$site" "$url"
  local dir="$_PG_DIR" chrome="$_PG_CHROME"
  out="$(_read_output_dir "$site" "$out" "$dir")" || exit $?

  _READ_STAGE="$(mktemp -d /tmp/5dive-browser-read.XXXXXXXX)" || die "$E_UNAVAILABLE" "cannot stage the page evidence"
  trap '_read_cleanup' EXIT
  local stage="$_READ_STAGE"

  # One render, one source of truth. page.html is byte-for-byte stdout from this
  # invocation and every derived field below comes from that exact file.
  "$chrome" --headless --no-sandbox --disable-gpu \
      --user-data-dir="$dir" --virtual-time-budget="$wait" \
      --dump-dom "$url" >"$stage/page.html" 2>"$stage/chrome.err"
  local crc=$?
  if (( crc != 0 )) || [[ ! -s "$stage/page.html" ]]; then
    die "$E_UNAVAILABLE" "the authenticated DOM capture produced no page (chrome exited $crc); no evidence files were written"
  fi

  if ! node "$READ_EXTRACTOR" --url="$url" <"$stage/page.html" >"$stage/extracted.json"; then
    die "$E_UNAVAILABLE" "the pinned Defuddle extractor rejected the captured DOM; no evidence files were written"
  fi
  jq -e '.markdown | type == "string"' "$stage/extracted.json" >/dev/null || \
    die "$E_UNAVAILABLE" "the extractor returned no Markdown; no evidence files were written"

  local retrieved sha chrome_version
  retrieved="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  sha="$(sha256sum "$stage/page.html" | cut -d' ' -f1)"
  chrome_version="$($chrome --version 2>/dev/null | head -1)"
  [[ -n "$chrome_version" ]] || chrome_version="unknown"
  jq --arg retrieved_at "$retrieved" --arg sha256 "$sha" \
     --arg chrome_version "$chrome_version" \
     '. + {retrieved_at:$retrieved_at, sha256:$sha256, chrome_version:$chrome_version, capture:"dump-dom"}' \
     "$stage/extracted.json" >"$stage/full.json" || die "$E_UNAVAILABLE" "could not assemble page metadata"
  jq 'del(.markdown, .site)' "$stage/full.json" >"$stage/page.meta.json"

  {
    printf '%s\n' '---'
    jq -r '"url: " + (.url | @json), "canonical_url: " + (.canonical_url | @json), "title: " + (.title | @json), "description: " + (.description | @json), "author: " + (.author | @json), "published: " + (.published | @json), "retrieved_at: " + (.retrieved_at | @json), "word_count: " + (.word_count | tostring)' "$stage/full.json"
    printf '%s\n\n' '---'
    jq -r '.markdown' "$stage/full.json"
  } >"$stage/page.md"

  install -m 00600 "$stage/page.html" "$out/page.html" || die "$E_UNAVAILABLE" "cannot install page.html in $out"
  install -m 00600 "$stage/page.meta.json" "$out/page.meta.json" || die "$E_UNAVAILABLE" "cannot install page.meta.json in $out"
  install -m 00600 "$stage/page.md" "$out/page.md" || die "$E_UNAVAILABLE" "cannot install page.md in $out"

  if [[ "$kind" == links ]]; then
    jq '.links' "$stage/full.json"
  elif (( json )); then
    cat "$stage/full.json"
  else
    cat "$stage/page.md"
  fi
  printf '%s: artifacts: %s\n' "$PROG" "$out" >&2

  _READ_STAGE=""
  rm -rf -- "$stage"
  _shot_restore
  trap - EXIT
  return 0
}

cmd_read()  { _cmd_read_like read "$@"; }
cmd_links() { _cmd_read_like links "$@"; }

# ---------------------------------------------------------------------------
# DIVE-4446: the workflow is the product, and a Claude skill only teaches half
# the fleet. `doc` prints the SAME text as a plain file so a codex/grok/pi seat
# can read it, and `--append` installs it into that seat's instruction file.
# The block is marker-fenced and re-installing REPLACES it: an upgrade must not
# leave two divergent copies of a rule about spending a customer's only link.
DOC_FILE="${FIVEDIVE_BROWSER_DOC:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/AGENTS.md}"
DOC_BEGIN='<!-- 5dive:browser:begin -->'
DOC_END='<!-- 5dive:browser:end -->'

# Refuse a file whose 5dive browser fence is not exactly one well-formed pair.
# Named markers in the message, because the operator has to find them by eye.
_doc_fence_or_die() {
  local f="$1" nb ne lb le
  nb="$(grep -cF -- "$DOC_BEGIN" "$f")" || nb=0
  ne="$(grep -cF -- "$DOC_END"   "$f")" || ne=0
  [[ "$nb" == 0 && "$ne" == 0 ]] && return 0
  if [[ "$nb" != "$ne" ]]; then
    local missing="$DOC_END"
    [[ "$nb" -lt "$ne" ]] && missing="$DOC_BEGIN"
    die "$E_USAGE" "$f has a broken browser section: found $nb x '$DOC_BEGIN' and $ne x '$DOC_END' — the '$missing' marker is missing. Repair or delete that fence by hand, then re-run; nothing was written."
  fi
  if [[ "$nb" -gt 1 ]]; then
    die "$E_USAGE" "$f carries $nb copies of the browser section fence ('$DOC_BEGIN'). Leave exactly one, then re-run; nothing was written."
  fi
  lb="$(grep -nF -- "$DOC_BEGIN" "$f" | head -1 | cut -d: -f1)"
  le="$(grep -nF -- "$DOC_END"   "$f" | head -1 | cut -d: -f1)"
  if [[ "$le" -lt "$lb" ]]; then
    die "$E_USAGE" "$f has its browser section markers inverted: '$DOC_END' is on line $le, above '$DOC_BEGIN' on line $lb. Repair or delete that fence by hand, then re-run; nothing was written."
  fi
  return 0
}

cmd_doc() {
  local target=""
  for a in "$@"; do
    case "$a" in
      --append=*) target="${a#*=}" ;;
      -h|--help)  printf '%s doc [--append=<file>]\n' "$PROG"; return 0 ;;
      *) die "$E_USAGE" "unknown flag for doc: $a" ;;
    esac
  done
  [[ -r "$DOC_FILE" ]] || die "$E_UNAVAILABLE" "the agent doc is missing from this install ($DOC_FILE)"
  if [[ -z "$target" ]]; then cat "$DOC_FILE"; return 0; fi

  [[ -d "$(dirname "$target")" ]] || die "$E_USAGE" "no such directory: $(dirname "$target") — refusing to create one"
  [[ -e "$target" ]] || : > "$target"
  [[ -w "$target" ]] || die "$E_PERM" "cannot write $target as $(_seat)"

  # DIVE-4446 iteration 2. The rewrite below is a WHOLE-FILE replace, so a broken
  # fence is not a cosmetic problem: with a BEGIN and no END the awk skips to
  # end-of-input and every line the seat wrote after the marker is gone — and the
  # receipt still said "refreshed". The file class this feature targets (AGENTS.md,
  # CLAUDE.md) is hand-edited by definition, and half a marker pair is the normal
  # shape of a bad hand-edit. So an unbalanced or out-of-order fence is a REFUSAL,
  # before anything is staged: the operator repairs or deletes it, we do not guess
  # which half they meant. Appending a fresh block instead would be the worst of
  # both — their text still deleted, plus a second divergent copy of the rule.
  _doc_fence_or_die "$target"

  local tmp; tmp="$(mktemp "${target}.5dive.XXXXXX")" || die "$E_UNAVAILABLE" "could not stage a rewrite of $target"
  if grep -qF -- "$DOC_BEGIN" "$target"; then
    # Replace in place: everything outside the fence is the seat's own text.
    # The END-of-input assert is belt and braces on the guard above: if a future
    # edit to the marker logic ever lets an unterminated fence through, awk exits
    # non-zero and we die on the staged file rather than cat a truncated one over
    # the seat's work.
    awk -v b="$DOC_BEGIN" -v e="$DOC_END" -v f="$DOC_FILE" '
      index($0,b) { system("cat \"" f "\""); skip=1; next }
      index($0,e) { skip=0; next }
      !skip { print }
      END { if (skip) exit 3 }
    ' "$target" > "$tmp" || { rm -f "$tmp"; die "$E_UNAVAILABLE" "rewrite of $target failed — the browser section is unterminated and the file was left untouched"; }
    cat "$tmp" > "$target"; rm -f "$tmp"
    ok_doc "refreshed the browser section in $target"
  else
    { cat "$target"; printf '\n'; cat "$DOC_FILE"; } > "$tmp" || { rm -f "$tmp"; die "$E_UNAVAILABLE" "append to $target failed"; }
    cat "$tmp" > "$target"; rm -f "$tmp"
    ok_doc "installed the browser section into $target"
  fi
}
ok_doc() { printf '%s: %s\n' "$PROG" "$1"; }


# >>> DIVE-4348 a root caller operates the SEAT's store — as the seat
# The dashboard reaches every verb through shelld's whitelist, which is
# `sudo -n /usr/local/bin/5dive browser …`: root, with SUDO_USER=claude. _seat
# resolves that to claude, but _audit compares the store's owner to `id -u`, so
# as root every verb except setup refused with exit 77 ("owned by uid 1000, not
# by you (uid 0)") and GET /sites read every box as unavailable — measured on
# exact-swallow 2026-09-12. Root never operates a profile: it re-executes as the
# seat before any store is touched. `setup` stays root's by design (it chowns).
# runuser keeps the environment (FIVEDIVE_* overrides survive) and sets HOME/USER
# to the seat's, which is what Chrome and the adapters need.
if [[ $EUID -eq 0 && -n "${SUDO_USER:-}" && "${SUDO_USER}" != root ]]; then
  case "${1:-}" in
    setup|-h|--help|help|"") ;;
    *)
      _drop="${SUDO_USER}"
      id -u "$_drop" >/dev/null 2>&1 || die "$E_PERM" "SUDO_USER=$_drop is not a user on this box — refusing to operate a profile store as root"
      exec runuser -u "$_drop" -- "$0" "$@"
      ;;
  esac
fi
# <<< DIVE-4348

case "${1:-}" in
  -h|--help|help|"") usage ;;
  setup) shift; cmd_setup "$@" ;;
  auth)  shift; cmd_auth  "$@" ;;
  status) shift; _auth_status "${1:-}" ;;
  probe-all) shift; cmd_probe_all "$@" ;;
  ls)    shift; cmd_ls    "$@" ;;
  doc)   shift; cmd_doc  "$@" ;;
  run)   shift; cmd_run   "$@" ;;
  shot)  shift; cmd_shot  "$@" ;;
  read)  shift; cmd_read  "$@" ;;
  links) shift; cmd_links "$@" ;;
  serve) shift; cmd_serve "$@" ;;
  viewer) shift; cmd_viewer "$@" ;;
  viewer-redeem) shift; cmd_viewer_redeem "$@" ;;
  viewer-revoke) shift; cmd_viewer_revoke "$@" ;;
  *) die "$E_USAGE" "unknown: $PROG $1 (see: $PROG --help)" ;;
esac
