#!/usr/bin/env node
'use strict';
// 5dive browser — the real FIVEDIVE_BROWSER_DRIVER (DIVE-4524).
//
// WHAT THIS IS. `5dive browser run <site> <action>` validates an adapter, checks
// the session is live, and then hands a PLAN — {profile, steps, args} on stdin —
// to an executor. Until now there was no executor anywhere: `run` died "no
// executor backend" on every box, so a logged-in profile was a credential with
// no consumer. This is that executor.
//
// ---- WHY PLAYWRIGHT, WHEN bin/browser USED TO REFUSE IT ----------------------
//
// The old refusal said: "Playwright is the right tool for BUILDING an adapter
// and the wrong one for running it." That sentence was about a DIFFERENT
// Playwright shape — one that launches its own throwaway browser, which would
// have thrown the hand-logged-in profile away and made the whole design
// pointless. It is REVERSED here, deliberately and by direction (DIVE-4488 body,
// main, 2026-09-14), on one property that the throwaway shape does not have:
//
//   launchPersistentContext(<the seat's own 0700 profile dir>) speaks CDP over
//   --remote-debugging-pipe — file descriptors 3 and 4 of the child — and opens
//   NO LISTENING SOCKET.
//
// That is the same security claim `shot` makes and for the same reason: a
// loopback --remote-debugging-port is reachable by EVERY SEAT ON THE BOX, and
// CDP is full control of the browser holding the session. A seat that could
// never open the 0700 profile directory would get the session anyway, with no
// file permission needed, and the 0700 mode would be decorative. Over the pipe
// there is nothing to reach: the only process that can speak to this browser is
// the one that launched it. _launch_args() below REFUSES any --remote-debugging-*
// argument, so the port cannot come back by way of a config edit either.
//
// ---- THE DRIVER IS NOT A PROGRAM HOST ---------------------------------------
//
// bin/browser already refuses a step outside the fixed vocabulary at load time.
// This re-checks it rather than trusting its caller: the driver is an executable
// whose path is an environment variable, so "the plan was validated upstream" is
// an assumption about a process we do not control. There is no eval, no script
// step, no free-text instruction — an adapter that could express anything would
// be freeform reasoning with extra syntax.
//
// Arguments reach the page as VALUES through the Playwright API (fill/press/
// selectOption take strings), never spliced into a command line or a selector.

const fs = require('fs');
const path = require('path');
// DIVE-4588. The ref layer is a SIBLING FILE addressed by path, not a package
// name: the whole point of playwrightDirs() below is that this process does not
// resolve code by walking ancestor node_modules, and a bare require('aria')
// would reintroduce exactly that.
const aria = require(path.join(__dirname, '..', 'lib', 'aria.cjs'));
const point = require(path.join(__dirname, '..', 'lib', 'point.cjs'));   // DIVE-8241
// DIVE-4951: the seat's own proxy, parsed in ONE place for both launch sites.
const proxy = require(path.join(__dirname, '..', 'lib', 'proxy.cjs'));
const totp = require(path.join(__dirname, '..', 'lib', 'totp.cjs'));
// DIVE-6844: never type a saved login on a page outside its own site.
function savedHostCheck(page, s) {
  if (s.host && !totp.hostAllowed(page.url(), s.host)) {
    throw new Error(`this saved login is for ${s.host}, and the page is not on it (${(() => { try { return new URL(page.url()).host; } catch { return 'unknown'; } })()}); nothing was typed`);
  }
}
const downloads = require(path.join(__dirname, '..', 'lib', 'downloads.cjs'));
const gsignin = require(path.join(__dirname, '..', 'lib', 'google-signin.cjs'));
const popup = require(path.join(__dirname, '..', 'lib', 'popup.cjs'));
const cleanExit = require(path.join(__dirname, '..', 'lib', 'clean-exit.cjs'));

// DO NOT DELETE THIS. It is not dead code — it is the fix for DIVE-4587, and the
// full mechanism is written out at the top of bin/browser. In one paragraph:
// Chrome keeps its crashpad database at $XDG_CONFIG_HOME/google-chrome/Crash
// Reports whatever --user-data-dir and --crash-dumps-dir say, and creates it
// 0700; 5dive boxes export ONE shared XDG_CONFIG_HOME to every seat, so the
// first seat to run Chrome owns that directory and every other seat's launch
// CHECK-fails ("chrome_crashpad_handler: --database is required", rc 133, no
// output). Unsetting it gives each seat its own crash dir under its own home.
//
// bin/browser already unsets it, so in the shipped path this is redundant — and
// it is here for the same reason this file re-validates a plan bin/browser
// already validated: the driver is an executable whose path is an environment
// variable (FIVEDIVE_BROWSER_DRIVER), so "my parent did it" is an assumption
// about a process we do not control. The cost of the second unset is nothing;
// the cost of being wrong about the parent is a browser that cannot launch.
// DIVE-5638: bin/browser now hands Chrome a crash dir of its own (a per-launch
// 0700 dir, named twice so it can be told from the shared value). Keep that one.
if (!process.env.FIVEDIVE_BROWSER_CHROME_CONFIG ||
    process.env.XDG_CONFIG_HOME !== process.env.FIVEDIVE_BROWSER_CHROME_CONFIG) {
  delete process.env.XDG_CONFIG_HOME;
}

const PROG = '5dive browser run';
// THE EXIT CODE IS A CONTRACT, and 70 is the load-bearing one.
//
// `5dive browser run` does not trust a driver's exit status — the verdict is an
// out-of-band re-read of the artifact, because "published and reported failure"
// is real and a blind retry on it double-posts. That re-read is only meaningful
// if the action actually RAN. If the executor never opened the browser, the
// re-read grades whatever was already at that URL: for an adapter whose verify
// URL is an existing page, an executor that does not exist on this box reports
// SUCCESS for an action nobody performed. Vacuous green, with a receipt.
//
// So every refusal RAISED BEFORE THE FIRST STEP exits 70, which bin/browser
// treats as "nothing ran, there is nothing to verify". After the first step, a
// failure is 1 and the re-read governs — that half is the whole design.
const E_NOTHING_RAN = 70, E_FAILED = 1;

// "BEFORE THE FIRST STEP" IS NOT "BEFORE THE LAUNCH", and reading it as the
// launch is how this contract was one call short (DIVE-4524 iteration 1).
// Guarding the launch alone leaves a window — acquiring the page, arming the
// timeout, anything ever hoisted above the loop — in which the browser is OPEN
// and NOT ONE STEP has run. A throw in that window used to exit 1, which is the
// "a step failed, re-read the artifact" code, so bin/browser re-read a verify
// URL that already existed and reported a publish nobody performed: this file's
// own named defect, alive inside the change that exists to close it.
//
// The boundary is therefore a COUNTER, not a second try block. A counter is the
// property itself ("did any step run?") rather than a place in the file that has
// to be kept true as the file changes, so code hoisted above the loop later is
// covered without anyone remembering this comment. It is module-scope because
// the outermost .catch() must read the same number.
//
// A step COUNTS AS RUN once its await is entered, not once it returns: a goto
// that throws may already have navigated, a click may already have posted. The
// expensive direction of a wrong answer here is claiming nothing ran when
// something did — that is the blind retry that double-posts.
let stepsRun = 0;
let signedIn = false;   // DIVE-7168: the owner's sign-in record, once per act
const stepFailure = () => (stepsRun ? E_FAILED : E_NOTHING_RAN);

// The same list bin/browser enforces. Kept here as a literal on purpose: two
// copies that must agree is the point — this one is the one that runs.
const STEPS = {
  goto:     ['url'],
  fill:     ['selector', 'value'],
  type:     ['selector', 'value'],
  click:    ['selector'],
  wait_for: ['selector'],
  select:   ['selector', 'value'],
  upload:   ['selector', 'path'],
  press:    ['selector', 'key'],
};
const STEP_TIMEOUT = Number(process.env.FIVEDIVE_BROWSER_STEP_TIMEOUT || 30000);
// AN AGENT'S STEP GIVES UP SOONER THAN A RECIPE'S (DIVE-6778). `act` sends
// step_ms (10 s by default): its steps are the agent's guesses, and a wait_for
// for text that never shows, or a click on a covered element, waited the whole
// 30 s and failed anyway (bench: 40 s acts against 3-4 s for a rival's click).
// A goto keeps the page-load bound; `run`'s reviewed recipes send none.
const stepLimit = (req) => {
  const n = Number(req && req.step_ms);
  return Number.isInteger(n) && n > 0 && n < STEP_TIMEOUT ? n : STEP_TIMEOUT;
};

// THE SETTLE `run` DID NOT HAVE (DIVE-4674). `tree` and `snapshot` wait after
// domcontentloaded because a live page is still assembling itself there; `run`
// went from `goto` straight to the next step, so the very refs `tree` printed at
// a settle were resolved by `run` about fifty milliseconds after DCL and missed.
// Same knob, same bound, same reason it is NEVER `waitUntil: 'networkidle'` — a
// web app that long-polls never idles, and waiting for it is what made a `read`
// hang for 150s on a real box.
//
// A FLOOR, NOT A FIX. The settle is how long the page is given before anyone
// looks; a genuinely late element is `wait_for`'s job, which now actually waits.
const RUN_SETTLE_MS = Number(
  process.env.FIVEDIVE_BROWSER_RUN_SETTLE_MS
  || process.env.FIVEDIVE_BROWSER_TREE_SETTLE_MS
  || 1200);
// The re-read of a popup that came into view, or a page that moved, during the
// report (DIVE-7680): its first document has loaded already, so a short settle.
const POPUP_REREAD_SETTLE_MS = Number(process.env.FIVEDIVE_BROWSER_POPUP_REREAD_SETTLE_MS) || 300;

// ---- THE LEASE, RE-READ BEFORE EVERY STEP (DIVE-4588) -----------------------
//
// bin/browser holds a per-site lease for the whole of this run and hands its
// file and token down. This function is why it hands down a FILE and not just a
// boolean: the lease can be taken away MID-RUN, and the only case that matters
// is the one where it is taken by a PERSON. Someone redeems a viewer, gets a
// keyboard inside this exact browser, and starts clearing a captcha or finishing
// a login — while this process is three steps into a publish.
//
// Checking once at the start would protect keystroke one and nothing after it.
// So the token is re-read from disk before each step, and a mismatch stops the
// run where it stands.
//
// IT IS A FAILURE, NOT A REFUSAL, AND THAT DISTINCTION IS THE CAREFUL PART. If
// steps have already run, this exits 1 and bin/browser goes and RE-READS the
// artifact out of band — because an action interrupted at step 6 of 8 may well
// have published, and reporting "nothing happened" about a run that half
// happened is how a retry double-posts. `stepFailure()` already encodes exactly
// that rule, so this reuses it rather than choosing a code.
//
// A run with NO lease in its environment is not policed here. That is
// deliberate: FIVEDIVE_BROWSER_DRIVER is a documented seam (the Browser Hand
// shape drives its own browser), and a driver that refused to start without a
// variable its caller may not set would break that seam to enforce a lock the
// caller never took. bin/browser always sets it.
const LEASE_FILE = process.env.FIVEDIVE_BROWSER_LEASE || '';
const LEASE_TOKEN = process.env.FIVEDIVE_BROWSER_LEASE_TOKEN || '';
function leaseStillOurs() {
  if (!LEASE_FILE || !LEASE_TOKEN) return null;   // no lease was handed down
  let txt;
  try { txt = fs.readFileSync(LEASE_FILE, 'utf8'); }
  catch (e) { return 'gone'; }                    // the directory was removed under us
  const m = txt.match(/^token=(.*)$/m);
  return m && m[1] === LEASE_TOKEN ? null : 'taken';
}
function assertLease(where) {
  const lost = leaseStillOurs();
  if (!lost) return;
  const why = lost === 'gone'
    ? 'the lease on this browser was released or reaped while this run was in progress'
    : 'the lease on this browser was TAKEN by someone else — a person redeeming a viewer preempts an agent';
  throw new Error(
    `${where}: refusing to continue — ${why}. Stopping here rather than typing into a session ` +
    `somebody else is using. Whatever steps already ran are still real: bin/browser re-reads the ` +
    `artifact out of band and that re-read, not this message, is the verdict.`);
}

function die(code, msg) { process.stderr.write(`${PROG}: ${msg}\n`); process.exit(code); }

// A PIPE IS NOT A FILE (DIVE-4991). bin/browser reads what `tree` and `snapshot`
// print through `$( … )`, and `process.exit` drops whatever that pipe has not taken
// yet: the first 64 KB arrive and the rest never does (measured: 2 MB written,
// 65536 bytes read). A real page's node list is past that, so a cold `read
// --wait-for` got a cut payload, found no `wait_for` in it, and blamed "a session
// daemon from before --wait-for existed" that was not in the path at all. The exit
// waits for the write to be flushed — the rule the session daemon's client half
// has followed since DIVE-4794.
async function printAndExit(obj, code = 0) {
  await new Promise((resolve) => process.stdout.write(JSON.stringify(obj) + '\n', resolve));
  process.exit(code);
}

// {key} -> args.key, as a VALUE. A placeholder with no argument is a REFUSAL and
// not a passthrough: the dual of this bug is already known on the verify side —
// an uninterpolated {slug} in verify.expect can never match, so every publish
// reads as NOT VERIFIED. On the STEP side the same slip is worse than noisy, it
// is wrong: a fill that posts the literal text "{body}" has published garbage to
// a real account, and the out-of-band verify cannot tell you it was garbage
// because the artifact really is live.
//
// `enc` (DIVE-4984): a value going into a URL is ENCODED. A subject with `&`, `#`
// or a space spliced raw into `?su=` ends the parameter early, and the composer
// opens with half the subject and the rest read as other parameters.
function interp(s, args, where, enc) {
  if (typeof s !== 'string') return s;
  const out = s.replace(/\{([a-zA-Z0-9_]+)\}/g, (m, k) =>
    Object.prototype.hasOwnProperty.call(args, k) ? (enc ? enc(String(args[k])) : args[k]) : m);
  const left = out.match(/\{[a-zA-Z0-9_]+\}/);
  if (left) {
    die(E_NOTHING_RAN, `${where} still contains ${left[0]} — no --${left[0].slice(1, -1)}=<value> was passed. ` +
      `Refusing rather than typing the placeholder into the page: that publishes literal "${left[0]}" ` +
      `to a real account, and the out-of-band verify would confirm it as live.`);
  }
  return out;
}

// THE SECURITY CLAIM, as code rather than as a comment. Anything that would open
// a socket another seat could reach is refused here, so it cannot be
// reintroduced by an env var or a later edit without this failing loudly.
function launchArgs() {
  const extra = (process.env.FIVEDIVE_BROWSER_CHROME_ARGS || '').split(/\s+/).filter(Boolean);
  // DIVE-7204: a kept profile, headed when there is a display, so no "Restore pages?" bubble.
  const args = ['--no-sandbox', '--disable-gpu', '--hide-scrollbars', '--hide-crash-restore-bubble',
    ...aria.unmarkedArgs(extra), ...extra];
  const bad = args.filter(a => /^--remote-debugging/.test(a));
  if (bad.length) {
    die(E_NOTHING_RAN, `refusing to launch with ${bad.join(' ')}. CDP here goes over --remote-debugging-pipe ` +
      `(the child's fds 3/4), which opens no listening socket. A debug PORT is reachable by every seat on ` +
      `this box and CDP is full control of the browser holding the session — it would hand the session to a ` +
      `seat that could never open the 0700 profile directory.`);
  }
  return args;
}

// WHERE playwright-core COMES FROM IS PART OF THE SECURITY CLAIM, so it is not
// left to ambient state. A bare require() walks `node_modules` in EVERY ancestor
// directory of this file, and this process is the one that opens a profile
// holding somebody's live sessions — so unpacking the plugin somewhere that
// happens to sit under a `node_modules/playwright-core` hands the driver a
// library nobody chose or pinned. Measured under DIVE-4524: a checkout under
// /tmp silently loaded /tmp/node_modules/playwright-core.
//
// The order is fixed and short, and there is no ancestor walk:
//   1. the directories NODE_PATH names, if any — an operator's explicit choice,
//      and the only lever the harness uses to put a recording stub here;
//   2. the plugin's OWN node_modules, where package.json pins it exact.
// Nothing else resolves, so "not installed" is a fact about those two places
// rather than about wherever the plugin happens to have been unpacked.
function playwrightDirs() {
  const named = (process.env.NODE_PATH || '').split(path.delimiter).filter(Boolean);
  return [...named, path.join(__dirname, '..', 'node_modules')];
}

function loadPlaywright() {
  for (const dir of playwrightDirs()) {
    const cand = path.join(dir, 'playwright-core');
    if (!fs.existsSync(cand)) continue;
    try { return require(cand); }
    catch (e) {
      // It is THERE and it will not load. That is not "not installed", and
      // saying so would send the reader to reinstall something already present.
      die(E_NOTHING_RAN, `playwright-core at ${cand} could not be loaded: ${e.message}`);
    }
  }
  {
    die(E_NOTHING_RAN, `playwright-core is not installed for this seat, so there is no executor. ` +
      `Install the pinned version next to the plugin:  npm install --prefix ` +
      `${__dirname}/..  (it is pinned in the plugin's package.json). ` +
      `This driver does NOT fall back to a throwaway browser: a run that is not inside the profile a ` +
      `person logged into by hand is not the thing that was asked for.`);
  }
}

// A HEADED BROWSER ON A DISPLAY OF ITS OWN (DIVE-6371). Every cold page load
// (snapshot, tree, act, run, totp) used to be HEADLESS Chrome, and Cloudflare
// challenges headless Chrome and lets a headed one through. Measured on
// exact-swallow: the agent's snapshot of a Cloudflare site, headless in the
// public profile, stopped at "Just a moment..." for its whole 30 s, while the
// owner's headed viewer on the same box and the same IP loaded the page with
// no check. So the agent was being judged on the browser MODE, not the IP.
//
// The fix is the shape `serve` already has: a real (headed) Chrome on an Xvfb.
// This one is private to the run: Xvfb picks a free display itself
// (-displayfd, so there is no race on a display number), listens on no TCP
// port, and dies with the run (killed on exit, and -terminate ends it when the
// browser disconnects, so a killed driver does not leave it behind).
//
// HEADLESS IS THE FALLBACK, NEVER SILENT. A box with no Xvfb (or
// FIVEDIVE_BROWSER_HEADLESS=1) still runs, headless, and says so on stderr and
// in a snapshot's payload (browser_mode), so a challenge it meets is named as a
// headless one rather than as "this site blocks the box".
const DISPLAY_WAIT_MS = Number(process.env.FIVEDIVE_BROWSER_DISPLAY_WAIT_MS || 5000);
let privateDisplay = null;
let browserMode = null;
process.on('exit', () => { if (privateDisplay) { try { privateDisplay.kill('SIGTERM'); } catch (e) { /* already gone */ } } });
function startDisplay() {
  if (process.env.FIVEDIVE_BROWSER_HEADLESS === '1') return Promise.resolve({ why: 'FIVEDIVE_BROWSER_HEADLESS=1 asked for it' });
  const bin = process.env.FIVEDIVE_BROWSER_XVFB || 'Xvfb';
  return new Promise((resolve) => {
    let done = false, buf = '', child, timer;
    const finish = (r) => { if (done) return; done = true; clearTimeout(timer); resolve(r); };
    try {
      child = require('child_process').spawn(bin,
        ['-displayfd', '1', '-screen', '0', '1280x800x24', '-nolisten', 'tcp', '-terminate'],
        { stdio: ['ignore', 'pipe', 'ignore'] });
    } catch (e) { finish({ why: `${bin} would not start (${e.message})` }); return; }
    timer = setTimeout(() => {
      try { child.kill('SIGKILL'); } catch (e) { /* gone */ }
      finish({ why: `${bin} named no display within ${DISPLAY_WAIT_MS} ms` });
    }, DISPLAY_WAIT_MS);
    child.on('error', (e) => finish({ why: `there is no ${bin} on this box (${e.code || e.message})` }));
    child.on('exit', (c, sig) => finish({ why: `${bin} exited (${sig || c}) before naming a display` }));
    child.stdout.on('data', (d) => {
      buf += d;
      const m = buf.match(/^(\d+)\s/);
      if (!m) return;
      privateDisplay = child;
      child.stdout.destroy(); child.unref();
      finish({ display: `:${m[1]}` });
    });
  });
}

// The launch every mode shares. Named once so `tree` cannot acquire a second,
// laxer way into a directory holding somebody's live session.
async function openProfile(profile) {
  if (!profile) die(E_NOTHING_RAN, 'the plan names no profile directory');
  if (!fs.existsSync(profile)) die(E_NOTHING_RAN, `no profile directory at ${profile}`);
  const chrome = process.env.FIVEDIVE_BROWSER_CHROME;
  if (!chrome) {
    die(E_NOTHING_RAN, 'no chrome named for this run — a run must use the same browser the profile was ' +
      'logged in with, so the executable is passed in rather than guessed here.');
  }
  // DIVE-4951. Unset adds NO key, so the launch is exactly what it was before.
  let viaProxy;
  try { viaProxy = proxy.launchProxy(profile); } catch (e) { die(E_NOTHING_RAN, e.message); }
  const route = proxy.launchRoute(viaProxy);   // DIVE-7643, as the session daemon
  const { chromium } = loadPlaywright();
  const shown = await startDisplay();
  browserMode = shown.display ? 'headed' : 'headless';
  // process.env, not an `env` option: Chrome inherits it whole (TMPDIR, DIVE-5190).
  if (shown.display) process.env.DISPLAY = shown.display;
  else {
    process.stderr.write(`${PROG}: NOTE — this browser runs HEADLESS: ${shown.why}. Sites behind ` +
      `Cloudflare challenge a headless browser that a headed one passes, so a "Just a moment..." here may ` +
      `not be what the owner's browser sees.\n`);
  }
  cleanExit.markCleanExit(profile);   // DIVE-7204, as the session daemon
  try {
    return await chromium.launchPersistentContext(profile, {
      headless: !shown.display,
      executablePath: chrome,
      args: [...launchArgs(), ...route.args],
      viewport: { width: 1280, height: 800 },
      ...route.option,
    });
  } catch (e) {
    die(E_NOTHING_RAN, `could not open the ${profile} profile: ${e.message}`);
  }
}

// `tree` — what is on this page, addressable. Prints JSON on stdout; bin/browser
// renders it. Exit 70 on every refusal, for the same reason the rest of this
// file does: a caller must be able to tell "the page had no such element" from
// "this box could not open a browser at all".
async function treeMode(plan) {
  const profile = process.env.FIVEDIVE_BROWSER_PROFILE || plan.profile;
  if (typeof plan.url !== 'string' || !/^https?:\/\//.test(plan.url)) {
    die(E_NOTHING_RAN, 'tree needs an http(s) url to enumerate');
  }
  const ctx = await openProfile(profile);
  let payload;
  try {
    const page = ctx.pages()[0] || await ctx.newPage();
    page.setDefaultTimeout(STEP_TIMEOUT);
    assertLease('tree');
    await page.goto(plan.url, { waitUntil: 'domcontentloaded' });
    // WAIT FOR THE PAGE TO SETTLE, AND NEVER FOR NETWORK IDLE. A live web app
    // (Gmail, a dashboard) long-polls and never idles — that is measured, it is
    // what makes `read` hang for 150s on the teal-fox box. A short settle after
    // domcontentloaded is what a tree needs and is bounded by construction.
    await page.waitForTimeout(Number(process.env.FIVEDIVE_BROWSER_TREE_SETTLE_MS || 1200));
    const { nodes } = await aria.walk(page, { interactiveOnly: !!plan.interactive });
    payload = { url: plan.url, nodes };
  } catch (e) {
    die(E_NOTHING_RAN, `could not enumerate ${plan.url}: ${e.message}`);
  } finally {
    try { await ctx.close(); } catch (e) { /* the tree is already walked */ }
  }
  await printAndExit(payload);
}

// `snapshot` — ONE browser, ONE navigation, ONE page-side read (DIVE-4653).
//
// WHAT IT REPLACES. An agent orienting on a page ran three commands: `tree` for
// the refs (this driver), `read` for the text (a second chrome, --dump-dom) and
// `shot` for the picture (a third chrome, --screenshot). Each one opens a
// browser, probes the session and loads the same URL again. jev-ultrafast
// measured the same shape upstream and put the number at 1092 protocol calls for
// a task that needs 101: the cost is not the work, it is asking for it in
// pieces.
//
// The pieces here are not independent, either. Three loads are three different
// page instants, so a ref printed by `tree` can be gone from the DOM `read`
// captured — and the two files land next to each other in an artifact directory
// looking like one observation. Taking all of it inside one page.evaluate makes
// that impossible rather than unlikely.
//
// THE HTML AND THE PNG GO TO FILES, not to stdout. stdout carries the decision
// payload (url, title, nodes) and a caller reads it with jq; a document is
// megabytes and a PNG is not text. Both paths are named by the caller, which
// already made them inside the seat's own 0700 artifact directory.
async function snapshotMode(plan) {
  const profile = process.env.FIVEDIVE_BROWSER_PROFILE || plan.profile;
  if (typeof plan.url !== 'string' || !/^https?:\/\//.test(plan.url)) {
    die(E_NOTHING_RAN, 'snapshot needs an http(s) url to capture');
  }
  if (typeof plan.html !== 'string' || !plan.html.startsWith('/')) {
    die(E_NOTHING_RAN, 'snapshot needs an absolute path to write the captured document to');
  }
  const ctx = await openProfile(profile);
  let payload;
  try {
    const page = ctx.pages()[0] || await ctx.newPage();
    page.setDefaultTimeout(STEP_TIMEOUT);
    assertLease('snapshot');
    // The document's own HTTP status (DIVE-6725): a 404 is a page too, and a
    // caller that hands this URL to a person needs to know it is one.
    const resp = await page.goto(plan.url, { waitUntil: 'domcontentloaded' });
    // A Cloudflare "Just a moment..." clears in this same load, or not at all
    // (DIVE-6317). A --wait-for behind one that never cleared would only wait again.
    const inter = await aria.waitInterstitial(page);
    // --wait-for (DIVE-4983): the page says it is ready, bounded by the step
    // timeout; the settle below then gives the rest of it a moment, as before.
    const waited = plan.wait_for
      ? await aria.waitForPast(page, String(plan.wait_for), inter, { timeoutMs: stepLimit(plan) }) : null;
    // NEVER network idle, for the reason written above treeMode: a live web app
    // long-polls and never idles, and waiting for it is what makes a read hang.
    await page.waitForTimeout(Number(process.env.FIVEDIVE_BROWSER_TREE_SETTLE_MS || 1200));
    const snap = await aria.snapshot(page, { interactiveOnly: !!plan.interactive });
    fs.writeFileSync(plan.html, snap.html || '', { mode: 0o600 });
    // The PNG is a SECOND protocol call and NOT a second load: same browser,
    // same tab, same document as the walk above. That is the whole difference
    // from `shot`, which opens its own chrome and navigates again.
    if (plan.shot) await page.screenshot({ path: plan.shot, fullPage: !!plan.full });
    payload = {
      url: snap.url || plan.url,
      title: snap.title || '',
      nodes: snap.nodes || [],
      html_bytes: Buffer.byteLength(snap.html || ''),
      png: plan.shot || null,
      ...(waited ? { wait_for: waited } : {}),
      ...(inter ? { interstitial: inter } : {}),
      browser_mode: browserMode,
      ...(resp ? { http_status: resp.status() } : {}),
    };
  } catch (e) {
    die(E_NOTHING_RAN, `could not capture ${plan.url}: ${e.message}`);
  } finally {
    try { await ctx.close(); } catch (e) { /* the capture is already on disk */ }
  }
  await printAndExit(payload);
}

// `read <url> <url>…` — SEVERAL PAGES, ONE BROWSER, LOADED SIDE BY SIDE (DIVE-6732).
// The bench's R1 sent three `read`s at once and they came back ~9 s apart: one
// profile is one Chrome, so the lease put them in a line. Here every page gets
// its own tab of the one persistent context and all of them load at the same
// time. A page that fails is named in its own entry; the others still land.
async function readMode(plan) {
  const profile = process.env.FIVEDIVE_BROWSER_PROFILE || plan.profile;
  const pages = Array.isArray(plan.pages) ? plan.pages : [];
  if (!pages.length) die(E_NOTHING_RAN, 'read needs at least one page to capture');
  for (const p of pages) {
    if (!p || typeof p.url !== 'string' || !/^https?:\/\//.test(p.url)) die(E_NOTHING_RAN, 'read needs http(s) urls to capture');
    if (typeof p.html !== 'string' || !p.html.startsWith('/')) die(E_NOTHING_RAN, 'read needs an absolute path to write each document to');
  }
  const ctx = await openProfile(profile);
  let results;
  try {
    assertLease('read');
    const settle = Number(process.env.FIVEDIVE_BROWSER_TREE_SETTLE_MS || 1200);
    results = await Promise.all(pages.map(async (p, i) => {
      try {
        const page = (i === 0 && ctx.pages()[0]) || await ctx.newPage();
        page.setDefaultTimeout(STEP_TIMEOUT);
        await page.goto(p.url, { waitUntil: 'domcontentloaded' });
        const inter = await aria.waitInterstitial(page);
        await page.waitForTimeout(settle);
        const html = await page.content();
        fs.writeFileSync(p.html, html, { mode: 0o600 });
        return { url: p.url, ok: true, html_bytes: Buffer.byteLength(html), ...(inter ? { interstitial: inter } : {}) };
      } catch (e) {
        return { url: p.url, ok: false, error: e.message };
      }
    }));
  } finally {
    try { await ctx.close(); } catch (e) { /* the pages are already on disk */ }
  }
  await printAndExit({ pages: results, browser_mode: browserMode });
}

// `act`'s re-read (DIVE-4943): the page as the steps left it, to the files
// bin/browser named. Never fatal — a missing re-read is reported by bin/browser
// as "not verified", which is the honest answer, and must not turn a step that
// DID run into "nothing ran".
//
// DIVE-4983: it waits for --wait-for, polls --expect for its window, and writes
// the refs too (report.tree), so an act leaves what a snapshot leaves.
// THE OWNER'S AUTHENTICATOR CODE (DIVE-5336). One page, one field, one code,
// and the line printed back names the field, never the code — see lib/totp.cjs.
async function totpMode(plan) {
  const profile = process.env.FIVEDIVE_BROWSER_PROFILE || plan.profile;
  if (typeof plan.url !== 'string' || !/^https?:\/\//.test(plan.url)) {
    die(E_NOTHING_RAN, 'totp needs the http(s) url where the site asks for the code');
  }
  const ctx = await openProfile(profile);
  let payload;
  try {
    const page = ctx.pages()[0] || await ctx.newPage();
    page.setDefaultTimeout(STEP_TIMEOUT);
    assertLease('totp');
    payload = await totp.fill(page, profile, { url: plan.url, base: plan.host, settleMs: RUN_SETTLE_MS });
  } catch (e) {
    die(E_FAILED, `could not type the authenticator code: ${e.message}`);
  } finally {
    try { await ctx.close(); } catch (e) { /* the code is already typed or not */ }
  }
  await printAndExit(payload);
}

// `download` (DIVE-7646): the bytes at one URL, fetched through this profile's
// own request client so its cookies ride along, written into plan.dir (the
// caller's 0700 stage: this process IS the caller) with the .manifest.json an
// act's downloads leave. Prints { ok, name, bytes, type, url } or { ok:false, error }.
async function downloadMode(plan) {
  const profile = process.env.FIVEDIVE_BROWSER_PROFILE || plan.profile;
  if (typeof plan.url !== 'string' || !/^https?:\/\//.test(plan.url)) die(E_NOTHING_RAN, 'download needs an http(s) url');
  if (typeof plan.dir !== 'string' || !plan.dir.startsWith('/') || !fs.existsSync(plan.dir)) die(E_NOTHING_RAN, 'download needs an absolute directory to write the file into');
  const ctx = await openProfile(profile);
  let res;
  try {
    assertLease('download');
    const r = await downloads.fetchFile(ctx, plan.url);
    if (!r.ok) res = { ok: false, error: r.error };
    else {
      const w = { list: [], files: [{ name: r.name, type: r.type, buf: r.buf }] };
      const [e] = await downloads.save(w, plan.dir);
      fs.writeFileSync(path.join(plan.dir, '.manifest.json'),
        JSON.stringify([{ name: e.name, bytes: e.bytes, error: e.error, type: e.type }]), { mode: 0o600 });
      res = e.error ? { ok: false, error: e.error } : { ok: true, name: e.name, bytes: e.bytes, type: e.type, url: r.url };
    }
  } catch (e) {
    res = { ok: false, error: e.message };
  } finally {
    try { await ctx.close(); } catch (e) { /* the file is already on disk */ }
  }
  await printAndExit({ ...res, browser_mode: browserMode }, res.ok ? 0 : E_FAILED);
}

async function writeReport(page, report, pop, { failed = false } = {}) {
  try {
    // AFTER A FAILED STEP NOTHING IS WAITED FOR (DIVE-6778): the run fails whatever
    // --expect or --wait-for would find (DIVE-4990), so polling for them only
    // added up to 5 s (--expect) or 30 s (--wait-for) to a verdict already known.
    // The page is still read once, as it is, for the picture and the refs.
    const readOpts = (ms) => ({
      settleMs: ms, waitFor: failed ? null : (report.wait_for || null), waitTimeoutMs: STEP_TIMEOUT,
      expect: report.expect || null, expectWaitMs: failed ? 0 : (Number(report.expect_wait_ms) || 0),
      walk: report.tree ? { interactiveOnly: !!report.interactive } : null,
      scope: report.scope || null, expectDoc: !!report.expect_doc,
    });
    let after = await aria.pageAfter(page, readOpts(failed ? Math.min(aria.FAILED_SETTLE_MS, RUN_SETTLE_MS) : RUN_SETTLE_MS));
    // ONE REPORT, ONE PAGE (DIVE-7680): a popup that arrived during the settle is
    // the page in view, so the report is of it (as bin/session-daemon sendReport).
    if (pop && pop.waiting) {
      const was = page;
      try { page = await pop.drain(); } catch (e) { /* the page we have */ }
      if (page !== was) after = await aria.pageAfter(page, readOpts(POPUP_REREAD_SETTLE_MS));
    }
    // ...and a page that moved between the read and the picture is read again,
    // so url, title, refs and png describe the same page.
    if (report.shot) {
      // DIVE-8051: the picture shows what --expect matched, scrolled to it when it is off screen.
      if (!failed && report.expect && !report.scope) {
        const shown = await aria.showExpect(page, report.expect, after.text);
        if (shown && shown.scrolled) process.stderr.write(`  the picture is scrolled to what --expect matched: "${shown.text}"\n`);
      }
      await page.screenshot({ path: report.shot });
      const moved = aria.movedSince(page, after);
      if (moved) {
        process.stderr.write(`  the page moved while it was being read (${moved}); read again so the picture and the page agree\n`);
        after = await aria.pageAfter(page, readOpts(POPUP_REREAD_SETTLE_MS));
        await page.screenshot({ path: report.shot });
      }
    }
    if (report.html) fs.writeFileSync(report.html, after.html || '', { mode: 0o600 });
    if (report.meta) {
      // browser_mode (DIVE-6392): the mode the steps ran in, as a snapshot records it,
      // and the popup in view when there is one, so the capture says which window it is.
      fs.writeFileSync(report.meta, JSON.stringify({ url: after.url, title: after.title, text: after.text,
        wait_for: after.wait_for, expect_polled_ms: after.expect_polled_ms, scope: after.scope,
        browser_mode: browserMode, popup: (pop && pop.popup) || null }), { mode: 0o600 });
    }
    if (report.tree && after.nodes) {
      fs.writeFileSync(report.tree, JSON.stringify({ url: after.url, title: after.title, nodes: after.nodes }), { mode: 0o600 });
    }
  } catch (e) {
    process.stderr.write(`${PROG}: the steps ran but the page could not be re-read afterwards: ${e.message}\n`);
  }
}

// The downloads the act started (DIVE-5751), saved into report.downloads with a
// .manifest.json bin/browser reads. Never fatal: the steps already ran.
async function saveDownloads(dl, report) {
  if (!dl) return;
  dl.stop();
  if (!dl.list.length && !dl.files.length) return;
  try {
    const entries = await downloads.save(dl, report.downloads);
    fs.writeFileSync(path.join(report.downloads, '.manifest.json'),
      JSON.stringify(entries.map(({ name, bytes, error, type }) => ({ name, bytes, error, type }))), { mode: 0o600 });
  } catch (e) {
    process.stderr.write(`${PROG}: the act started a download that could not be saved: ${e.message}\n`);
  }
}

async function main() {
  const raw = fs.readFileSync(0, 'utf8');
  let plan;
  try { plan = JSON.parse(raw); } catch (e) { die(E_NOTHING_RAN, `the plan on stdin is not JSON: ${e.message}`); }

  const profile = process.env.FIVEDIVE_BROWSER_PROFILE || plan.profile;
  if (!profile) die(E_NOTHING_RAN, 'the plan names no profile directory');
  if (!fs.existsSync(profile)) die(E_NOTHING_RAN, `no profile directory at ${profile}`);

  // TREE IS A READ AND IS NOT A PLAN (DIVE-4588). It navigates and enumerates;
  // it fills nothing, clicks nothing and publishes nothing, so it does not go
  // through the step vocabulary and has no out-of-band verify to earn. It shares
  // this file for one reason only: it must open the SAME profile, the same
  // chrome and the same no-listening-socket launch as every other page this
  // plugin touches. A second program that opened a credential directory would be
  // a second place to get that wrong.
  if (plan.mode === 'tree') return await treeMode(plan);
  // Same rule as tree: a snapshot reads and publishes nothing, so it does not go
  // through the step vocabulary — and it must open the profile by the one
  // guarded road every other page in this plugin is opened by.
  if (plan.mode === 'snapshot') return await snapshotMode(plan);
  if (plan.mode === 'totp') return await totpMode(plan);
  if (plan.mode === 'read') return await readMode(plan);
  if (plan.mode === 'download') return await downloadMode(plan);

  const steps = Array.isArray(plan.steps) ? plan.steps : null;
  if (!steps || !steps.length) die(E_NOTHING_RAN, 'the plan carries no steps');
  const args = (plan.args && typeof plan.args === 'object') ? plan.args : {};

  // VALIDATE AND INTERPOLATE THE WHOLE PLAN BEFORE THE BROWSER OPENS. Half an
  // action is the one outcome with no clean recovery: the out-of-band verify can
  // tell you the artifact is not live, and cannot tell you whether a draft was
  // left behind. Substituting lazily at each step would also break this file's
  // own contract — a missing --key on step 3 would raise "nothing ran" after
  // steps 1 and 2 had run, and bin/browser would then skip the re-read on an
  // action that half happened. Resolve everything first, or refuse.
  const resolved = steps.map((s, i) => {
    const spec = STEPS[s && s.op];
    // DIVE-8241: a click by position and a read-only page script are an act's
    // (guarded) steps, never a recipe's: `run` keeps the closed vocabulary.
    if (!spec && plan.guard === true && s && point.ACT_ONLY.has(s.op)) {
      try { return point.validate(s, i + 1); } catch (e) { die(E_NOTHING_RAN, e.message); }
    }
    if (!spec) {
      die(E_NOTHING_RAN, `step ${i + 1} uses '${s && s.op}', which is outside the fixed vocabulary ` +
        `(${Object.keys(STEPS).join(' ')}). The vocabulary is the point: an adapter that can express ` +
        `anything is freeform reasoning with extra syntax.`);
    }
    const out = { op: s.op };
    // DIVE-6844: the site a saved login is for (bin/browser sets it, never a page).
    if ((s.op === 'fill' || s.op === 'type') && typeof s.host === 'string' && s.host) out.host = s.host;
    // DIVE-7237: an act's upload carries the file's bytes, read by the calling seat.
    if (s.op === 'upload' && s.file && typeof s.file === 'object' && typeof s.file.b64 === 'string') out.file = s.file;
    for (const field of spec) {
      if (typeof s[field] !== 'string' || !s[field]) {
        die(E_NOTHING_RAN, `step ${i + 1} (${s.op}) is missing '${field}'`);
      }
      // A SELECTOR IS NEVER INTERPOLATED. Selectors come from the adapter, which
      // is ours; values come from the caller, which is not. Substituting into a
      // selector would let an argument choose which element gets clicked. A
      // `ref=<role>/<name>` selector (DIVE-4588) is a selector by this rule too
      // and gets the same refusal: an argument that could choose the ROLE and
      // NAME of the element to click is the same hole with nicer syntax.
      // `act` (DIVE-4943) sends the agent's own text, which has no adapter
      // arguments to fill and may legitimately contain a literal `{word}`; it
      // says so with `literal`, and the value is typed exactly as given.
      out[field] = field === 'selector' || plan.literal ? s[field]
        : interp(s[field], args, `step ${i + 1} (${s.op})`, field === 'url' ? encodeURIComponent : null);
    }
    // `type`'s one optional knob, a number and never an argument, and its value with
    // the arguments in: checked here with the rest, so a bad one refuses before the
    // browser opens (lib/aria.cjs).
    if (s.op === 'type') {
      const why = aria.typeRefusal(s.delay_ms, out.value);
      if (why) die(E_NOTHING_RAN, `step ${i + 1} (type) ${why}`);
      out.delay_ms = aria.typeDelay(s.delay_ms);
    }
    // `intent`: what a step is for, in words, read only when its ref matches
    // nothing (lib/aria.cjs resolveOrRepick). Never interpolated, for the reason a
    // selector is not: it steers which element gets picked.
    if (typeof s.intent === 'string' && s.intent) out.intent = s.intent;
    return out;
  });

  const chrome = process.env.FIVEDIVE_BROWSER_CHROME;
  if (!chrome) {
    die(E_NOTHING_RAN, 'no chrome named for this run — a run must use the same browser the profile was ' +
      'logged in with, so the executable is passed in rather than guessed here.');
  }

  // openProfile() re-states the profile and chrome checks above rather than
  // taking them on trust. They are cheap and idempotent here, and the reason is
  // that `tree` reaches the same launch by a different road: one function that
  // opens a credential directory, with the guards inside it, is the only shape
  // where a second caller cannot get a laxer one.
  const ctx = await openProfile(profile);

  let rc = 0, needsOwner = null, page = null, retry = null, acted = false, redirected = false, at = -1, dl = null;
  const stepMs = stepLimit(plan);
  let pop = null, lastOp = null;
  try {
    page = ctx.pages()[0] || await ctx.newPage();
    page.setDefaultTimeout(STEP_TIMEOUT);
    // A POPUP A STEP OPENS IS FOLLOWED (DIVE-6392): the steps after it act in it and
    // the re-read is of it; when it closes, the page that opened it is back.
    pop = popup.follow(page, {
      stepTimeout: STEP_TIMEOUT,
      log: (l) => process.stderr.write(`  ${l}\n`),
      onOpen: async (p) => {
        const inter = await aria.waitInterstitial(p);   // watched, never clicked (DIVE-6317)
        if (inter) process.stderr.write(`  the popup's "${inter.title}" ${inter.cleared ? `cleared by itself after ${inter.waited_ms} ms` : `was still there after ${inter.waited_ms} ms`}\n`);
      },
    });
    // A FILE A CLICK DOWNLOADS (DIVE-5751): watched from before step one, saved
    // after the re-read into the caller's own staging directory (this process IS
    // the caller), before the context closes and Playwright deletes it.
    if (plan.report && typeof plan.report.downloads === 'string') dl = downloads.watch(ctx, page);
    for (let i = 0; i < resolved.length; i++) {
      const s = resolved[i];
      const where = `step ${i + 1} (${s.op})`;
      at = i;
      page = await pop.sync(lastOp);
      // RESOLVE BEFORE THE COUNTER, deliberately. Turning `ref=button/Send` into
      // a selector is a page.evaluate that reads the document and changes
      // nothing, so a ref that matches nothing performed no part of the action —
      // and on step ONE that has to stay 70 ("nothing ran"), or bin/browser
      // re-reads the verify URL and reports a publish nobody performed. A plain
      // CSS selector does not touch the page here at all.
      // BEFORE THE RESOLVE AND BEFORE THE COUNTER. Both of those touch the page,
      // and the whole point is to touch nothing once the browser is someone else's.
      assertLease(where);
      // A ref `wait_for` WAITS, like its CSS twin always did (DIVE-4674). The
      // choice of which ops wait lives in lib/aria.cjs, shared by this loop and
      // the other one, because the defect was that there are two of them.
      // A ref that matches nothing gets ONE retry on a picked element, never for a
      // step that pays, posts, sends or deletes (lib/aria.cjs resolveOrRepick).
      // The pick can take reflex seconds, so the lease is read again before a retry.
      // GOOGLE'S SIGN-IN PAGES (DIVE-6228), before the step touches one: a password,
      // a code, a robot check, adding an account or a wider grant stops the plan
      // here, whatever the steps say. lib/google-signin.cjs, shared by both loops.
      const gs = await gsignin.stepStop(page, s, plan.gates || []);
      if (gs) {
        process.stderr.write(gsignin.STOP_PREFIX + JSON.stringify(gs) + '\n');
        throw new Error(`${where}: not run. ${gs.why}`);
      }
      // DIVE-7168: the sign-in the guard allowed, said once per act for the owner's record.
      if (!signedIn) { const gg = await gsignin.stepGrant(page, s); if (gg) { signedIn = true; process.stderr.write(gsignin.GRANT_PREFIX + JSON.stringify(gg) + '\n'); } }
      // DIVE-8241: BY POSITION, OR A PAGE SCRIPT (lib/point.cjs, shared by both loops).
      // The owner's four are read off the element under the point; an eval only reads.
      if (point.ACT_ONLY.has(s.op)) {
        if (s.op === 'eval') {
          const json = await point.evalStep(page, s);
          process.stderr.write(`  ${where} = ${json}\n`);
        } else {
          if (plan.guard && !plan.approved) {
            const risk = await point.pointRisk(page, s);
            if (risk && Array.isArray(plan.allow_kinds) && plan.allow_kinds.includes(risk.cls)) {
              process.stderr.write(aria.OWNER_ALLOWED_PREFIX + JSON.stringify({ ...risk, step: i + 1, op: s.op }) + '\n');
            } else if (risk) { needsOwner = { ...risk, step: i + 1, op: s.op }; break; }
          }
          stepsRun++;
          acted = true;
          process.stderr.write(`  ${where}: ${await point.runPoint(page, s, { timeoutMs: stepMs })}\n`);
        }
        lastOp = s.op;
        process.stderr.write(`  ${where} ok\n`);
        continue;
      }
      const { sel, retry: r } = await aria.resolveOrRepick(page, s, i + 1, { timeoutMs: stepMs });
      if (r) assertLease(where);
      retry = r;
      // THE OWNER'S FOUR (DIVE-4943), checked on the live element BEFORE the
      // counter: a refused step was not entered, so a refusal on step one is
      // still "nothing ran". Only `act` sets guard; an adapter recipe is a
      // reviewed file and keeps its own contract.
      if (plan.guard && !plan.approved) {
        const risk = await aria.stepRisk(page, s, sel);
        // THE OWNER'S POLICY (DIVE-4982): a kind they set to "allow" runs without
        // asking, and is REPORTED — bin/browser writes it to their log.
        if (risk && Array.isArray(plan.allow_kinds) && plan.allow_kinds.includes(risk.cls)) {
          process.stderr.write(aria.OWNER_ALLOWED_PREFIX + JSON.stringify({ ...risk, step: i + 1, op: s.op }) + '\n');
        } else if (risk) {
          needsOwner = { ...risk, step: i + 1, op: s.op };
          break;
        }
      }
      stepsRun++;  // entered, not completed — see stepsRun above
      if (s.op !== 'goto') acted = true;
      // A REF WHOSE ELEMENT THE PAGE REPLACED IS FOUND AGAIN (DIVE-5335), never a
      // step that may have acted, and the owner's check is read again on it —
      // lib/aria.cjs onRef, shared by both loops.
      const on = (act) => aria.onRef(page, s, sel, act, {
        timeoutMs: stepMs, log: (l) => process.stderr.write(`  ${l}\n`),
        check: (plan.guard && !plan.approved) ? async (x) => {
          const k = await aria.stepRisk(page, s, x);
          return !k || (Array.isArray(plan.allow_kinds) && plan.allow_kinds.includes(k.cls));
        } : null,
      });
      // DIVE-6844: a saved login carries the site it is for, and is typed on
      // no other (the page may have moved since the act began). Checked here,
      // not on the case lines, which older harnesses match byte for byte.
      if (s.op === 'fill' || s.op === 'type') savedHostCheck(page, s);
      // DIVE-8241: a tab a saved value went into is one no page script reads.
      if ((s.op === 'fill' || s.op === 'type') && s.host) point.markSaved(page);
      // DIVE-7237: an act's upload carries the file's bytes, read by the caller
      // (who may hold files this browser's seat cannot open); an adapter's names a path.
      if (s.op === 'upload' && s.file && typeof s.file.b64 === 'string') {
        s.path = { name: String(s.file.name || 'upload'), mimeType: String(s.file.mimeType || 'application/octet-stream'), buffer: Buffer.from(s.file.b64, 'base64') };
      }
      let landedFile = false;   // DIVE-7646: a file is no page to judge a landing by
      switch (s.op) {
        case 'goto': {
          // A GOTO THAT LANDS ON A FILE HANDS IT OVER (DIVE-7646): a PDF opens in
          // Chrome's viewer with no download event, so its bytes are kept here; an
          // attachment starts a real download, which the watch above already has.
          let resp = null;
          try { resp = await page.goto(s.url, { waitUntil: 'domcontentloaded' }); }
          catch (e) {
            if (!(dl && /Download is starting/.test(String(e && e.message)))) throw e;
            process.stderr.write(`  ${where}: ${s.url} is a file, and it is downloading\n`);
            landedFile = true;
            break;
          }
          const kept = await downloads.keepResponse(dl, ctx, resp);
          if (kept) { process.stderr.write(`  ${where}: ${s.url} is a file (${kept.type || 'attachment'}); it is handed over with the act\n`); landedFile = true; break; }
          const inter = await aria.waitInterstitial(page);   // DIVE-6317
          if (inter) process.stderr.write(`  ${where}: "${inter.title}" ${inter.cleared ? `cleared by itself after ${inter.waited_ms} ms` : `was still there after ${inter.waited_ms} ms`}\n`);
          if (RUN_SETTLE_MS > 0) await page.waitForTimeout(RUN_SETTLE_MS);
          break;
        }
        case 'fill':     await on((x, timeout) => page.fill(x, s.value, { timeout })); break;
        case 'type':     await aria.typeKeys(page, sel, s.value, s.delay_ms, { timeoutMs: stepMs }); break;
        case 'click':    await on((x, timeout) => aria.clickStep(page, s, x, timeout, { log: (l) => process.stderr.write(`  ${l}\n`) })); break;
        case 'wait_for': await page.waitForSelector(sel, { timeout: stepMs }); break;
        case 'select':   await on((x, timeout) => page.selectOption(x, s.value, { timeout })); break;
        case 'upload':   await on((x, timeout) => page.setInputFiles(x, s.path, { timeout })); break;
        case 'press':    await on((x, timeout) => page.press(x, s.key, { timeout })); break;
      }
      if (retry) process.stderr.write(`  ${retry}ok\n`);
      retry = null;
      lastOp = s.op;
      process.stderr.write(`  ${where} ok\n`);
      // WHERE THE GOTO LANDED (DIVE-4991), said every time. While nothing but a
      // goto has run, a redirect stops this cold run here and bin/browser runs the
      // whole plan once more in the served browser; after a click, never.
      if (s.op === 'goto' && plan.landing && !landedFile) {
        const land = await aria.checkLanding(page, s.url, plan.landing, { mayRetry: !acted });
        if (land.line) process.stderr.write(land.line + '\n');
        if (land.loginWall) throw new Error(`${where}: ${land.loginWall}`);
        if (land.retry) { redirected = true; break; }
      }
    }
    at = -1;   // every step returned: whatever throws now is not a step's failure
    if (redirected) rc = aria.E_REDIRECTED;
    if (needsOwner) {
      process.stderr.write(aria.NEEDS_OWNER_PREFIX + JSON.stringify(needsOwner) + '\n');
      rc = aria.E_NEEDS_OWNER;
    }
    if (plan.report && (stepsRun || needsOwner)) {
      page = await pop.sync(lastOp);
      await writeReport(page, plan.report, pop);
    }
    await saveDownloads(dl, plan.report);
  } catch (e) {
    // A STEP FAILURE IS NOT A VERDICT AND MUST NOT BE DRESSED AS ONE. bin/browser
    // re-reads the artifact by a different path whatever this exits, because
    // "failed" here and "published" are not mutually exclusive — that is the
    // case that double-posts on a blind retry.
    if (retry) process.stderr.write(`  ${retry}failed\n`);
    process.stderr.write(`${PROG}: ${e.message}\n`);
    // WHICH STEP (DIVE-4990), as a line bin/browser reads: a failed step fails
    // `act` whatever its --expect matched, and the failure names the step.
    if (at >= 0) process.stderr.write(aria.STEP_FAILED_PREFIX + JSON.stringify(aria.failedStep(at + 1, resolved[at], e)) + '\n');
    rc = stepFailure();
    if (rc === E_NOTHING_RAN) {
      process.stderr.write(`${PROG}: the browser opened but not one step ran, so nothing was ` +
        `published and there is nothing to re-read.\n`);
    } else if (plan.report && page) {
      // The step that failed may have opened the popup (a click that timed out
      // waiting on the opener): the re-read shows it either way.
      if (pop) { try { page = await pop.sync(resolved[at] ? resolved[at].op : lastOp); } catch (e2) { /* re-read the page we have */ } }
      await writeReport(page, plan.report, pop, { failed: true });
      // A step that failed after a click may still have started a download, and
      // that file is as real as the click was.
      await saveDownloads(dl, plan.report);
    }
  } finally {
    if (pop) pop.stop();
    try { await ctx.close(); } catch (e) { /* the verdict is the re-read, not this */ }
  }
  process.exit(rc);
}

main().catch(e => die(stepFailure(), e && e.message ? e.message : String(e)));
