#!/usr/bin/env node
'use strict';
// 5dive browser — the real FIVEDIVE_BROWSER_DRIVER (DIVE-4524).
//
// WHAT THIS IS. `5dive browser run <site> <action>` validates an adapter, checks
// the session is live, and then hands a PLAN — {profile, steps, args} on stdin —
// to an executor. Until now there was no executor anywhere: `run` died "no
// executor backend" on every box, so a logged-in profile was a credential with
// no consumer. This is that executor.
//
// ---- WHY PLAYWRIGHT, WHEN bin/browser USED TO REFUSE IT ----------------------
//
// The old refusal said: "Playwright is the right tool for BUILDING an adapter
// and the wrong one for running it." That sentence was about a DIFFERENT
// Playwright shape — one that launches its own throwaway browser, which would
// have thrown the hand-logged-in profile away and made the whole design
// pointless. It is REVERSED here, deliberately and by direction (DIVE-4488 body,
// main, 2026-09-14), on one property that the throwaway shape does not have:
//
//   launchPersistentContext(<the seat's own 0700 profile dir>) speaks CDP over
//   --remote-debugging-pipe — file descriptors 3 and 4 of the child — and opens
//   NO LISTENING SOCKET.
//
// That is the same security claim `shot` makes and for the same reason: a
// loopback --remote-debugging-port is reachable by EVERY SEAT ON THE BOX, and
// CDP is full control of the browser holding the session. A seat that could
// never open the 0700 profile directory would get the session anyway, with no
// file permission needed, and the 0700 mode would be decorative. Over the pipe
// there is nothing to reach: the only process that can speak to this browser is
// the one that launched it. _launch_args() below REFUSES any --remote-debugging-*
// argument, so the port cannot come back by way of a config edit either.
//
// ---- THE DRIVER IS NOT A PROGRAM HOST ---------------------------------------
//
// bin/browser already refuses a step outside the fixed vocabulary at load time.
// This re-checks it rather than trusting its caller: the driver is an executable
// whose path is an environment variable, so "the plan was validated upstream" is
// an assumption about a process we do not control. There is no eval, no script
// step, no free-text instruction — an adapter that could express anything would
// be freeform reasoning with extra syntax.
//
// Arguments reach the page as VALUES through the Playwright API (fill/press/
// selectOption take strings), never spliced into a command line or a selector.

const fs = require('fs');
const path = require('path');
// DIVE-4588. The ref layer is a SIBLING FILE addressed by path, not a package
// name: the whole point of playwrightDirs() below is that this process does not
// resolve code by walking ancestor node_modules, and a bare require('aria')
// would reintroduce exactly that.
const aria = require(path.join(__dirname, '..', 'lib', 'aria.cjs'));

// DO NOT DELETE THIS. It is not dead code — it is the fix for DIVE-4587, and the
// full mechanism is written out at the top of bin/browser. In one paragraph:
// Chrome keeps its crashpad database at $XDG_CONFIG_HOME/google-chrome/Crash
// Reports whatever --user-data-dir and --crash-dumps-dir say, and creates it
// 0700; 5dive boxes export ONE shared XDG_CONFIG_HOME to every seat, so the
// first seat to run Chrome owns that directory and every other seat's launch
// CHECK-fails ("chrome_crashpad_handler: --database is required", rc 133, no
// output). Unsetting it gives each seat its own crash dir under its own home.
//
// bin/browser already unsets it, so in the shipped path this is redundant — and
// it is here for the same reason this file re-validates a plan bin/browser
// already validated: the driver is an executable whose path is an environment
// variable (FIVEDIVE_BROWSER_DRIVER), so "my parent did it" is an assumption
// about a process we do not control. The cost of the second unset is nothing;
// the cost of being wrong about the parent is a browser that cannot launch.
delete process.env.XDG_CONFIG_HOME;

const PROG = '5dive browser run';
// THE EXIT CODE IS A CONTRACT, and 70 is the load-bearing one.
//
// `5dive browser run` does not trust a driver's exit status — the verdict is an
// out-of-band re-read of the artifact, because "published and reported failure"
// is real and a blind retry on it double-posts. That re-read is only meaningful
// if the action actually RAN. If the executor never opened the browser, the
// re-read grades whatever was already at that URL: for an adapter whose verify
// URL is an existing page, an executor that does not exist on this box reports
// SUCCESS for an action nobody performed. Vacuous green, with a receipt.
//
// So every refusal RAISED BEFORE THE FIRST STEP exits 70, which bin/browser
// treats as "nothing ran, there is nothing to verify". After the first step, a
// failure is 1 and the re-read governs — that half is the whole design.
const E_NOTHING_RAN = 70, E_FAILED = 1;

// "BEFORE THE FIRST STEP" IS NOT "BEFORE THE LAUNCH", and reading it as the
// launch is how this contract was one call short (DIVE-4524 iteration 1).
// Guarding the launch alone leaves a window — acquiring the page, arming the
// timeout, anything ever hoisted above the loop — in which the browser is OPEN
// and NOT ONE STEP has run. A throw in that window used to exit 1, which is the
// "a step failed, re-read the artifact" code, so bin/browser re-read a verify
// URL that already existed and reported a publish nobody performed: this file's
// own named defect, alive inside the change that exists to close it.
//
// The boundary is therefore a COUNTER, not a second try block. A counter is the
// property itself ("did any step run?") rather than a place in the file that has
// to be kept true as the file changes, so code hoisted above the loop later is
// covered without anyone remembering this comment. It is module-scope because
// the outermost .catch() must read the same number.
//
// A step COUNTS AS RUN once its await is entered, not once it returns: a goto
// that throws may already have navigated, a click may already have posted. The
// expensive direction of a wrong answer here is claiming nothing ran when
// something did — that is the blind retry that double-posts.
let stepsRun = 0;
const stepFailure = () => (stepsRun ? E_FAILED : E_NOTHING_RAN);

// The same list bin/browser enforces. Kept here as a literal on purpose: two
// copies that must agree is the point — this one is the one that runs.
const STEPS = {
  goto:     ['url'],
  fill:     ['selector', 'value'],
  click:    ['selector'],
  wait_for: ['selector'],
  select:   ['selector', 'value'],
  upload:   ['selector', 'path'],
  press:    ['selector', 'key'],
};
const STEP_TIMEOUT = Number(process.env.FIVEDIVE_BROWSER_STEP_TIMEOUT || 30000);

// ---- THE LEASE, RE-READ BEFORE EVERY STEP (DIVE-4588) -----------------------
//
// bin/browser holds a per-site lease for the whole of this run and hands its
// file and token down. This function is why it hands down a FILE and not just a
// boolean: the lease can be taken away MID-RUN, and the only case that matters
// is the one where it is taken by a PERSON. Someone redeems a viewer, gets a
// keyboard inside this exact browser, and starts clearing a captcha or finishing
// a login — while this process is three steps into a publish.
//
// Checking once at the start would protect keystroke one and nothing after it.
// So the token is re-read from disk before each step, and a mismatch stops the
// run where it stands.
//
// IT IS A FAILURE, NOT A REFUSAL, AND THAT DISTINCTION IS THE CAREFUL PART. If
// steps have already run, this exits 1 and bin/browser goes and RE-READS the
// artifact out of band — because an action interrupted at step 6 of 8 may well
// have published, and reporting "nothing happened" about a run that half
// happened is how a retry double-posts. `stepFailure()` already encodes exactly
// that rule, so this reuses it rather than choosing a code.
//
// A run with NO lease in its environment is not policed here. That is
// deliberate: FIVEDIVE_BROWSER_DRIVER is a documented seam (the Browser Hand
// shape drives its own browser), and a driver that refused to start without a
// variable its caller may not set would break that seam to enforce a lock the
// caller never took. bin/browser always sets it.
const LEASE_FILE = process.env.FIVEDIVE_BROWSER_LEASE || '';
const LEASE_TOKEN = process.env.FIVEDIVE_BROWSER_LEASE_TOKEN || '';
function leaseStillOurs() {
  if (!LEASE_FILE || !LEASE_TOKEN) return null;   // no lease was handed down
  let txt;
  try { txt = fs.readFileSync(LEASE_FILE, 'utf8'); }
  catch (e) { return 'gone'; }                    // the directory was removed under us
  const m = txt.match(/^token=(.*)$/m);
  return m && m[1] === LEASE_TOKEN ? null : 'taken';
}
function assertLease(where) {
  const lost = leaseStillOurs();
  if (!lost) return;
  const why = lost === 'gone'
    ? 'the lease on this browser was released or reaped while this run was in progress'
    : 'the lease on this browser was TAKEN by someone else — a person redeeming a viewer preempts an agent';
  throw new Error(
    `${where}: refusing to continue — ${why}. Stopping here rather than typing into a session ` +
    `somebody else is using. Whatever steps already ran are still real: bin/browser re-reads the ` +
    `artifact out of band and that re-read, not this message, is the verdict.`);
}

function die(code, msg) { process.stderr.write(`${PROG}: ${msg}\n`); process.exit(code); }

// {key} -> args.key, as a VALUE. A placeholder with no argument is a REFUSAL and
// not a passthrough: the dual of this bug is already known on the verify side —
// an uninterpolated {slug} in verify.expect can never match, so every publish
// reads as NOT VERIFIED. On the STEP side the same slip is worse than noisy, it
// is wrong: a fill that posts the literal text "{body}" has published garbage to
// a real account, and the out-of-band verify cannot tell you it was garbage
// because the artifact really is live.
function interp(s, args, where) {
  if (typeof s !== 'string') return s;
  const out = s.replace(/\{([a-zA-Z0-9_]+)\}/g, (m, k) =>
    Object.prototype.hasOwnProperty.call(args, k) ? args[k] : m);
  const left = out.match(/\{[a-zA-Z0-9_]+\}/);
  if (left) {
    die(E_NOTHING_RAN, `${where} still contains ${left[0]} — no --${left[0].slice(1, -1)}=<value> was passed. ` +
      `Refusing rather than typing the placeholder into the page: that publishes literal "${left[0]}" ` +
      `to a real account, and the out-of-band verify would confirm it as live.`);
  }
  return out;
}

// THE SECURITY CLAIM, as code rather than as a comment. Anything that would open
// a socket another seat could reach is refused here, so it cannot be
// reintroduced by an env var or a later edit without this failing loudly.
function launchArgs() {
  const extra = (process.env.FIVEDIVE_BROWSER_CHROME_ARGS || '').split(/\s+/).filter(Boolean);
  const args = ['--no-sandbox', '--disable-gpu', '--hide-scrollbars', ...extra];
  const bad = args.filter(a => /^--remote-debugging/.test(a));
  if (bad.length) {
    die(E_NOTHING_RAN, `refusing to launch with ${bad.join(' ')}. CDP here goes over --remote-debugging-pipe ` +
      `(the child's fds 3/4), which opens no listening socket. A debug PORT is reachable by every seat on ` +
      `this box and CDP is full control of the browser holding the session — it would hand the session to a ` +
      `seat that could never open the 0700 profile directory.`);
  }
  return args;
}

// WHERE playwright-core COMES FROM IS PART OF THE SECURITY CLAIM, so it is not
// left to ambient state. A bare require() walks `node_modules` in EVERY ancestor
// directory of this file, and this process is the one that opens a profile
// holding somebody's live sessions — so unpacking the plugin somewhere that
// happens to sit under a `node_modules/playwright-core` hands the driver a
// library nobody chose or pinned. Measured under DIVE-4524: a checkout under
// /tmp silently loaded /tmp/node_modules/playwright-core.
//
// The order is fixed and short, and there is no ancestor walk:
//   1. the directories NODE_PATH names, if any — an operator's explicit choice,
//      and the only lever the harness uses to put a recording stub here;
//   2. the plugin's OWN node_modules, where package.json pins it exact.
// Nothing else resolves, so "not installed" is a fact about those two places
// rather than about wherever the plugin happens to have been unpacked.
function playwrightDirs() {
  const named = (process.env.NODE_PATH || '').split(path.delimiter).filter(Boolean);
  return [...named, path.join(__dirname, '..', 'node_modules')];
}

function loadPlaywright() {
  for (const dir of playwrightDirs()) {
    const cand = path.join(dir, 'playwright-core');
    if (!fs.existsSync(cand)) continue;
    try { return require(cand); }
    catch (e) {
      // It is THERE and it will not load. That is not "not installed", and
      // saying so would send the reader to reinstall something already present.
      die(E_NOTHING_RAN, `playwright-core at ${cand} could not be loaded: ${e.message}`);
    }
  }
  {
    die(E_NOTHING_RAN, `playwright-core is not installed for this seat, so there is no executor. ` +
      `Install the pinned version next to the plugin:  npm install --prefix ` +
      `${__dirname}/..  (it is pinned in plugins/browser/package.json). ` +
      `This driver does NOT fall back to a throwaway browser: a run that is not inside the profile a ` +
      `person logged into by hand is not the thing that was asked for.`);
  }
}

// The launch every mode shares. Named once so `tree` cannot acquire a second,
// laxer way into a directory holding somebody's live session.
async function openProfile(profile, { headless = true } = {}) {
  if (!profile) die(E_NOTHING_RAN, 'the plan names no profile directory');
  if (!fs.existsSync(profile)) die(E_NOTHING_RAN, `no profile directory at ${profile}`);
  const chrome = process.env.FIVEDIVE_BROWSER_CHROME;
  if (!chrome) {
    die(E_NOTHING_RAN, 'no chrome named for this run — a run must use the same browser the profile was ' +
      'logged in with, so the executable is passed in rather than guessed here.');
  }
  const { chromium } = loadPlaywright();
  try {
    return await chromium.launchPersistentContext(profile, {
      headless,
      executablePath: chrome,
      args: launchArgs(),
      viewport: { width: 1280, height: 800 },
    });
  } catch (e) {
    die(E_NOTHING_RAN, `could not open the ${profile} profile: ${e.message}`);
  }
}

// `tree` — what is on this page, addressable. Prints JSON on stdout; bin/browser
// renders it. Exit 70 on every refusal, for the same reason the rest of this
// file does: a caller must be able to tell "the page had no such element" from
// "this box could not open a browser at all".
async function treeMode(plan) {
  const profile = process.env.FIVEDIVE_BROWSER_PROFILE || plan.profile;
  if (typeof plan.url !== 'string' || !/^https?:\/\//.test(plan.url)) {
    die(E_NOTHING_RAN, 'tree needs an http(s) url to enumerate');
  }
  const ctx = await openProfile(profile);
  try {
    const page = ctx.pages()[0] || await ctx.newPage();
    page.setDefaultTimeout(STEP_TIMEOUT);
    assertLease('tree');
    await page.goto(plan.url, { waitUntil: 'domcontentloaded' });
    // WAIT FOR THE PAGE TO SETTLE, AND NEVER FOR NETWORK IDLE. A live web app
    // (Gmail, a dashboard) long-polls and never idles — that is measured, it is
    // what makes `read` hang for 150s on the teal-fox box. A short settle after
    // domcontentloaded is what a tree needs and is bounded by construction.
    await page.waitForTimeout(Number(process.env.FIVEDIVE_BROWSER_TREE_SETTLE_MS || 1200));
    const { nodes } = await aria.walk(page, { interactiveOnly: !!plan.interactive });
    process.stdout.write(JSON.stringify({ url: plan.url, nodes }) + '\n');
  } catch (e) {
    die(E_NOTHING_RAN, `could not enumerate ${plan.url}: ${e.message}`);
  } finally {
    try { await ctx.close(); } catch (e) { /* the tree is already printed */ }
  }
  process.exit(0);
}

async function main() {
  const raw = fs.readFileSync(0, 'utf8');
  let plan;
  try { plan = JSON.parse(raw); } catch (e) { die(E_NOTHING_RAN, `the plan on stdin is not JSON: ${e.message}`); }

  const profile = process.env.FIVEDIVE_BROWSER_PROFILE || plan.profile;
  if (!profile) die(E_NOTHING_RAN, 'the plan names no profile directory');
  if (!fs.existsSync(profile)) die(E_NOTHING_RAN, `no profile directory at ${profile}`);

  // TREE IS A READ AND IS NOT A PLAN (DIVE-4588). It navigates and enumerates;
  // it fills nothing, clicks nothing and publishes nothing, so it does not go
  // through the step vocabulary and has no out-of-band verify to earn. It shares
  // this file for one reason only: it must open the SAME profile, the same
  // chrome and the same no-listening-socket launch as every other page this
  // plugin touches. A second program that opened a credential directory would be
  // a second place to get that wrong.
  if (plan.mode === 'tree') return await treeMode(plan);

  const steps = Array.isArray(plan.steps) ? plan.steps : null;
  if (!steps || !steps.length) die(E_NOTHING_RAN, 'the plan carries no steps');
  const args = (plan.args && typeof plan.args === 'object') ? plan.args : {};

  // VALIDATE AND INTERPOLATE THE WHOLE PLAN BEFORE THE BROWSER OPENS. Half an
  // action is the one outcome with no clean recovery: the out-of-band verify can
  // tell you the artifact is not live, and cannot tell you whether a draft was
  // left behind. Substituting lazily at each step would also break this file's
  // own contract — a missing --key on step 3 would raise "nothing ran" after
  // steps 1 and 2 had run, and bin/browser would then skip the re-read on an
  // action that half happened. Resolve everything first, or refuse.
  const resolved = steps.map((s, i) => {
    const spec = STEPS[s && s.op];
    if (!spec) {
      die(E_NOTHING_RAN, `step ${i + 1} uses '${s && s.op}', which is outside the fixed vocabulary ` +
        `(${Object.keys(STEPS).join(' ')}). The vocabulary is the point: an adapter that can express ` +
        `anything is freeform reasoning with extra syntax.`);
    }
    const out = { op: s.op };
    for (const field of spec) {
      if (typeof s[field] !== 'string' || !s[field]) {
        die(E_NOTHING_RAN, `step ${i + 1} (${s.op}) is missing '${field}'`);
      }
      // A SELECTOR IS NEVER INTERPOLATED. Selectors come from the adapter, which
      // is ours; values come from the caller, which is not. Substituting into a
      // selector would let an argument choose which element gets clicked. A
      // `ref=<role>/<name>` selector (DIVE-4588) is a selector by this rule too
      // and gets the same refusal: an argument that could choose the ROLE and
      // NAME of the element to click is the same hole with nicer syntax.
      out[field] = field === 'selector' ? s[field] : interp(s[field], args, `step ${i + 1} (${s.op})`);
    }
    return out;
  });

  const chrome = process.env.FIVEDIVE_BROWSER_CHROME;
  if (!chrome) {
    die(E_NOTHING_RAN, 'no chrome named for this run — a run must use the same browser the profile was ' +
      'logged in with, so the executable is passed in rather than guessed here.');
  }

  // openProfile() re-states the profile and chrome checks above rather than
  // taking them on trust. They are cheap and idempotent here, and the reason is
  // that `tree` reaches the same launch by a different road: one function that
  // opens a credential directory, with the guards inside it, is the only shape
  // where a second caller cannot get a laxer one.
  const ctx = await openProfile(profile);

  let rc = 0;
  try {
    const page = ctx.pages()[0] || await ctx.newPage();
    page.setDefaultTimeout(STEP_TIMEOUT);
    for (let i = 0; i < resolved.length; i++) {
      const s = resolved[i];
      const where = `step ${i + 1} (${s.op})`;
      // RESOLVE BEFORE THE COUNTER, deliberately. Turning `ref=button/Send` into
      // a selector is a page.evaluate that reads the document and changes
      // nothing, so a ref that matches nothing performed no part of the action —
      // and on step ONE that has to stay 70 ("nothing ran"), or bin/browser
      // re-reads the verify URL and reports a publish nobody performed. A plain
      // CSS selector does not touch the page here at all.
      // BEFORE THE RESOLVE AND BEFORE THE COUNTER. Both of those touch the page,
      // and the whole point is to touch nothing once the browser is someone else's.
      assertLease(where);
      const sel = s.selector === undefined ? undefined : await aria.resolveSelector(page, s.selector);
      stepsRun++;  // entered, not completed — see stepsRun above
      switch (s.op) {
        case 'goto':     await page.goto(s.url, { waitUntil: 'domcontentloaded' }); break;
        case 'fill':     await page.fill(sel, s.value); break;
        case 'click':    await page.click(sel); break;
        case 'wait_for': await page.waitForSelector(sel); break;
        case 'select':   await page.selectOption(sel, s.value); break;
        case 'upload':   await page.setInputFiles(sel, s.path); break;
        case 'press':    await page.press(sel, s.key); break;
      }
      process.stderr.write(`  ${where} ok\n`);
    }
  } catch (e) {
    // A STEP FAILURE IS NOT A VERDICT AND MUST NOT BE DRESSED AS ONE. bin/browser
    // re-reads the artifact by a different path whatever this exits, because
    // "failed" here and "published" are not mutually exclusive — that is the
    // case that double-posts on a blind retry.
    process.stderr.write(`${PROG}: ${e.message}\n`);
    rc = stepFailure();
    if (rc === E_NOTHING_RAN) {
      process.stderr.write(`${PROG}: the browser opened but not one step ran, so nothing was ` +
        `published and there is nothing to re-read.\n`);
    }
  } finally {
    try { await ctx.close(); } catch (e) { /* the verdict is the re-read, not this */ }
  }
  process.exit(rc);
}

main().catch(e => die(stepFailure(), e && e.message ? e.message : String(e)));
